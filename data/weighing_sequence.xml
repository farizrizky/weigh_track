<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_wt_weighing" model="ir.sequence">
            <field name="name">Weighing</field>
            <field name="code">wt.weighing</field>
            <field name="prefix">WG/%(year)s%(month)s%(day)s/</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_wt_production_receipt" model="ir.sequence">
            <field name="name">Production Receipt</field>
            <field name="code">wt.production.receipt</field>
            <field name="prefix">PR/%(year)s%(month)s%(day)s/</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
