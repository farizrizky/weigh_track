<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_wt_delivery" model="ir.sequence">
            <field name="name">Tugas Pengiriman WeighTrack</field>
            <field name="code">wt.delivery</field>
            <field name="prefix">WTDEL/%(year)s%(month)s%(day)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
