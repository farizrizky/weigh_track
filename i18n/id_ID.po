#. module: weightrack
#: code:addons/weightrack/models/estate.py:0
#: model:ir.model.constraint,message:weightrack.constraint_wt_estate_code_company_uniq
msgid "Estate code must be unique per company."
msgstr "Kode estate harus unik per perusahaan."

#. module: weightrack
#: code:addons/weightrack/models/division.py:0
msgid "Division code must be unique per estate."
msgstr "Kode divisi harus unik per estate."

#. module: weightrack
#: code:addons/weightrack/models/employee_role_mapping.py:0
msgid "Job position must be selected."
msgstr "Jabatan harus dipilih."

#. module: weightrack
#: code:addons/weightrack/models/employee_role_mapping.py:0
msgid "Job position must belong to the same company as the mapping."
msgstr "Jabatan harus berada di perusahaan yang sama dengan mapping."

#. module: weightrack
#: model:ir.model.constraint,message:weightrack.constraint_wt_employee_role_mapping_company_role_job_uniq
msgid "Employee role mapping must be unique per company, role, and job position."
msgstr "Mapping role karyawan harus unik per perusahaan, role, dan jabatan."

#. module: weightrack
#: code:addons/weightrack/models/weighing_location.py:0
#: model:ir.model.constraint,message:weightrack.constraint_wt_weighing_location_code_estate_uniq
msgid "Weighing location code must be unique per estate."
msgstr "Kode lokasi timbang harus unik per estate."

#. module: weightrack
#: code:addons/weightrack/models/weighing_location.py:0
msgid "Allowed divisions must belong to the same estate as the weighing location."
msgstr "Divisi yang diizinkan harus berada di estate yang sama dengan lokasi timbang."

#. module: weightrack
#: code:addons/weightrack/models/foreman.py:0
#: model:ir.model.constraint,message:weightrack.constraint_wt_foreman_employee_division_uniq
msgid "Foreman employee must be unique per division."
msgstr "Karyawan mandor harus unik per divisi."

#. module: weightrack
#: code:addons/weightrack/models/tapper.py:0
#: model:ir.model.constraint,message:weightrack.constraint_wt_tapper_employee_uniq
msgid "Tapper employee must be unique."
msgstr "Karyawan tapper harus unik."

#. module: weightrack
#: code:addons/weightrack/models/tapper.py:0
msgid "Tapper and foreman must belong to the same division."
msgstr "Tapper dan mandor harus berada di divisi yang sama."

#. module: weightrack
#: code:addons/weightrack/models/employee_role_mapping.py:0
msgid "%s employee must belong to the same company."
msgstr "Karyawan %s harus berada di perusahaan yang sama."

#. module: weightrack
#: code:addons/weightrack/models/employee_role_mapping.py:0
msgid "%s role mapping has not been configured for this company."
msgstr "Mapping role %s belum dikonfigurasi untuk perusahaan ini."

#. module: weightrack
#: code:addons/weightrack/models/employee_role_mapping.py:0
msgid "%s employee must use an allowed job position for this company."
msgstr "Karyawan %s harus memakai jabatan yang diizinkan untuk perusahaan ini."
