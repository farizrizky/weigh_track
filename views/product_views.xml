<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_product_search" model="ir.ui.view">
        <field name="name">wt.product.search</field>
        <field name="model">wt.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="product_type"/>
                <field name="product_id"/>
            </search>
        </field>
    </record>

    <record id="view_wt_product_list" model="ir.ui.view">
        <field name="name">wt.product.list</field>
        <field name="model">wt.product</field>
        <field name="arch" type="xml">
            <list string="Product">
                <field name="company_id"/>
                <field name="product_type"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <record id="view_wt_product_form" model="ir.ui.view">
        <field name="name">wt.product.form</field>
        <field name="model">wt.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <div class="oe_title">
                        <label for="product_id"/>
                        <h1>
                            <field name="product_id" placeholder="Product" domain="['|', ('product_tmpl_id.company_id', '=', False), ('product_tmpl_id.company_id', '=', company_id)]"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="product_type"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_product" model="ir.actions.act_window">
        <field name="name">Product</field>
        <field name="res_model">wt.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_product_search"/>
    </record>
</odoo>
