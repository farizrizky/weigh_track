<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_wt_warehouse_location_route_list" model="ir.ui.view">
        <field name="name">wt.warehouse.location.route.list</field>
        <field name="model">wt.warehouse.location.route</field>
        <field name="arch" type="xml">
            <list string="Rute Lokasi Gudang">
                <field name="name"/>
                <field name="picking_type_id"/>
                <field name="source_location_id"/>
                <field name="transit_location_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_wt_warehouse_location_route_form" model="ir.ui.view">
        <field name="name">wt.warehouse.location.route.form</field>
        <field name="model">wt.warehouse.location.route</field>
        <field name="arch" type="xml">
            <form string="Rute Lokasi Gudang">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Label Rute..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Mapping Lokasi">
                            <field name="picking_type_id" options="{'no_create': True}"/>
                            <field name="source_location_id"/>
                            <field name="transit_location_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_wt_warehouse_location_route" model="ir.actions.act_window">
        <field name="name">Rute Lokasi Gudang</field>
        <field name="res_model">wt.warehouse.location.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tambahkan Rute Lokasi Gudang
            </p>
            <p>
                Rute ini menentukan ke lokasi transit mana sebuah lokasi sumber
                akan dipindahkan secara otomatis saat step pengiriman divalidasi.
            </p>
        </field>
    </record>

</odoo>
