<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_customer_search" model="ir.ui.view">
        <field name="name">wt.customer.search</field>
        <field name="model">wt.customer</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="partner_id"/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_wt_customer_list" model="ir.ui.view">
        <field name="name">wt.customer.list</field>
        <field name="model">wt.customer</field>
        <field name="arch" type="xml">
            <list string="Customers">
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wt_customer_form" model="ir.ui.view">
        <field name="name">wt.customer.form</field>
        <field name="model">wt.customer</field>
        <field name="arch" type="xml">
            <form string="Customer">
                <sheet>
                    <div class="oe_title">
                        <label for="partner_id"/>
                        <h1>
                            <field name="partner_id"
                                   placeholder="Contact"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">wt.customer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_customer_search"/>
    </record>
</odoo>
