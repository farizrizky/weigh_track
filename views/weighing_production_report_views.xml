<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_weighing_production_report_form" model="ir.ui.view">
        <field name="name">wt.weighing.production.report.form</field>
        <field name="model">wt.weighing.production.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Penimbangan Produksi" edit="0" delete="0">
                <header>
                    <button name="action_open_filter" type="object" string="Filter" class="oe_highlight"/>
                    <button name="action_print_pdf" type="object" string="Export PDF" invisible="not is_filtered"/>
                    <button name="action_export_excel" type="object" string="Export Excel" invisible="not is_filtered"/>
                </header>
                <sheet>
                    <field name="is_filtered" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" invisible="is_filtered">
                        Silakan klik tombol Filter untuk menampilkan data laporan.
                    </div>
                    <group invisible="not is_filtered">
                        <group string="Filter">
                            <field name="company_id"/>
                            <field name="production_date"/>
                            <field name="division_id"/>
                            <field name="weather_display"/>
                        </group>
                        <group string="Total">
                            <field name="total_field_weight"/>
                            <field name="total_warehouse_weight"/>
                            <field name="total_reject_weight"/>
                            <field name="total_slab_weight"/>
                            <field name="total_net_weight"/>
                            <field name="total_bag"/>
                            <field name="total_shrinkage"/>
                        </group>
                    </group>
                    <field name="line_ids" invisible="not is_filtered">
                        <list string="Laporan Penimbangan Produksi" create="0" edit="0" delete="0">
                            <field name="sequence"/>
                            <field name="tapper_name"/>
                            <field name="foreman_name"/>
                            <field name="field_weight" sum="Total"/>
                            <field name="warehouse_weight" sum="Total"/>
                            <field name="reject_weight" sum="Total"/>
                            <field name="slab_weight" sum="Total"/>
                            <field name="net_weight" sum="Total"/>
                            <field name="total_bag" sum="Total"/>
                            <field name="shrinkage_weight" sum="Total"/>
                            <field name="shrinkage_percentage"/>
                            <field name="note"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_weighing_production_report" model="ir.actions.act_window">
        <field name="name">Laporan Penimbangan Produksi</field>
        <field name="res_model">wt.weighing.production.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_weighing_production_report_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <record id="view_wt_weighing_production_report_wizard_form" model="ir.ui.view">
        <field name="name">wt.weighing.production.report.wizard.form</field>
        <field name="model">wt.weighing.production.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Laporan Penimbangan Produksi">
                <sheet>
                    <field name="report_id" invisible="1"/>
                    <group>
                        <group string="Filter">
                            <field name="company_id" required="1"/>
                            <field name="production_date" required="1"/>
                            <field name="division_id" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_filter" type="object" string="Apply Filter" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wt_weighing_production_report_wizard" model="ir.actions.act_window">
        <field name="name">Laporan Penimbangan Produksi</field>
        <field name="res_model">wt.weighing.production.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_weighing_production_report_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
