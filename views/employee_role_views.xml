<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_employee_role_search" model="ir.ui.view">
        <field name="name">wt.employee.role.search</field>
        <field name="model">wt.employee.role</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="role"/>
                <field name="job_id"/>
            </search>
        </field>
    </record>

    <record id="view_wt_employee_role_list" model="ir.ui.view">
        <field name="name">wt.employee.role.list</field>
        <field name="model">wt.employee.role</field>
        <field name="arch" type="xml">
            <list string="Employee Roles">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="role"/>
                <field name="job_id"/>
            </list>
        </field>
    </record>

    <record id="view_wt_employee_role_form" model="ir.ui.view">
        <field name="name">wt.employee.role.form</field>
        <field name="model">wt.employee.role</field>
        <field name="arch" type="xml">
            <form string="Employee Role">
                <sheet>
                    <div class="oe_title">
                        <label for="role"/>
                        <h1>
                            <field name="role" placeholder="Role"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="job_id" required="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_employee_role" model="ir.actions.act_window">
        <field name="name">Employee Roles</field>
        <field name="res_model">wt.employee.role</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_employee_role_search"/>
    </record>
</odoo>
