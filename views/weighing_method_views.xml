<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- Search View -->
    <record id="view_wt_weighing_method_search" model="ir.ui.view">
        <field name="name">wt.weighing.method.search</field>
        <field name="model">wt.weighing.method</field>
        <field name="arch" type="xml">
            <search string="Weighing Method Search">
                <field name="name" placeholder="Search by Weighing Method Name..."/>
                <field name="code" placeholder="Search by Weighing Method Code..."/>

                <filter string="By Name" name="filter_by_name"
                        domain="[('name','!=',False)]"/>
                <filter string="By Code" name="filter_by_code"
                        domain="[('code','!=',False)]"/>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_wt_weighing_method_list" model="ir.ui.view">
		<field name="name">wt.weighing.method.list</field>
			<field name="model">wt.weighing.method</field>
			<field name="arch" type="xml">
			<list string="Weighing Methods">
                <field name="code"/>
				<field name="name"/>				
                <field name="resulting_weighing_type_id"/>
			</list>
		</field>
	</record>

    <!-- Form View -->
    <record id="view_wt_weighing_method_form" model="ir.ui.view">
        <field name="name">wt.weighing.method.form</field>
        <field name="model">wt.weighing.method</field>
        <field name="arch" type="xml">
            <form string="Weighing Method Form">
                <sheet>
                    <group>
                        <field name="code" placeholder="Enter Weighing Method Code..."/>
                        <field name="name" placeholder="Enter Weighing Method Name..."/>
                        <field name="formula" placeholder="Enter Weighing Method Formula..."/>
                        <field name="resulting_weighing_type_id" 
                               placeholder="Select Resulting Weighing Type..."/>
                    </group>

                    <separator string="Weighing Method Steps"/>
                    <field name="weighing_method_step_ids">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="weighing_type_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wt_weighing_method" model="ir.actions.act_window">
        <field name="name">Weighing Methods</field>
        <field name="res_model">wt.weighing.method</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_weighing_method_search"/>
    </record>
</odoo>