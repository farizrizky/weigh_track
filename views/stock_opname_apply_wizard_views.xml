<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Stock Opname Apply Wizard — View
    ============================================================ -->
    <record id="view_wt_stock_opname_apply_wizard_form" model="ir.ui.view">
        <field name="name">wt.stock.opname.apply.wizard.form</field>
        <field name="model">wt.stock.opname.apply.wizard</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi Selisih &amp; Terapkan Penyesuaian Stok">
                <field name="opname_id" invisible="1"/>

                <!-- ─── INFO HEADER ─────────────────────────────────── -->
                <div class="alert alert-info" role="alert">
                    <i class="fa fa-info-circle me-1"/>
                    Isi alokasi selisih untuk setiap lot yang memiliki perbedaan qty.
                    Total alokasi per lot <strong>harus sama persis</strong> dengan nilai
                    absolut selisih. Lot tanpa selisih ditampilkan sebagai read-only.
                </div>

                <!-- ─── LINES ────────────────────────────────────────── -->
                <field name="wizard_line_ids" nolabel="1">
                    <list
                        editable="bottom"
                        create="false"
                        delete="false"
                        optional_columns_defaults="allocated_qty=show,unallocated_qty=show"
                    >
                        <!-- Identitas lot -->
                        <field name="product_id"       readonly="1" optional="show"/>
                        <field name="lot_id"           readonly="1" optional="show"/>
                        <field name="uom_id"           readonly="1" optional="show" column_invisible="True"/>
                        <field name="theoretical_qty"  readonly="1" optional="show"/>
                        <field name="physical_qty"     readonly="1" optional="show"/>
                        <field name="difference_qty"   readonly="1" optional="show"
                               decoration-danger="difference_qty != 0"
                               decoration-muted="difference_qty == 0"/>

                        <!-- Progress alokasi -->
                        <field name="allocated_qty"     readonly="1" optional="show"
                               decoration-success="is_fully_allocated and has_difference"
                               decoration-warning="not is_fully_allocated and has_difference"/>
                        <field name="unallocated_qty"   readonly="1" optional="show"
                               decoration-danger="unallocated_qty != 0 and has_difference"
                               decoration-muted="not has_difference"/>
                        <field name="is_fully_allocated" column_invisible="True"/>
                        <field name="has_difference"     column_invisible="True"/>
                    </list>
                </field>

                <!-- ─── ALLOCATION DETAIL per LINE (expand) ─────────── -->
                <!-- Gunakan sub-form di wizard_line_ids untuk lihat alokasi -->

                <!-- ─── FOOTER BUTTONS ──────────────────────────────── -->
                <footer>
                    <button
                        name="action_apply"
                        string="Terapkan Penyesuaian Stok"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        name="action_confirm_allocations"
                        string="Simpan Alokasi"
                        type="object"
                        class="btn-secondary"
                    />
                    <button
                        string="Batal"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Wizard Line Form (popup untuk edit alokasi per lot)
    ============================================================ -->
    <record id="view_wt_stock_opname_apply_wizard_line_form" model="ir.ui.view">
        <field name="name">wt.stock.opname.apply.wizard.line.form</field>
        <field name="model">wt.stock.opname.apply.wizard.line</field>
        <field name="arch" type="xml">
            <form string="Alokasi Selisih">
                <sheet>
                    <!-- Info lot -->
                    <group>
                        <group string="Informasi Lot">
                            <field name="product_id"      readonly="1"/>
                            <field name="lot_id"          readonly="1"/>
                            <field name="uom_id"          readonly="1"/>
                        </group>
                        <group string="Kuantitas">
                            <field name="theoretical_qty" readonly="1"/>
                            <field name="physical_qty"    readonly="1"/>
                            <field name="difference_qty"  readonly="1"/>
                            <field name="allocated_qty"   readonly="1"/>
                            <field name="unallocated_qty" readonly="1"/>
                        </group>
                    </group>

                    <!-- Alokasi inline -->
                    <notebook>
                        <page string="Alokasi" name="allocations">
                            <!-- Readonly jika tidak ada selisih -->
                            <field name="has_difference" invisible="1"/>
                            <field
                                name="allocation_ids"
                                readonly="not has_difference"
                                nolabel="1"
                            >
                                <list editable="bottom">
                                    <field name="reason_id"/>
                                    <field name="qty"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="location_dest_id"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <div class="text-muted small mt-2" invisible="has_difference">
                                <i class="fa fa-lock me-1"/>
                                Lot ini tidak memiliki selisih — alokasi tidak diperlukan.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Action — buka wizard
    ============================================================ -->
    <record id="action_wt_stock_opname_apply_wizard" model="ir.actions.act_window">
        <field name="name">Konfigurasi Selisih</field>
        <field name="res_model">wt.stock.opname.apply.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_stock_opname_apply_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{"active_id": active_id}</field>
    </record>
</odoo>
