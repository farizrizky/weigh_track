<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_warehouse_form_inherit_weightrack" model="ir.ui.view">
        <field name="name">stock.warehouse.form.inherit.weightrack</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="after">
                <field name="estate_id" domain="[('company_id', '=', company_id)]"/>
            </xpath>
        </field>
    </record>
</odoo>
