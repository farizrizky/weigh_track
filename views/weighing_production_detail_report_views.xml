<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_weighing_production_detail_report_form" model="ir.ui.view">
        <field name="name">wt.weighing.production.detail.report.form</field>
        <field name="model">wt.weighing.production.detail.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Penimbangan Produksi Detail" edit="0" delete="0">
                <header>
                    <button name="action_open_filter" type="object" string="Filter" class="oe_highlight"/>
                    <button name="action_print_pdf" type="object" string="Export PDF" invisible="not is_filtered"/>
                    <button name="action_export_excel" type="object" string="Export Excel" invisible="not is_filtered"/>
                </header>
                <sheet>
                    <field name="is_filtered" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" invisible="is_filtered">
                        Silakan klik tombol Filter untuk menampilkan data laporan.
                    </div>
                    <group invisible="not is_filtered">
                        <group string="Filter">
                            <field name="company_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="estate_id"/>
                            <field name="division_id"/>
                            <field name="foreman_id"/>
                            <field name="tapper_id"/>
                        </group>
                        <group string="Total">
                            <field name="total_bag"/>
                            <field name="total_production_weight"/>
                            <field name="total_reject_weight"/>
                            <field name="total_slab_weight"/>
                            <field name="total_net_weight"/>
                            <field name="total_initial_weight"/>
                            <field name="total_shrinkage_tolerance_weight"/>
                        </group>
                    </group>
                    <field name="line_ids" invisible="not is_filtered">
                        <list string="Laporan Penimbangan Produksi Detail" create="0" edit="0" delete="0">
                            <field name="sequence"/>
                            <field name="weighing_number"/>
                            <field name="production_date"/>
                            <field name="weighing_date"/>
                            <field name="receipt_date"/>
                            <field name="badge_number"/>
                            <field name="tapper_name"/>
                            <field name="division_name"/>
                            <field name="weighing_location_name"/>
                            <field name="device_id"/>
                            <field name="operator_name"/>
                            <field name="foreman_name"/>
                            <field name="clerk_name"/>
                            <field name="production_receipt_number"/>
                            <field name="inventory_receipt_number"/>
                            <field name="lot_name"/>
                            <field name="manual_weighing"/>
                            <field name="manual_weighing_reason"/>
                            <field name="data_source"/>
                            <field name="total_bag" sum="Total"/>
                            <field name="production_weight" sum="Total"/>
                            <field name="reject_weight" sum="Total"/>
                            <field name="slab_weight" sum="Total"/>
                            <field name="net_weight" sum="Total"/>
                            <field name="initial_weight" sum="Total"/>
                            <field name="shrinkage_tolerance_percentage"/>
                            <field name="shrinkage_tolerance_weight" sum="Total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_weighing_production_detail_report" model="ir.actions.act_window">
        <field name="name">Laporan Penimbangan Produksi Detail</field>
        <field name="res_model">wt.weighing.production.detail.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_weighing_production_detail_report_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <record id="view_wt_weighing_production_detail_report_wizard_form" model="ir.ui.view">
        <field name="name">wt.weighing.production.detail.report.wizard.form</field>
        <field name="model">wt.weighing.production.detail.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Laporan Penimbangan Produksi Detail">
                <sheet>
                    <field name="report_id" invisible="1"/>
                    <group>
                        <group string="Periode &amp; Perusahaan">
                            <field name="company_id" required="1"/>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                        </group>
                        <group string="Filter Operasional">
                            <field name="estate_id" placeholder="Semua Estate"/>
                            <field name="division_id" placeholder="Semua Divisi"/>
                            <field name="foreman_id" placeholder="Semua Mandor"/>
                            <field name="tapper_id" placeholder="Semua Tapper"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_filter" type="object" string="Apply Filter" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wt_weighing_production_detail_report_wizard" model="ir.actions.act_window">
        <field name="name">Filter Laporan Penimbangan Produksi Detail</field>
        <field name="res_model">wt.weighing.production.detail.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_weighing_production_detail_report_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
