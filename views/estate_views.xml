<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_estate_search" model="ir.ui.view">
        <field name="name">wt.estate.search</field>
        <field name="model">wt.estate</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="view_wt_estate_list" model="ir.ui.view">
        <field name="name">wt.estate.list</field>
        <field name="model">wt.estate</field>
        <field name="arch" type="xml">
            <list string="Estates">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_wt_estate_form" model="ir.ui.view">
        <field name="name">wt.estate.form</field>
        <field name="model">wt.estate</field>
        <field name="arch" type="xml">
            <form string="Estate">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Estate Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_estate" model="ir.actions.act_window">
        <field name="name">Estates</field>
        <field name="res_model">wt.estate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_estate_search"/>
    </record>
</odoo>
