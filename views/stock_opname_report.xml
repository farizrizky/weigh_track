<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_stock_opname_document" model="report.paperformat">
        <field name="name">Laporan Stock Opname A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">14</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_stock_opname_document" model="ir.actions.report">
        <field name="name">Laporan Stock Opname</field>
        <field name="model">wt.stock.opname</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_stock_opname_document</field>
        <field name="report_file">weightrack.report_stock_opname_document</field>
        <field name="paperformat_id" ref="paperformat_stock_opname_document"/>
        <field name="binding_model_id" ref="model_wt_stock_opname"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Laporan Stock Opname - %s' % (object.name)</field>
    </record>

    <template id="report_stock_opname_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="state_label" t-value="dict(doc.STATE_SELECTION).get(doc.state, doc.state)"/>
                <t t-set="weighed_lines" t-value="doc.line_ids.filtered(lambda line: line.count_status == 'weighed')"/>
                <t t-set="unweighed_lines" t-value="doc.line_ids.filtered(lambda line: line.count_status == 'unweighed')"/>
                <t t-set="difference_lines" t-value="doc.line_ids.filtered(lambda line: abs(line.difference_qty) &gt; 0.001)"/>
                <t t-set="allocations" t-value="doc.line_ids.mapped('allocation_ids')"/>
                <t t-set="susut_allocations" t-value="allocations.filtered(lambda alloc: alloc.reason_id.difference_type == 'susut')"/>
                <t t-set="hilang_allocations" t-value="allocations.filtered(lambda alloc: alloc.reason_id.difference_type == 'hilang')"/>
                <t t-set="salah_allocations" t-value="allocations.filtered(lambda alloc: alloc.reason_id.difference_type == 'salah')"/>
                <t t-set="lainnya_allocations" t-value="allocations.filtered(lambda alloc: alloc.reason_id.difference_type == 'lainnya')"/>

                <t t-call="web.external_layout">
                <div class="page wt-stock-opname-document" style="font-family: Arial, sans-serif; color: #111827; font-size: 11px;">
                    <style>
                        .wt-stock-opname-document {
                            color: #111827;
                            font-size: 11px;
                            line-height: 1.35;
                        }
                        .wt-stock-opname-document .header-grid {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 20px;
                        }
                        .wt-stock-opname-document .header-grid td {
                            vertical-align: top;
                        }
                        .wt-stock-opname-document .document-title {
                            font-size: 22px;
                            font-weight: 700;
                            letter-spacing: .5px;
                            margin: 0 0 8px;
                            text-transform: uppercase;
                            text-align: right;
                        }
                        .wt-stock-opname-document .company-logo {
                            max-height: 96px;
                            max-width: 340px;
                        }
                        .wt-stock-opname-document .document-number {
                            padding: 0;
                            text-align: right;
                        }
                        .wt-stock-opname-document .document-number .label {
                            color: #4b5563;
                            font-size: 10px;
                            text-transform: uppercase;
                        }
                        .wt-stock-opname-document .document-number .value {
                            font-size: 17px;
                            font-weight: 700;
                        }
                        .wt-section-title {
                            background: #111827;
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: .2px;
                            padding: 8px 12px;
                            text-transform: uppercase;
                        }
                        .wt-table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                        }
                        .wt-table th {
                            background: #f3f4f6;
                            border: 1px solid #cbd5e1;
                            color: #111827;
                            font-size: 10px;
                            font-weight: 700;
                            padding: 9px 10px !important;
                            vertical-align: middle;
                        }
                        .wt-table td {
                            border: 1px solid #cbd5e1;
                            font-size: 10px;
                            line-height: 1.45;
                            padding: 9px 11px !important;
                            vertical-align: top;
                        }
                        .wt-meta td {
                            border: 1px solid #cbd5e1;
                            font-size: 10px;
                            line-height: 1.55;
                            padding: 10px 16px !important;
                        }
                        .wt-label {
                            background: #f8fafc;
                            color: #374151;
                            font-weight: 700;
                            width: 18%;
                        }
                        .wt-number {
                            text-align: right;
                            white-space: nowrap;
                        }
                        .wt-no-col {
                            min-width: 32px;
                            text-align: center;
                            white-space: nowrap;
                            width: 6%;
                        }
                        .wt-table th.wt-no-col,
                        .wt-table td.wt-no-col {
                            padding-left: 6px !important;
                            padding-right: 6px !important;
                        }
                        .wt-muted {
                            color: #6b7280;
                            font-size: 9px;
                        }
                        .wt-box {
                            border: 1px solid #cbd5e1;
                            padding: 10px;
                            min-height: 46px;
                        }
                    </style>

                    <table class="header-grid">
                        <tr>
                            <td style="width: 45%;">
                                <t t-if="doc.company_id.logo">
                                    <img class="company-logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <strong t-esc="doc.company_id.name"/>
                                </t>
                            </td>
                            <td style="width: 55%;">
                                <h2 class="document-title">Laporan Stock Opname</h2>
                                <div class="document-number">
                                    <div class="label">Nomor Dokumen</div>
                                    <div class="value" t-esc="doc.name"/>
                                    <div style="margin-top: 5px;">
                                        <span class="label">Tanggal Cetak</span>
                                        <strong t-esc="time.strftime('%d/%m/%Y')"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div class="wt-section-title">Informasi Stock Opname</div>
                    <table class="wt-table wt-meta" style="margin-bottom: 12px;">
                        <tr>
                            <td class="wt-label">Perusahaan</td>
                            <td><span t-out="doc.company_id.name or ''"/></td>
                            <td class="wt-label">Tanggal</td>
                            <td><span t-field="doc.date" t-options='{"widget": "date"}'/></td>
                        </tr>
                        <tr>
                            <td class="wt-label">Status</td>
                            <td><span t-out="state_label"/></td>
                            <td class="wt-label">Gudang</td>
                            <td><span t-out="doc.warehouse_id.display_name or ''"/></td>
                        </tr>
                        <tr>
                            <td class="wt-label">Estate</td>
                            <td><span t-out="doc.warehouse_id.estate_id.display_name or '-'"/></td>
                            <td class="wt-label">Lokasi Stock</td>
                            <td><span t-out="doc.location_id.complete_name or doc.location_id.display_name or ''"/></td>
                        </tr>
                        <tr>
                            <td class="wt-label">Divisi</td>
                            <td><span t-out="doc.division_id.display_name or ''"/></td>
                            <td class="wt-label">Operator/Petugas</td>
                            <td><span t-out="doc.operator_employee_id.name or ''"/></td>
                        </tr>
                    </table>

                    <div class="wt-section-title">Ringkasan Opname</div>
                    <table class="wt-table" style="margin-bottom: 12px;">
                        <thead>
                            <tr>
                                <th>Total Lot</th>
                                <th>Sudah Ditimbang</th>
                                <th>Belum Ditimbang</th>
                                <th>Lot Berselisih</th>
                                <th>Total Qty Teori</th>
                                <th>Total Qty Fisik</th>
                                <th>Total Selisih</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="wt-number"><span t-out="doc.total_lot_count"/></td>
                                <td class="wt-number"><span t-out="len(weighed_lines)"/></td>
                                <td class="wt-number"><span t-out="len(unweighed_lines)"/></td>
                                <td class="wt-number"><span t-out="len(difference_lines)"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(doc.total_theoretical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(doc.total_physical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(doc.total_difference_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="wt-section-title">Hasil Stock Opname</div>
                    <table class="wt-table" style="margin-bottom: 12px;">
                        <thead>
                            <tr>
                                <th class="wt-no-col">No</th>
                                <th style="width: 14%;">Produk</th>
                                <th style="width: 16%;">Lot</th>
                                <th style="width: 10%;">Status</th>
                                <th style="width: 10%;">Qty Teori</th>
                                <th style="width: 10%;">Qty Fisik</th>
                                <th style="width: 10%;">Selisih</th>
                                <th style="width: 8%;">Satuan</th>
                                <th style="width: 16%;">Alokasi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="not doc.line_ids">
                                <tr>
                                    <td colspan="9" style="text-align: center; color: #6b7280;">Belum ada data stok.</td>
                                </tr>
                            </t>
                            <t t-foreach="doc.line_ids" t-as="line">
                                <tr>
                                    <td class="wt-no-col"><span t-out="line_index + 1"/></td>
                                    <td><span t-out="line.product_id.display_name or ''"/></td>
                                    <td><span t-out="line.lot_id.name or ''"/></td>
                                    <td><span t-out="dict(line.COUNT_STATUS_SELECTION).get(line.count_status, line.count_status)"/></td>
                                    <td class="wt-number"><span t-out="('{:,.2f}'.format(line.theoretical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                    <td class="wt-number"><span t-out="('{:,.2f}'.format(line.physical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                    <td class="wt-number"><span t-out="('{:,.2f}'.format(line.difference_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                    <td><span t-out="line.uom_id.name or ''"/></td>
                                    <td>
                                        <t t-if="line.allocation_ids">
                                            <t t-foreach="line.allocation_ids" t-as="allocation">
                                                <div>
                                                    <span t-out="allocation.reason_id.name"/>
                                                    <span class="wt-muted">(<span t-out="('{:,.2f}'.format(allocation.qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/>)</span>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <span class="wt-muted">-</span>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="4" style="font-weight: 700; text-align: right;">TOTAL</td>
                                <td class="wt-number" style="font-weight: 700;"><span t-out="('{:,.2f}'.format(doc.total_theoretical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number" style="font-weight: 700;"><span t-out="('{:,.2f}'.format(doc.total_physical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number" style="font-weight: 700;"><span t-out="('{:,.2f}'.format(doc.total_difference_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td colspan="2"></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="wt-section-title">Ringkasan Alokasi Selisih</div>
                    <table class="wt-table" style="margin-bottom: 12px;">
                        <thead>
                            <tr>
                                <th>Susut</th>
                                <th>Hilang</th>
                                <th>Salah</th>
                                <th>Lainnya</th>
                                <th>Total Teralokasi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(sum(susut_allocations.mapped('qty')) or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(sum(hilang_allocations.mapped('qty')) or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(sum(salah_allocations.mapped('qty')) or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(sum(lainnya_allocations.mapped('qty')) or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(sum(allocations.mapped('qty')) or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="wt-section-title">Detail Alokasi Selisih</div>
                    <table class="wt-table" style="margin-bottom: 18px;">
                        <thead>
                            <tr>
                                <th class="wt-no-col">No</th>
                                <th style="width: 14%;">Lot</th>
                                <th style="width: 15%;">Tipe</th>
                                <th style="width: 18%;">Alasan</th>
                                <th style="width: 11%;">Qty</th>
                                <th style="width: 18%;">Lokasi Stock</th>
                                <th style="width: 18%;">Catatan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="not allocations">
                                <tr>
                                    <td colspan="7" style="text-align: center; color: #6b7280;">Tidak ada alokasi selisih.</td>
                                </tr>
                            </t>
                            <t t-foreach="allocations" t-as="allocation">
                                <tr>
                                    <td class="wt-no-col"><span t-out="allocation_index + 1"/></td>
                                    <td><span t-out="allocation.line_id.lot_id.name or ''"/></td>
                                    <td><span t-out="dict(allocation.reason_id.DIFFERENCE_TYPE_SELECTION).get(allocation.reason_id.difference_type, allocation.reason_id.difference_type)"/></td>
                                    <td><span t-out="allocation.reason_id.name or ''"/></td>
                                    <td class="wt-number"><span t-out="('{:,.2f}'.format(allocation.qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/> <span t-out="allocation.uom_id.name or ''"/></td>
                                    <td><span t-out="allocation.location_dest_id.complete_name or allocation.location_dest_id.display_name or ''"/></td>
                                    <td><span t-out="allocation.note or '-'"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="wt-section-title">Catatan Pemeriksaan</div>
                    <div style="border: 1px solid #cbd5e1; min-height: 56px; margin-bottom: 20px; padding: 10px 12px;">
                        <span t-out="doc.note or ''"/>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; page-break-inside: avoid;">
                        <tr>
                            <td style="width: 33%; text-align: center; padding: 8px 12px;">
                                <div style="font-weight: 700;">Petugas</div>
                                <div style="height: 72px;"></div>
                                <div>( .................................... )</div>
                            </td>
                            <td style="width: 34%; text-align: center; padding: 8px 12px;">
                                <div style="font-weight: 700;">Diperiksa Oleh</div>
                                <div style="height: 72px;"></div>
                                <div>( .................................... )</div>
                            </td>
                            <td style="width: 33%; text-align: center; padding: 8px 12px;">
                                <div style="font-weight: 700;">Diketahui Oleh</div>
                                <div style="height: 72px;"></div>
                                <div>( .................................... )</div>
                            </td>
                        </tr>
                    </table>
                </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
