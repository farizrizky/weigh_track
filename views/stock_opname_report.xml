<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_stock_opname_document" model="report.paperformat">
        <field name="name">Laporan Stock Opname A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">14</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_stock_opname_document" model="ir.actions.report">
        <field name="name">Laporan Stock Opname</field>
        <field name="model">wt.stock.opname</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_stock_opname_document</field>
        <field name="report_file">weightrack.report_stock_opname_document</field>
        <field name="paperformat_id" ref="paperformat_stock_opname_document"/>
        <field name="binding_model_id" ref="model_wt_stock_opname"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Laporan Stock Opname - %s' % (object.name)</field>
    </record>

    <template id="external_layout_weightrack_stock_opname">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-set="company" t-value="o.company_id.sudo() if o and o.company_id else res_company"/>
        <div
            t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"
            t-att-data-oe-model="o and o._name"
            t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout"/>
    </template>

    <template id="report_stock_opname_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="report_company" t-value="doc.company_id.sudo() if doc.company_id else res_company"/>
                <t t-set="allocations" t-value="doc.line_ids.mapped('allocation_ids')"/>
                <t t-set="susut_allocations" t-value="allocations.filtered(lambda alloc: alloc.reason_id.difference_type == 'susut')"/>
                <t t-set="hilang_allocations" t-value="allocations.filtered(lambda alloc: alloc.reason_id.difference_type == 'hilang')"/>
                <t t-set="salah_allocations" t-value="allocations.filtered(lambda alloc: alloc.reason_id.difference_type == 'salah')"/>
                <t t-set="lainnya_allocations" t-value="allocations.filtered(lambda alloc: alloc.reason_id.difference_type == 'lainnya')"/>

                <t t-call="weightrack.external_layout_weightrack_stock_opname">
                    <div class="page wt-stock-opname-document">
                    <style>
                        .wt-stock-opname-document {
                            color: inherit;
                            font-family: inherit;
                            font-size: 10px;
                            line-height: 1.45;
                        }
                        .wt-stock-opname-document .label-en {
                            display: block;
                            font-weight: 700;
                            line-height: 1.25;
                        }
                        .wt-stock-opname-document .label-id {
                            color: #6b7280;
                            display: block;
                            font-size: 8px;
                            font-weight: 400;
                            line-height: 1.25;
                            margin-top: 1px;
                        }
                        .wt-stock-opname-document .wt-borderless,
                        .wt-stock-opname-document .wt-borderless > tbody,
                        .wt-stock-opname-document .wt-borderless > tbody > tr,
                        .wt-stock-opname-document .wt-borderless > tbody > tr > td {
                            border: 0 !important;
                            box-shadow: none !important;
                            outline: 0 !important;
                        }
                        .wt-stock-opname-document .brand-table {
                            border-collapse: collapse;
                            table-layout: fixed;
                            width: 100%;
                        }
                        .wt-stock-opname-document .brand-table > tbody > tr > td {
                            background: transparent !important;
                            padding: 0 !important;
                            vertical-align: middle;
                            width: 50%;
                        }
                        .wt-stock-opname-document .brand-logo {
                            display: block;
                            max-height: 54px;
                            max-width: 210px;
                        }
                        .wt-stock-opname-document .brand-company-name {
                            color: inherit;
                            font-size: 20px;
                            font-weight: 700;
                            line-height: 1.2;
                            text-align: right;
                        }
                        .wt-stock-opname-document .brand-content-gap {
                            height: 30px;
                        }
                        .wt-stock-opname-document .document-meta-table {
                            border-collapse: collapse;
                            margin: 0 0 14px;
                            table-layout: fixed;
                            width: 100%;
                        }
                        .wt-stock-opname-document .document-meta-table > tbody > tr > td {
                            background: transparent !important;
                            padding: 0 !important;
                            vertical-align: top;
                        }
                        .wt-stock-opname-document .document-title {
                            color: inherit;
                            font-size: 18px;
                            font-weight: 700;
                            letter-spacing: 0;
                            line-height: 1.2;
                            margin: 0 0 8px;
                            text-align: left;
                            text-transform: none;
                        }
                        .wt-stock-opname-document .document-number-table {
                            border-collapse: collapse;
                            table-layout: fixed;
                            width: 100%;
                        }
                        .wt-stock-opname-document .document-number-table td {
                            background: transparent !important;
                            padding: 2px 0 !important;
                            vertical-align: top;
                        }
                        .wt-stock-opname-document .document-label {
                            width: 34%;
                        }
                        .wt-stock-opname-document .document-value {
                            padding-left: 8px !important;
                            text-align: left;
                            width: 66%;
                            word-wrap: break-word;
                        }
                        .wt-section-title {
                            background: transparent;
                            border-bottom: 1px solid #cbd5e1;
                            color: inherit;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 0;
                            line-height: 1.4;
                            margin-top: 14px;
                            padding: 0 0 5px;
                            text-transform: none;
                        }
                        .wt-table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                        }
                        .wt-table th {
                            background: #f3f4f6;
                            border: 1px solid #cbd5e1;
                            color: #111827;
                            font-size: 10px;
                            font-weight: 700;
                            line-height: 1.4;
                            padding: 9px 10px !important;
                            vertical-align: middle;
                        }
                        .wt-table td {
                            border: 1px solid #cbd5e1;
                            font-size: 10px;
                            line-height: 1.6;
                            overflow-wrap: anywhere;
                            padding: 10px 12px !important;
                            vertical-align: top;
                            word-break: break-word;
                            word-wrap: break-word;
                        }
                        .wt-meta {
                            border-collapse: collapse;
                            margin-bottom: 16px;
                            table-layout: fixed;
                            width: 100%;
                        }
                        .wt-meta td {
                            background: #fff !important;
                            border: 1px solid #cbd5e1 !important;
                            font-size: 10px;
                            line-height: 1.45;
                            padding: 7px 8px !important;
                            vertical-align: middle;
                        }
                        .wt-label {
                            background: #f3f4f6 !important;
                            color: inherit;
                            font-weight: 700;
                            width: 17%;
                        }
                        .wt-meta .wt-value {
                            width: 33%;
                        }
                        .wt-number {
                            text-align: right;
                            white-space: nowrap;
                            word-break: normal;
                            word-wrap: normal;
                        }
                        .wt-no-col {
                            min-width: 32px;
                            text-align: center;
                            white-space: nowrap;
                            width: 6%;
                        }
                        .wt-table th.wt-no-col,
                        .wt-table td.wt-no-col {
                            padding-left: 6px !important;
                            padding-right: 6px !important;
                        }
                        .wt-muted {
                            color: #6b7280;
                            font-size: 9px;
                            line-height: 1.45;
                        }
                        .wt-box {
                            border: 1px solid #cbd5e1;
                            padding: 10px;
                            min-height: 46px;
                        }
                    </style>

                    <table class="brand-table wt-borderless table-borderless" border="0" cellspacing="0" cellpadding="0" style="border: 0 !important; box-shadow: none !important; outline: 0 !important;">
                        <tbody style="border: 0 !important; outline: 0 !important;">
                            <tr style="border: 0 !important; outline: 0 !important;">
                                <td style="border: 0 !important; outline: 0 !important;">
                                    <t t-if="report_company.logo">
                                        <img class="brand-logo" t-att-src="image_data_uri(report_company.logo)" alt="Logo"/>
                                    </t>
                                    <t t-else="">
                                        <strong t-esc="report_company.name"/>
                                    </t>
                                </td>
                                <td class="brand-company-name" style="border: 0 !important; outline: 0 !important;">
                                    <span t-esc="report_company.name"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="brand-content-gap"></div>

                    <table class="document-meta-table wt-borderless table-borderless" border="0" cellspacing="0" cellpadding="0" style="border: 0 !important; box-shadow: none !important; outline: 0 !important;">
                        <tbody style="border: 0 !important; outline: 0 !important;">
                            <tr style="border: 0 !important; outline: 0 !important;">
                                <td style="border: 0 !important; outline: 0 !important; width: 48%;">
                                    <div class="document-title">
                                        <span class="label-en">STOCK OPNAME REPORT</span>
                                        <span class="label-id">Laporan Stock Opname</span>
                                    </div>
                                    <table class="document-number-table wt-borderless table-borderless" border="0" cellspacing="0" cellpadding="0" style="border: 0 !important; box-shadow: none !important; outline: 0 !important;">
                                        <tbody style="border: 0 !important; outline: 0 !important;">
                                            <tr style="border: 0 !important; outline: 0 !important;">
                                                <td class="document-label" style="border: 0 !important; outline: 0 !important;">
                                                    <span class="label-en">DOCUMENT NO.</span>
                                                    <span class="label-id">Nomor Dokumen</span>
                                                </td>
                                                <td class="document-value" style="border: 0 !important; outline: 0 !important;" t-esc="doc.name"/>
                                            </tr>
                                            <tr style="border: 0 !important; outline: 0 !important;">
                                                <td class="document-label" style="border: 0 !important; outline: 0 !important;">
                                                    <span class="label-en">DATE</span>
                                                    <span class="label-id">Tanggal</span>
                                                </td>
                                                <td class="document-value" style="border: 0 !important; outline: 0 !important;">
                                                    <span t-field="doc.date" t-options='{"widget": "date"}'/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                                <td style="border: 0 !important; outline: 0 !important; width: 52%;"></td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="wt-table wt-meta">
                        <tbody>
                            <tr>
                                <td class="wt-label">Estate</td>
                                <td class="wt-value"><span t-out="doc.warehouse_id.estate_id.display_name or '-'"/></td>
                                <td class="wt-label">Total Lot</td>
                                <td class="wt-value wt-number"><span t-out="doc.total_lot_count"/></td>
                            </tr>
                            <tr>
                                <td class="wt-label">Divisi</td>
                                <td class="wt-value"><span t-out="doc.division_id.display_name or ''"/></td>
                                <td class="wt-label">Total Qty Teori</td>
                                <td class="wt-value wt-number"><span t-out="('{:,.2f}'.format(doc.total_theoretical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                            </tr>
                            <tr>
                                <td class="wt-label">Gudang</td>
                                <td class="wt-value"><span t-out="doc.warehouse_id.display_name or ''"/></td>
                                <td class="wt-label">Total Qty Fisik</td>
                                <td class="wt-value wt-number"><span t-out="('{:,.2f}'.format(doc.total_physical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                            </tr>
                            <tr>
                                <td class="wt-label">Lokasi Stock</td>
                                <td class="wt-value"><span t-out="doc.location_id.complete_name or doc.location_id.display_name or ''"/></td>
                                <td class="wt-label">Total Selisih</td>
                                <td class="wt-value wt-number"><span t-out="('{:,.2f}'.format(doc.total_difference_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                            </tr>
                            <tr>
                                <td class="wt-label">Operator/Petugas</td>
                                <td class="wt-value" colspan="3"><span t-out="doc.operator_employee_id.name or ''"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="wt-section-title">HASIL STOCK OPNAME</div>
                    <table class="wt-table" style="margin-bottom: 12px;">
                        <thead>
                            <tr>
                                <th class="wt-no-col">No</th>
                                <th style="width: 19%;">Lot</th>
                                <th style="width: 12%;">Qty Teori</th>
                                <th style="width: 12%;">Qty Fisik</th>
                                <th style="width: 12%;">Selisih</th>
                                <th style="width: 10%;">Satuan</th>
                                <th style="width: 29%;">Alokasi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="not doc.line_ids">
                                <tr>
                                    <td colspan="7" style="text-align: center; color: #6b7280;">Belum ada data stok.</td>
                                </tr>
                            </t>
                            <t t-foreach="doc.line_ids" t-as="line">
                                <tr>
                                    <td class="wt-no-col"><span t-out="line_index + 1"/></td>
                                    <td><span t-out="line.lot_id.name or ''"/></td>
                                    <td class="wt-number"><span t-out="('{:,.2f}'.format(line.theoretical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                    <td class="wt-number"><span t-out="('{:,.2f}'.format(line.physical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                    <td class="wt-number"><span t-out="('{:,.2f}'.format(line.difference_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                    <td><span t-out="line.uom_id.name or ''"/></td>
                                    <td>
                                        <t t-if="line.allocation_ids">
                                            <t t-foreach="line.allocation_ids" t-as="allocation">
                                                <div>
                                                    <span t-out="allocation.reason_id.name"/>
                                                    <span class="wt-muted">(<span t-out="('{:,.2f}'.format(allocation.qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/>)</span>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <span class="wt-muted">-</span>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2" style="font-weight: 700; text-align: right;">TOTAL</td>
                                <td class="wt-number" style="font-weight: 700;"><span t-out="('{:,.2f}'.format(doc.total_theoretical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number" style="font-weight: 700;"><span t-out="('{:,.2f}'.format(doc.total_physical_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number" style="font-weight: 700;"><span t-out="('{:,.2f}'.format(doc.total_difference_qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td colspan="2"></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="wt-section-title">RINGKASAN ALOKASI SELISIH</div>
                    <table class="wt-table" style="margin-bottom: 12px;">
                        <thead>
                            <tr>
                                <th>Susut</th>
                                <th>Hilang</th>
                                <th>Salah</th>
                                <th>Lainnya</th>
                                <th>Total Teralokasi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(sum(susut_allocations.mapped('qty')) or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(sum(hilang_allocations.mapped('qty')) or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(sum(salah_allocations.mapped('qty')) or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(sum(lainnya_allocations.mapped('qty')) or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                                <td class="wt-number"><span t-out="('{:,.2f}'.format(sum(allocations.mapped('qty')) or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="wt-section-title">DETAIL ALOKASI SELISIH</div>
                    <table class="wt-table" style="margin-bottom: 18px;">
                        <thead>
                            <tr>
                                <th class="wt-no-col">No</th>
                                <th style="width: 14%;">Lot</th>
                                <th style="width: 15%;">Tipe</th>
                                <th style="width: 18%;">Alasan</th>
                                <th style="width: 11%;">Qty</th>
                                <th style="width: 18%;">Lokasi Stock</th>
                                <th style="width: 18%;">Catatan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="not allocations">
                                <tr>
                                    <td colspan="7" style="text-align: center; color: #6b7280;">Tidak ada alokasi selisih.</td>
                                </tr>
                            </t>
                            <t t-foreach="allocations" t-as="allocation">
                                <tr>
                                    <td class="wt-no-col"><span t-out="allocation_index + 1"/></td>
                                    <td><span t-out="allocation.line_id.lot_id.name or ''"/></td>
                                    <td><span t-out="dict(allocation.reason_id.DIFFERENCE_TYPE_SELECTION).get(allocation.reason_id.difference_type, allocation.reason_id.difference_type)"/></td>
                                    <td><span t-out="allocation.reason_id.name or ''"/></td>
                                    <td class="wt-number"><span t-out="('{:,.2f}'.format(allocation.qty or 0.0)).replace(',', 'X').replace('.', ',').replace('X', '.')"/> <span t-out="allocation.uom_id.name or ''"/></td>
                                    <td><span t-out="allocation.location_dest_id.complete_name or allocation.location_dest_id.display_name or ''"/></td>
                                    <td><span t-out="allocation.note or '-'"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="wt-section-title">CATATAN PEMERIKSAAN</div>
                    <div style="border: 1px solid #cbd5e1; min-height: 56px; margin-bottom: 20px; padding: 10px 12px;">
                        <span t-out="doc.note or ''"/>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; page-break-inside: avoid;">
                        <tr>
                            <td style="width: 33%; text-align: center; padding: 8px 12px;">
                                <div style="font-weight: 700;">Petugas</div>
                                <div style="height: 72px;"></div>
                                <div>( .................................... )</div>
                            </td>
                            <td style="width: 34%; text-align: center; padding: 8px 12px;">
                                <div style="font-weight: 700;">Diperiksa Oleh</div>
                                <div style="height: 72px;"></div>
                                <div>( .................................... )</div>
                            </td>
                            <td style="width: 33%; text-align: center; padding: 8px 12px;">
                                <div style="font-weight: 700;">Diketahui Oleh</div>
                                <div style="height: 72px;"></div>
                                <div>( .................................... )</div>
                            </td>
                        </tr>
                    </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
