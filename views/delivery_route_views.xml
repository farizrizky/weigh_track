<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wt_delivery_route_list" model="ir.ui.view">
        <field name="name">wt.delivery.route.list</field>
        <field name="model">wt.delivery.route</field>
        <field name="arch" type="xml">
            <list string="Delivery Route">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_wt_delivery_route_form" model="ir.ui.view">
        <field name="name">wt.delivery.route.form</field>
        <field name="model">wt.delivery.route</field>
        <field name="arch" type="xml">
            <form string="Delivery Route">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Route Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Route">
                            <field name="line_ids">
                                <list editable="bottom" string="Route">
                                    <field name="sequence"/>
                                    <field name="route_type"/>
                                    <field name="picking_type_id"
                                           options="{'no_create': True}"
                                           domain="[('code', '=', route_type == 'transit' and 'internal' or 'outgoing')]"/>
                                    <field name="allowed_source_location_ids" column_invisible="1"/>
                                    <field name="location_id"
                                           options="{'no_create': True}"
                                           domain="[('id', 'in', allowed_source_location_ids)]"/>
                                    <field name="location_dest_id" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_delivery_route" model="ir.actions.act_window">
        <field name="name">Delivery Routes</field>
        <field name="res_model">wt.delivery.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a New Delivery Route
            </p>
            <p>
                Save a complete delivery flow for each route, including internal transfers,
                transit locations, and the final customer destination.
            </p>
        </field>
    </record>

</odoo>
