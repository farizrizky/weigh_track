<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_wt_delivery_route_list" model="ir.ui.view">
        <field name="name">wt.delivery.route.list</field>
        <field name="model">wt.delivery.route</field>
        <field name="arch" type="xml">
            <list string="Rute Transit Pengiriman">
                <field name="name"/>
                <field name="picking_type_id"/>
                <field name="source_location_id"/>
                <field name="transit_location_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_wt_delivery_route_form" model="ir.ui.view">
        <field name="name">wt.delivery.route.form</field>
        <field name="model">wt.delivery.route</field>
        <field name="arch" type="xml">
            <form string="Rute Transit Pengiriman">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nama Rute..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="picking_type_id" options="{'no_create': True}"/>
                            <field name="source_location_id"/>
                            <field name="transit_location_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_wt_delivery_route" model="ir.actions.act_window">
        <field name="name">Rute Transit Pengiriman</field>
        <field name="res_model">wt.delivery.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat Konfigurasi Rute Transit Baru
            </p>
            <p>
                Tentukan mapping dari Lokasi Asal ke Lokasi Transit tujuan.
                Konfigurasi ini digunakan saat membuat Tahapan Pengiriman.
            </p>
        </field>
    </record>

</odoo>
