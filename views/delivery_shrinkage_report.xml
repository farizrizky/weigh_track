<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_delivery_shrinkage_report" model="report.paperformat">
        <field name="name">Laporan Susut Pengiriman A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_delivery_shrinkage_pdf" model="ir.actions.report">
        <field name="name">Laporan Susut Pengiriman</field>
        <field name="model">wt.delivery.shrinkage.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_delivery_shrinkage_document</field>
        <field name="report_file">weightrack.report_delivery_shrinkage_document</field>
        <field name="paperformat_id" ref="paperformat_delivery_shrinkage_report"/>
        <field name="print_report_name">'Laporan Susut Pengiriman - %s sd %s' % (object.start_date, object.end_date)</field>
    </record>

    <template id="report_delivery_shrinkage_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page wt-shrinkage-report">
                    <style>
                        .wt-shrinkage-report {
                            color: #111827;
                            font-family: "Lato", sans-serif;
                            font-size: 10px;
                            line-height: 1.35;
                        }
                        .wt-shrinkage-report .header-table {
                            border-collapse: collapse;
                            margin-bottom: 24px;
                            width: 100%;
                        }
                        .wt-shrinkage-report .header-table td {
                            vertical-align: top;
                        }
                        .wt-shrinkage-report .logo {
                            max-height: 72px;
                            max-width: 250px;
                        }
                        .wt-shrinkage-report .title {
                            color: #111827;
                            font-size: 18px;
                            font-weight: 700;
                            margin: 0 0 5px;
                            text-align: right;
                            text-transform: uppercase;
                        }
                        .wt-shrinkage-report .meta {
                            color: #374151;
                            text-align: right;
                        }
                        .wt-shrinkage-report .section-title {
                            color: #111827;
                            font-size: 10px;
                            font-weight: 700;
                            margin: 14px 0 6px;
                            text-transform: uppercase;
                        }
                        .wt-shrinkage-report .info-table {
                            border: 1px solid #cbd5e1;
                            border-collapse: collapse;
                            margin-bottom: 12px;
                            width: 100%;
                        }
                        .wt-shrinkage-report .info-table td {
                            border: 1px solid #cbd5e1;
                            font-size: 10px;
                            padding: 8px 10px !important;
                            vertical-align: top;
                        }
                        .wt-shrinkage-report .info-label {
                            background: #f3f4f6;
                            font-weight: 700;
                            width: 14%;
                        }
                        .wt-shrinkage-report .info-value {
                            width: 36%;
                        }
                        .wt-shrinkage-report .data-table {
                            border-collapse: collapse;
                            table-layout: fixed;
                            width: 100%;
                        }
                        .wt-shrinkage-report .data-table th {
                            background: #f3f4f6;
                            border: 1px solid #9ca3af;
                            font-size: 9px;
                            font-weight: 700;
                            line-height: 1.35;
                            padding: 7px 8px !important;
                            text-align: center;
                            vertical-align: middle;
                        }
                        .wt-shrinkage-report .data-table td {
                            border: 1px solid #cbd5e1;
                            font-size: 9px;
                            line-height: 1.35;
                            padding: 7px 8px !important;
                            vertical-align: middle;
                            word-break: break-word;
                        }
                        .wt-shrinkage-report .total-row td {
                            background: #f9fafb;
                            font-weight: 700;
                        }
                        .wt-shrinkage-report .text-center {
                            text-align: center;
                        }
                        .wt-shrinkage-report .text-right {
                            padding-right: 8px !important;
                            text-align: right;
                            white-space: nowrap;
                        }
                        .wt-shrinkage-report .muted {
                            color: #6b7280;
                        }
                        .wt-shrinkage-report .badge-shrinkage {
                            background: #fef2f2;
                            color: #dc2626;
                            border-radius: 4px;
                            padding: 1px 4px;
                        }
                    </style>

                    <table class="header-table">
                        <tr>
                            <td style="width: 40%;">
                                <t t-if="doc.company_id.logo">
                                    <img class="logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <strong t-esc="doc.company_id.name"/>
                                </t>
                            </td>
                            <td style="width: 60%;">
                                <h2 class="title">Laporan Susut Pengiriman</h2>
                                <div class="meta">
                                    <strong>Tanggal Cetak:</strong>
                                    <span t-esc="time.strftime('%d/%m/%Y')"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="info-table">
                        <tr>
                            <td class="info-label">Perusahaan</td>
                            <td class="info-value" t-esc="doc.company_id.name"/>
                            <td class="info-label">Tanggal Dari</td>
                            <td class="info-value"><span t-field="doc.start_date"/></td>
                        </tr>
                        <tr>
                            <td class="info-label">Customer</td>
                            <td class="info-value" t-esc="doc.customer_id.display_name if doc.customer_id else 'Semua Customer'"/>
                            <td class="info-label">Tanggal Sampai</td>
                            <td class="info-value"><span t-field="doc.end_date"/></td>
                        </tr>
                    </table>

                    <!-- Ringkasan per Customer -->
                    <div class="section-title">Ringkasan Per Customer</div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">No</th>
                                <th style="width: 35%;">Customer</th>
                                <th style="width: 15%;">Total Terkirim (kg)</th>
                                <th style="width: 15%;">Total Diterima (kg)</th>
                                <th style="width: 15%;">Susut (kg)</th>
                                <th style="width: 15%;">% Susut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="doc.summary_line_ids">
                                <t t-foreach="doc.summary_line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center" t-esc="line.sequence"/>
                                        <td t-esc="line.customer_name"/>
                                        <td class="text-right"><span t-esc="'%.2f' % (line.shipped_qty or 0.0)"/> kg</td>
                                        <td class="text-right"><span t-esc="'%.2f' % (line.received_qty or 0.0)"/> kg</td>
                                        <td class="text-right"><span t-esc="'%.2f' % (line.shrinkage_qty or 0.0)"/> kg</td>
                                        <td class="text-right"><span t-esc="line.shrinkage_percentage or '0.00%'"/></td>
                                    </tr>
                                </t>
                                <tr class="total-row">
                                    <td colspan="2" class="text-right">Total</td>
                                    <td class="text-right"><span t-esc="'%.2f' % (doc.total_shipped_qty or 0.0)"/> kg</td>
                                    <td class="text-right"><span t-esc="'%.2f' % (doc.total_received_qty or 0.0)"/> kg</td>
                                    <td class="text-right"><span t-esc="'%.2f' % (doc.total_shrinkage_qty or 0.0)"/> kg</td>
                                    <td class="text-right"><span t-esc="doc.total_shrinkage_percentage or '0.00%'"/></td>
                                </tr>
                            </t>
                            <tr t-if="not doc.summary_line_ids">
                                <td colspan="6" class="text-center muted">Tidak ada data susut pengiriman pada filter ini.</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Detail per DO -->
                    <div class="section-title">Detail Susut Pengiriman</div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">No</th>
                                <th style="width: 10%;">Tanggal</th>
                                <th style="width: 15%;">Nomor DO</th>
                                <th style="width: 24%;">Customer</th>
                                <th style="width: 15%;">Berat Terkirim</th>
                                <th style="width: 15%;">Berat Diterima</th>
                                <th style="width: 10%;">Susut (kg)</th>
                                <th style="width: 6%;">% Susut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="doc.detail_line_ids">
                                <t t-foreach="doc.detail_line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center" t-esc="line.sequence"/>
                                        <td><span t-field="line.delivery_date" t-options='{"widget": "date"}'/></td>
                                        <td t-esc="line.delivery_name"/>
                                        <td t-esc="line.customer_name"/>
                                        <td class="text-right"><span t-esc="'%.2f' % (line.shipped_qty or 0.0)"/> <span t-esc="line.uom_name or 'kg'"/></td>
                                        <td class="text-right"><span t-esc="'%.2f' % (line.received_qty or 0.0)"/> <span t-esc="line.uom_name or 'kg'"/></td>
                                        <td class="text-right"><span t-esc="'%.2f' % (line.shrinkage_qty or 0.0)"/> <span t-esc="line.uom_name or 'kg'"/></td>
                                        <td class="text-right"><span t-esc="line.shrinkage_percentage or '0.00%'"/></td>
                                    </tr>
                                </t>
                                <tr class="total-row">
                                    <td colspan="4" class="text-right">Total</td>
                                    <td class="text-right"><span t-esc="'%.2f' % (doc.total_shipped_qty or 0.0)"/> kg</td>
                                    <td class="text-right"><span t-esc="'%.2f' % (doc.total_received_qty or 0.0)"/> kg</td>
                                    <td class="text-right"><span t-esc="'%.2f' % (doc.total_shrinkage_qty or 0.0)"/> kg</td>
                                    <td class="text-right"><span t-esc="doc.total_shrinkage_percentage or '0.00%'"/></td>
                                </tr>
                            </t>
                            <tr t-if="not doc.detail_line_ids">
                                <td colspan="8" class="text-center muted">Tidak ada detail susut pengiriman pada filter ini.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
