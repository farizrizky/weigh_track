<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_delivery_migration_reset_log_list" model="ir.ui.view">
        <field name="name">wt.delivery.migration.reset.log.list</field>
        <field name="model">wt.delivery.migration.reset.log</field>
        <field name="arch" type="xml">
            <list string="Delivery Migration Reset Logs"
                  create="0"
                  edit="0"
                  delete="0">
                <field name="name"/>
                <field name="delivery_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="reset_at"/>
                <field name="reset_by_id"/>
                <field name="movement_count"/>
                <field name="transit_lot_count"/>
                <field name="shrinkage_quantity"/>
            </list>
        </field>
    </record>

    <record id="view_wt_delivery_migration_reset_log_form" model="ir.ui.view">
        <field name="name">wt.delivery.migration.reset.log.form</field>
        <field name="model">wt.delivery.migration.reset.log</field>
        <field name="arch" type="xml">
            <form string="Delivery Migration Reset Log"
                  create="0"
                  edit="0"
                  delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="delivery_id"/>
                            <field name="delivery_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="original_state"/>
                        </group>
                        <group>
                            <field name="reset_at"/>
                            <field name="reset_by_id"/>
                            <field name="movement_count"/>
                            <field name="reversal_movement_count"/>
                            <field name="picking_count"/>
                            <field name="transit_lot_count"/>
                            <field name="shrinkage_quantity"/>
                            <field name="total_reversed_quantity"/>
                        </group>
                    </group>
                    <group string="Reset Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Stock Movements">
                            <field name="move_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="date"/>
                                    <field name="reference"/>
                                    <field name="product_id"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="quantity"/>
                                    <field name="wt_migration_reset_role"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Transfers">
                            <field name="picking_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="scheduled_date"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Transit Lots">
                            <field name="transit_lot_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="wt_transit_date"/>
                                    <field name="wt_transit_state"/>
                                    <field name="wt_total_qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Stock Snapshot">
                            <group>
                                <field name="stock_snapshot_before" readonly="1"/>
                                <field name="stock_snapshot_after" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_delivery_migration_reset_log" model="ir.actions.act_window">
        <field name="name">Delivery Migration Reset Logs</field>
        <field name="res_model">wt.delivery.migration.reset.log</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_wt_delivery_migration_reset_log_list"/>
    </record>

    <record id="view_wt_delivery_migration_reset_wizard_form" model="ir.ui.view">
        <field name="name">wt.delivery.migration.reset.wizard.form</field>
        <field name="model">wt.delivery.migration.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset Delivery for Migration">
                <sheet>
                    <div class="alert alert-danger" role="alert">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        This migration-only operation reverses all delivery stock movements,
                        restores shrinkage to the source lots, closes generated transit lots,
                        and returns the delivery to Draft.
                    </div>
                    <group>
                        <group>
                            <field name="delivery_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="picking_count"/>
                            <field name="movement_count"/>
                        </group>
                        <group>
                            <field name="transit_lot_count"/>
                            <field name="shrinkage_quantity"/>
                        </group>
                    </group>
                    <group string="Reset Confirmation">
                        <field name="reason"
                               placeholder="Explain why this delivery must be reset for data migration..."/>
                        <field name="confirmation"
                               placeholder="Type the delivery number exactly"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reset"
                            type="object"
                            string="Reset Delivery"
                            class="btn-danger"
                            confirm="This operation will reverse all stock movements for this delivery. Continue?"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
