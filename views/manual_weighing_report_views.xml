<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_manual_weighing_report_form" model="ir.ui.view">
        <field name="name">wt.manual.weighing.report.form</field>
        <field name="model">wt.manual.weighing.report</field>
        <field name="arch" type="xml">
            <form string="Manual Weighing Report" edit="0" delete="0">
                <header>
                    <button name="action_open_filter" type="object" string="Filter" class="oe_highlight"/>
                    <button name="action_print_pdf" type="object" string="Export PDF" invisible="not is_filtered"/>
                    <button name="action_export_excel" type="object" string="Export Excel" invisible="not is_filtered"/>
                </header>
                <sheet>
                    <field name="is_filtered" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" role="status" invisible="is_filtered">
                        Please click Filter to display the report data.
                    </div>
                    <group invisible="not is_filtered">
                        <group string="Filter">
                            <field name="company_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="location_type"/>
                            <field name="total_records"/>
                        </group>
                    </group>
                    <field name="line_ids" invisible="not is_filtered">
                        <list string="Manual Weighing Report" create="0" edit="0" delete="0">
                            <field name="sequence" column_invisible="True"/>
                            <field name="event_date"/>
                            <field name="weighing_number"/>
                            <field name="estate_name"/>
                            <field name="division_name"/>
                            <field name="tapper_name"/>
                            <field name="foreman_name"/>
                            <field name="operator_name"/>
                            <field name="device_name"/>
                            <field name="device_identifier"/>
                            <field name="weighing_location_name"/>
                            <field name="location_type"/>
                            <field name="manual_weighing_reason"/>
                            <field name="state" widget="badge"
                                   decoration-muted="state == 'not_receipted'"
                                   decoration-info="state == 'in_production_receipt'"
                                   decoration-success="state == 'receipt_validated'"
                                   decoration-danger="state == 'receipt_cancelled'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_manual_weighing_report" model="ir.actions.act_window">
        <field name="name">Manual Weighing Report</field>
        <field name="res_model">wt.manual.weighing.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_manual_weighing_report_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <record id="view_wt_manual_weighing_report_wizard_form" model="ir.ui.view">
        <field name="name">wt.manual.weighing.report.wizard.form</field>
        <field name="model">wt.manual.weighing.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual Weighing Report">
                <sheet>
                    <field name="report_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group string="Filter">
                            <field name="date_start" required="1"/>
                            <field name="date_end" required="1"/>
                            <field name="location_type" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_filter" type="object" string="Apply Filter" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wt_manual_weighing_report_wizard" model="ir.actions.act_window">
        <field name="name">Manual Weighing Report</field>
        <field name="res_model">wt.manual.weighing.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_manual_weighing_report_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
