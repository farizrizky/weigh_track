<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_weighing_production_report" model="report.paperformat">
        <field name="name">Weighing Production Report A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_weighing_production_pdf" model="ir.actions.report">
        <field name="name">Laporan Penimbangan Produksi</field>
        <field name="model">wt.weighing.production.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_weighing_production_document</field>
        <field name="report_file">weightrack.report_weighing_production_document</field>
        <field name="paperformat_id" ref="paperformat_weighing_production_report"/>
        <field name="print_report_name">'Laporan Penimbangan Produksi - %s' % (object.production_date)</field>
    </record>

    <template id="report_weighing_production_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page wt-weighing-production-report">
                    <style>
.wt-weighing-production-report {
                            color: #111827;
                            font-family: "Lato", sans-serif;
                            font-size: 10px;
                            line-height: 1.35;
                        }
                        .wt-weighing-production-report .header-table {
                            border-collapse: collapse;
                            margin-bottom: 24px;
                            width: 100%;
                        }
                        .wt-weighing-production-report .header-table td {
                            vertical-align: top;
                        }
                        .wt-weighing-production-report .logo {
                            max-height: 72px;
                            max-width: 250px;
                        }
                        .wt-weighing-production-report .title {
                            color: #111827;
                            font-size: 18px;
                            font-weight: 700;
                            margin: 0 0 5px;
                            text-align: right;
                            text-transform: uppercase;
                        }
                        .wt-weighing-production-report .meta {
                            color: #374151;
                            text-align: right;
                        }
                        .wt-weighing-production-report .section-title {
                            background: #111827;
                            color: #fff;
                            font-size: 10px;
                            font-weight: 700;
                            margin-top: 10px;
                            padding: 7px 10px;
                            text-transform: uppercase;
                        }
                        .wt-weighing-production-report .info-table {
                            border: 1px solid #cbd5e1;
                            border-collapse: collapse;
                            margin-bottom: 12px;
                            width: 100%;
                        }
                        .wt-weighing-production-report .info-table td {
                            border: 1px solid #cbd5e1;
                            font-size: 10px;
                            padding: 8px 10px !important;
                            vertical-align: top;
                        }
                        .wt-weighing-production-report .info-label {
                            background: #f3f4f6;
                            font-weight: 700;
                            width: 18%;
                        }
                        .wt-weighing-production-report .info-value {
                            width: 32%;
                        }
                        .wt-weighing-production-report .data-table {
                            border-collapse: collapse;
                            table-layout: fixed;
                            width: 100%;
                        }
                        .wt-weighing-production-report .data-table th,
                        .wt-weighing-production-report .data-table td {
                            border: 1px solid #cbd5e1;
                            font-size: 10px;
                            line-height: 1.35;
                            padding: 8px 10px !important;
                            vertical-align: middle;
                        }
                        .wt-weighing-production-report .data-table th {
                            background: #f3f4f6;
                            border: 1px solid #9ca3af;
                            font-size: 10px;
                            font-weight: 700;
                            text-align: center;
                        }
                        .wt-weighing-production-report .text-center {
                            text-align: center;
                        }
                        .wt-weighing-production-report .text-right {
                            text-align: right;
                            padding-right: 10px !important;
                            white-space: nowrap;
                        }
                        .wt-weighing-production-report .total-row td {
                            background: #f9fafb;
                            font-weight: 700;
                        }
                        .wt-weighing-production-report .empty-row {
                            height: 20px;
                        }
                    </style>

                    <table class="header-table">
                        <tr>
                            <td style="width: 40%;">
                                <t t-if="doc.company_id.logo">
                                    <img class="logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <strong t-esc="doc.company_id.name"/>
                                </t>
                            </td>
                            <td style="width: 60%;">
                                <h2 class="title">Laporan Penimbangan Produksi</h2>
                                <div class="meta">
                                    <div><strong>Tanggal Cetak:</strong> <span t-esc="time.strftime('%d/%m/%Y')"/></div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="info-table">
                        <tr>
                            <td class="info-label">Perusahaan</td>
                            <td class="info-value" t-esc="doc.company_id.name"/>
                            <td class="info-label">Divisi</td>
                            <td class="info-value">
                                <span t-if="doc.division_id" t-esc="doc.division_id.name"/>
                                <span t-else="">Semua Divisi</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="info-label">Tanggal Produksi</td>
                            <td class="info-value"><span t-field="doc.production_date"/></td>
                            <td class="info-label">Cuaca</td>
                            <td class="info-value">
                                <span t-esc="doc.weather_display or '-'"/>
                            </td>
                        </tr>
                    </table>

                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 4%;">No</th>
                                <th style="width: 14%;">Nama Tapper</th>
                                <th style="width: 12%;">Mandor</th>
                                <th style="width: 9%;">Timbangan<br/>Lapangan</th>
                                <th style="width: 9%;">Timbangan<br/>Gudang</th>
                                <th style="width: 7%;">Reject</th>
                                <th style="width: 7%;">Slab</th>
                                <th style="width: 9%;">Cup Lump<br/>Bersih</th>
                                <th style="width: 7%;">Jml.<br/>Karung</th>
                                <th style="width: 7%;">Susut</th>
                                <th style="width: 6%;">Susut<br/>%</th>
                                <th style="width: 9%;">Keterangan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="doc.line_ids">
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center" t-esc="line.sequence"/>
                                        <td><span t-esc="line.tapper_name"/></td>
                                        <td><span t-esc="line.foreman_name"/></td>
                                        <td class="text-right">
                                            <span t-if="line.field_weight" t-esc="'%.2f' % line.field_weight"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-if="line.warehouse_weight" t-esc="'%.2f' % line.warehouse_weight"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-if="line.reject_weight" t-esc="'%.2f' % line.reject_weight"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-if="line.slab_weight" t-esc="'%.2f' % line.slab_weight"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-if="line.net_weight" t-esc="'%.2f' % line.net_weight"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-if="line.total_bag" t-esc="line.total_bag"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-if="line.field_weight" t-esc="'%.2f' % line.shrinkage_weight"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-if="line.field_weight" t-esc="'%.2f' % line.shrinkage_percentage"/>
                                        </td>
                                        <td><span t-esc="line.note"/></td>
                                    </tr>
                                </t>
                                <tr class="total-row">
                                    <td colspan="3" class="text-center">Total</td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % doc.total_field_weight"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % doc.total_warehouse_weight"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % doc.total_reject_weight"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % doc.total_slab_weight"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % doc.total_net_weight"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="doc.total_bag"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % doc.total_shrinkage"/>
                                    </td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </t>
                            <tr t-if="not doc.line_ids">
                                <td colspan="12" class="text-center">Tidak ada data penimbangan.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
