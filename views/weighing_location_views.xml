<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_weighing_location_search" model="ir.ui.view">
        <field name="name">wt.weighing.location.search</field>
        <field name="model">wt.weighing.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="estate_id"/>
                <field name="operator_id"/>
                <field name="allowed_division_ids"/>
            </search>
        </field>
    </record>

    <record id="view_wt_weighing_location_list" model="ir.ui.view">
        <field name="name">wt.weighing.location.list</field>
        <field name="model">wt.weighing.location</field>
        <field name="arch" type="xml">
            <list string="Weighing Locations">
                <field name="code"/>
                <field name="name"/>
                <field name="estate_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="operator_id"/>
                <field name="allowed_division_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_wt_weighing_location_form" model="ir.ui.view">
        <field name="name">wt.weighing.location.form</field>
        <field name="model">wt.weighing.location</field>
        <field name="arch" type="xml">
            <form string="Weighing Location">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Weighing Location Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="estate_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="allowed_operator_employee_ids" invisible="1"/>
                            <field name="operator_id" domain="[('id', 'in', allowed_operator_employee_ids)]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allowed Divisions">
                            <field name="allowed_division_ids" domain="[('estate_id', '=', estate_id)]">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="estate_id"/>
                                    <field name="clerk_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_weighing_location" model="ir.actions.act_window">
        <field name="name">Weighing Locations</field>
        <field name="res_model">wt.weighing.location</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_weighing_location_search"/>
    </record>
</odoo>
