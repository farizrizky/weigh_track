<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_wt_delivery_list" model="ir.ui.view">
        <field name="name">wt.delivery.list</field>
        <field name="model">wt.delivery</field>
        <field name="arch" type="xml">
            <list string="Tugas Pengiriman"
                  decoration-info="state == 'draft'"
                  decoration-primary="state in ('confirmed','in_progress')"
                  decoration-success="state in ('validated', 'done')"
                  decoration-warning="state == 'completed'"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id" string="Customer" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="step_count" string="Steps" optional="show"/>
                <field name="picking_count" string="Jumlah DO"/>
                <field name="total_demand_qty" string="Total Demand (kg)"/>
                <field name="total_physical_qty" string="Total Fisik (kg)"/>
                <field name="total_difference_qty" string="Total Selisih (kg)"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state in ('confirmed','in_progress')"
                       decoration-warning="state == 'completed'"
                       decoration-success="state in ('validated', 'done')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_wt_delivery_form" model="ir.ui.view">
        <field name="name">wt.delivery.form</field>
        <field name="model">wt.delivery</field>
        <field name="arch" type="xml">
            <form string="Tugas Pengiriman">
                <header>
                    <button name="action_confirm"
                            string="Konfirmasi"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start"
                            string="Mulai"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_complete"
                            string="Selesai Timbang"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'in_progress' or step_count &gt; 0"/>
                    <button name="action_validate"
                            string="Validasi &amp; Kirim"
                            type="object"
                            class="btn-success"
                            invisible="state != 'completed'"
                            confirm="Aksi ini akan mengupdate DO dan membuat dokumen Scrap susut secara otomatis. Lanjutkan?"/>
                    <button name="action_cancel"
                            string="Batalkan"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('validated','done','cancelled')"
                            confirm="Yakin ingin membatalkan tugas pengiriman ini?"/>
                    <button name="action_draft"
                            string="Set ke Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,completed,validated,done"/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <!-- Smart button DO: muncul setelah validated (picking dari do_lines) -->
                        <button name="action_view_pickings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="DO Dibuat"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="product_id" readonly="state not in ('draft', 'confirmed')" optional="show"/>
                        </group>
                        <group>
                            <field name="total_demand_qty" readonly="1"/>
                            <field name="total_physical_qty" readonly="1"/>
                            <field name="total_difference_qty" readonly="1"/>
                        </group>
                    </group>

                    <!-- Banner Peringatan jika ada Lot baru yang belum di-pull oleh operator -->
                    <div class="alert alert-warning d-flex align-items-center" role="alert"
                         invisible="not wt_has_unpulled_lines">
                        <i class="fa fa-exclamation-triangle me-2" style="font-size: 1.5em;"/>
                        <div>
                            <strong>Perhatian:</strong> Terdapat lot baru/tambahan yang belum di-pull oleh operator timbangan di lapangan. 
                            Hal ini biasanya terjadi karena perubahan stock reservasi (misal setelah Apply Adjustment). 
                            Harap informasikan ke operator untuk melakukan <strong>Pull Tugas</strong> ulang pada perangkat mereka.
                        </div>
                    </div>

                    <field name="wt_has_unpulled_lines" invisible="1"/>

                    <notebook>

                        <!-- Tab 2: Delivery Orders (DO) -->
                        <page string="Delivery Orders (DO)">

                            <!-- ── SECTION A: Rencana DO (hanya saat Draft & Confirmed) ── -->
                            <group invisible="state not in ('draft', 'confirmed')">
                                <div class="alert alert-info d-flex align-items-start mb-3" role="alert">
                                    <i class="fa fa-info-circle me-2 mt-1" style="font-size:1.2em;"/>
                                    <div>
                                        Isi rencana DO di bawah ini. Tidak ada DO Odoo yang dibuat selama proses.
                                        DO akan dibuat otomatis dengan status <strong>Selesai</strong>
                                        saat klik <strong>Validasi &amp; Kirim</strong>.
                                    </div>
                                </div>
                            </group>

                            <!-- Tabel Rencana DO (satu field, perilaku berubah berdasarkan state) -->
                            <field name="do_line_ids"
                                   readonly="state in ('validated', 'done', 'cancelled')"
                                   context="{'default_delivery_id': id, 'default_company_id': company_id}">
                                <list string="Rencana DO"
                                      decoration-success="picking_state == 'done'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="picking_type_id"
                                           options="{'no_create': True, 'no_open': True}"
                                           string="Tipe Operasi"/>
                                    <field name="product_id"
                                           options="{'no_create': True}"
                                           string="Produk"/>
                                    <field name="operator_id"
                                           options="{'no_create': True}"
                                           string="Operator"/>
                                    <field name="location_id"
                                           options="{'no_create': True}"
                                           string="Lokasi Sumber"/>
                                    <field name="location_dest_id"
                                           options="{'no_create': True}"
                                           string="Lokasi Tujuan"/>
                                    <field name="route_id"
                                           string="Rute"
                                           optional="show"/>
                                    <field name="demand_qty"
                                           string="Demand (kg)"/>
                                    <field name="partner_id"
                                           options="{'no_create': True}"
                                           string="Partner Tujuan"
                                           optional="hide"/>
                                    <field name="scheduled_date"
                                           string="Tgl Terjadwal"
                                           optional="hide"/>
                                    <!-- Kolom hasil generate — hanya tampil setelah validated -->
                                    <field name="picking_id"
                                           string="DO Terbentuk"
                                           options="{'no_open': False}"
                                           optional="show"
                                           readonly="1"/>
                                    <field name="picking_state"
                                           string="Status DO"
                                           widget="badge"
                                           decoration-success="picking_state == 'done'"
                                           decoration-info="picking_state == 'confirmed'"
                                           decoration-danger="picking_state == 'cancel'"
                                           optional="show"
                                           readonly="1"/>
                                     <button name="action_validate_line"
                                             string="Validasi"
                                             type="object"
                                             icon="fa-check"
                                             class="btn-primary"
                                             invisible="picking_state == 'done' or parent.state in ('validated', 'done', 'cancelled')"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                                <form string="Rincian Rencana DO">
                                     <header>
                                         <button name="action_validate_line"
                                                 string="Validasi Rencana DO"
                                                 type="object"
                                                 class="btn-primary"
                                                 invisible="picking_state == 'done' or parent.state in ('validated', 'done', 'cancelled')"/>
                                         <field name="picking_state" widget="statusbar" statusbar_visible="assigned,done" invisible="not picking_id"/>
                                     </header>
                                    <sheet>
                                         <field name="picking_state" invisible="1"/>
                                         <field name="picking_id" invisible="1"/>
                                        <group>
                                             <group string="Konfigurasi Operasi">
                                                <field name="route_id" options="{'no_create': True}" force_save="1"
                                                       readonly="picking_state == 'done'"/>
                                                <field name="picking_type_id"
                                                       options="{'no_create': True, 'no_open': True}"
                                                       readonly="route_id or picking_state == 'done'"
                                                       force_save="1"/>
                                                <field name="product_id" options="{'no_create': True}"
                                                       readonly="picking_state == 'done'"/>
                                                <field name="operator_id" options="{'no_create': True}"
                                                       readonly="picking_state == 'done'"/>
                                            </group>
                                            <group string="Lokasi &amp; Tanggal">
                                                <field name="location_id"
                                                       options="{'no_create': True}"
                                                       readonly="route_id or picking_state == 'done'"
                                                       force_save="1"/>
                                                <field name="location_dest_id"
                                                       options="{'no_create': True}"
                                                       readonly="route_id or picking_state == 'done'"
                                                       force_save="1"/>
                                                <field name="scheduled_date"
                                                       readonly="picking_state == 'done'"/>
                                                <field name="demand_qty" force_save="1"
                                                       readonly="picking_state == 'done'"/>
                                                <field name="partner_id" options="{'no_create': True}"
                                                       readonly="picking_state == 'done'"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Perincian Lot (Lot Details)">
                                                <field name="lot_line_ids" context="{'default_do_line_id': id}"
                                                       readonly="picking_state == 'done'">
                                                    <list string="Perincian Lot" editable="bottom">
                                                        <field name="lot_id" options="{'no_create': True}" domain="[('product_id', '=', product_id), ('quant_ids.location_id', 'child_of', parent.location_id), ('quant_ids.quantity', '&gt;', 0)]" context="{'location_id': parent.location_id, 'default_product_id': product_id}"/>
                                                        <field name="location_id" readonly="1" string="Lokasi"/>
                                                        <field name="wt_qty_on_hand" readonly="1" string="Stok Fisik (kg)"/>
                                                        <field name="wt_qty_reserved" readonly="1" string="Terpesan (kg)"/>
                                                        <field name="qty_available" readonly="1" string="Stok Bebas (kg)"/>
                                                        <field name="qty" string="Demand (kg)"/>
                                                        <field name="wt_physical_qty" string="Berat Fisik (kg)" readonly="1" optional="show"/>
                                                        <field name="wt_difference_qty" string="Selisih (kg)" readonly="1" optional="show"/>
                                                        <field name="wt_skip_line" string="Lewati" optional="hide"/>
                                                        <field name="wt_note" string="Catatan" optional="hide"/>
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>

                            <!-- Info saat proses berlangsung -->
                            <div class="alert alert-warning d-flex align-items-center mt-3"
                                 invisible="state not in ('in_progress', 'completed') or not do_line_ids"
                                 role="alert">
                                <i class="fa fa-clock-o me-2" style="font-size:1.2em;"/>
                                <div>
                                    DO Odoo belum dibuat. DO akan dibuat otomatis (langsung <strong>Selesai</strong>)
                                    setelah klik <strong>Validasi &amp; Kirim</strong>.
                                </div>
                            </div>
                        </page>



                        <!-- Tab 2: Detail Timbang -->
                        <page string="Detail Timbang">
                            <div class="mb-2 d-flex gap-2"
                                 invisible="not has_adjustable_lines or state not in ('in_progress', 'completed')">
                                <button name="action_apply_adjustment"
                                        string="Apply Adjustment"
                                        type="object"
                                        class="btn btn-warning"
                                        icon="fa-check-circle"
                                        confirm="Aksi ini akan mengkoreksi stok sesuai alokasi selisih yang sudah diatur. Stok lot terdampak akan disesuaikan sekarang. Lanjutkan?"/>
                            </div>

                            <!-- Tabel Detail Timbang Rencana DO (alur baru) -->
                            <field name="pulled_do_lot_line_ids"
                                   invisible="not do_line_ids"
                                   readonly="state in ('validated','cancelled')">
                                <list string="Detail Timbang (Rencana)" create="false" delete="false" edit="false"
                                      decoration-danger="not wt_skip_line and wt_physical_qty == 0.0"
                                      decoration-warning="wt_difference_qty &lt; -0.001 and not wt_is_fully_allocated"
                                      decoration-success="wt_physical_qty &gt; 0.0 and (wt_difference_qty == 0.0 or wt_is_fully_allocated)">
                                    <field name="route_id" string="Rute" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="lot_id" readonly="1"/>
                                    <field name="qty" string="Demand Rencana (kg)" readonly="1"/>
                                    <field name="wt_physical_qty" string="Berat Fisik (kg)" readonly="1"/>
                                    <field name="wt_difference_qty" string="Selisih (kg)" readonly="1"
                                           decoration-danger="wt_difference_qty &lt; -0.001"
                                           decoration-success="wt_difference_qty &gt;= -0.001"/>
                                    <field name="wt_is_fully_allocated" column_invisible="1"/>
                                    <field name="wt_unallocated_qty" string="Belum Teralokasi"
                                           readonly="1" optional="show"
                                           decoration-danger="wt_unallocated_qty &gt; 0.001"
                                           decoration-success="wt_unallocated_qty &lt;= 0.001"/>
                                    <field name="wt_adjustment_applied" column_invisible="1"/>
                                    <button name="action_configure_allocation"
                                            string="Alokasi"
                                            type="object"
                                            icon="fa-sliders"
                                            invisible="wt_difference_qty == 0.0 or wt_adjustment_applied"/>
                                    <field name="wt_note" string="Catatan" optional="hide"/>
                                    <field name="wt_skip_line" string="Lewati" optional="hide"/>
                                </list>
                            </field>

                            <!-- Tabel Detail Timbang DO Asli (alur lama) -->
                            <field name="pulled_move_line_ids"
                                   invisible="do_line_ids"
                                   readonly="state in ('validated','cancelled')"
                                   domain="[]"
                                   context="{'show_original_demand': state == 'validated'}">
                                <list string="Detail Timbang"
                                      editable="bottom"
                                      create="false"
                                      delete="false"
                                      decoration-danger="not wt_skip_line and wt_physical_qty == 0.0"
                                      decoration-warning="wt_difference_qty &lt; -0.001 and not wt_is_fully_allocated"
                                      decoration-success="wt_physical_qty &gt; 0.0 and (wt_difference_qty == 0.0 or wt_is_fully_allocated)">
                                    <field name="picking_id" string="DO" readonly="1" optional="show"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="lot_id" readonly="1"/>
                                    <field name="product_uom_id" readonly="1" optional="hide"/>
                                    <field name="wt_original_demand_qty" string="Demand Awal (kg)" readonly="1"
                                           optional="show"
                                           decoration-info="wt_original_demand_qty == 0"/>
                                    <field name="quantity" string="Terkirim (kg)" readonly="1"/>
                                    <field name="wt_physical_qty" string="Berat Fisik (kg)"/>
                                    <field name="wt_difference_qty" string="Selisih (kg)" readonly="1"
                                           decoration-danger="wt_difference_qty &lt; -0.001"
                                           decoration-success="wt_difference_qty &gt;= -0.001"/>
                                    <field name="wt_is_fully_allocated" column_invisible="1"/>
                                    <field name="wt_unallocated_qty" string="Belum Teralokasi"
                                           readonly="1" optional="show"
                                           decoration-danger="wt_unallocated_qty &gt; 0.001"
                                           decoration-success="wt_unallocated_qty &lt;= 0.001"/>
                                    <field name="wt_adjustment_applied" column_invisible="1"/>
                                    <button name="action_configure_allocation"
                                            string="Alokasi"
                                            type="object"
                                            icon="fa-sliders"
                                            invisible="wt_difference_qty == 0.0 or wt_adjustment_applied"/>
                                    <field name="wt_note" string="Catatan" optional="hide"/>
                                    <field name="wt_skip_line" string="Lewati" optional="hide"/>
                                </list>
                            </field>

                            <!-- Section Lot Belum Di-Push Rencana DO (alur baru) -->
                            <div class="mt-4" invisible="not wt_has_unpulled_lines or not do_line_ids">
                                <h4 class="text-warning">
                                    <i class="fa fa-info-circle me-1"/>
                                    Daftar Lot Rencana yang Belum Di-Push (Operator Harus Pull Ulang)
                                </h4>
                                <field name="unpulled_do_lot_line_ids" readonly="1">
                                    <list string="Lot Rencana Belum Di-Push" create="false" delete="false" edit="false">
                                        <field name="route_id" string="Rute"/>
                                        <field name="product_id" string="Produk"/>
                                        <field name="lot_id" string="Nomor Seri/Lot"/>
                                        <field name="qty" string="Qty Demand (kg)"/>
                                    </list>
                                </field>
                            </div>

                            <!-- Section Lot Belum Di-Push DO Asli (alur lama) -->
                            <div class="mt-4" invisible="not wt_has_unpulled_lines or do_line_ids">
                                <h4 class="text-warning">
                                    <i class="fa fa-info-circle me-1"/>
                                    Daftar Lot Baru yang Belum Di-Push (Operator Harus Pull Ulang)
                                </h4>
                                <field name="unpulled_move_line_ids" readonly="1">
                                    <list string="Lot Belum Di-Push" create="false" delete="false" edit="false">
                                        <field name="picking_id" string="DO"/>
                                        <field name="product_id" string="Produk"/>
                                        <field name="lot_id" string="Nomor Seri/Lot"/>
                                        <field name="quantity" string="Qty Demand (kg)"/>
                                        <field name="location_id" string="Lokasi Asal"/>
                                        <field name="location_dest_id" string="Lokasi Tujuan"/>
                                    </list>
                                </field>
                            </div>
                        </page>

                        <!-- Tab 3: Catatan -->
                        <page string="Catatan">
                            <field name="note"/>
                        </page>
                    </notebook>

                    <group string="Informasi Validasi" invisible="state != 'validated'">
                        <field name="validated_at" readonly="1"/>
                        <field name="validated_by_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_wt_delivery_search" model="ir.ui.view">
        <field name="name">wt.delivery.search</field>
        <field name="model">wt.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <filter string="Draft"       name="draft"       domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed"   name="confirmed"   domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed"   name="completed"   domain="[('state', '=', 'completed')]"/>
                <filter string="Validated"   name="validated"   domain="[('state', '=', 'validated')]"/>
                <filter string="Cancelled"   name="cancelled"   domain="[('state', '=', 'cancelled')]"/>
                <filter string="Status"  name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Tanggal" name="group_date"  context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_wt_delivery" model="ir.actions.act_window">
        <field name="name">Tugas Pengiriman</field>
        <field name="res_model">wt.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_delivery_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat Tugas Pengiriman Baru
            </p>
            <p>
                Klik "+ Tambah Pengiriman" untuk menambahkan Delivery Order.
                Setelah DO berstatus Siap (Ready), konfirmasi dan mulai untuk
                mengirim data ke aplikasi timbang via Pull API.
            </p>
        </field>
    </record>


</odoo>
