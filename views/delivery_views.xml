<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_wt_delivery_list" model="ir.ui.view">
        <field name="name">wt.delivery.list</field>
        <field name="model">wt.delivery</field>
        <field name="arch" type="xml">
            <list string="Delivery Task">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id" string="Customer" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="step_count" string="Steps" optional="show"/>
                <field name="picking_count" string="DO Count"/>
                <field name="total_demand_qty" string="Total Planned Qty (kg)"/>
                <field name="total_physical_qty" string="Total Delivered Qty (kg)"/>
                <field name="total_difference_qty" string="Total Difference (kg)"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state in ('confirmed','in_progress')"
                       decoration-warning="state == 'returned'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_wt_delivery_do_line_handover_form" model="ir.ui.view">
        <field name="name">wt.delivery.do.line.handover.form</field>
        <field name="model">wt.delivery.do.line</field>
        <field name="arch" type="xml">
            <form string="Document Information">
                <sheet>
                    <group>
                        <group string="Expedition">
                            <field name="driver_name"/>
                            <field name="vehicle_plate"/>
                            <field name="tare_qty"/>
                            <field name="handover_date"/>
                            <field name="actual_physical_qty" readonly="1"/>
                            <field name="gross_qty" readonly="1"/>
                        </group>
                        <group string="Delivery Letter">
                            <field name="delivery_letter_no"/>
                            <field name="delivery_letter_date"/>
                            <field name="so_number"/>
                            <field name="document_do_number"/>
                            <field name="receiver_name"/>
                            <field name="receiver_address"/>
                        </group>
                    </group>
                    <group>
                        <group string="Despatch Slip">
                            <field name="despatch_slip_no"/>
                        </group>
                        <group/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_wt_delivery_form" model="ir.ui.view">
        <field name="name">wt.delivery.form</field>
        <field name="model">wt.delivery</field>
        <field name="arch" type="xml">
            <form string="Delivery Task">
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel"
                             string="Cancel"
                             type="object"
                             class="btn-danger"
                             invisible="state in ('done','returned','cancelled')"
                             confirm="Are you sure you want to cancel this delivery task?"/>
                    <button name="action_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <button name="action_return_delivery"
                            string="Return Delivery"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'done' or wt_is_returned"
                            confirm="Are you sure you want to return all delivered goods from this delivery task? Applied shrinkage remains valid and will not be reversed."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done,returned"/>
                </header>
                <sheet>
                    <field name="wt_is_returned" invisible="1"/>
                    <widget name="web_ribbon" title="Returned" bg_color="bg-danger"
                            invisible="not wt_is_returned"/>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <!-- Smart button DO: muncul setelah done (picking dari do_lines) -->
                        <button name="action_view_pickings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Created DO"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state not in ('draft', 'confirmed')" required="1"/>
                            <field name="route_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"
                                   required="1"/>
                            <field name="product_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_demand_qty" readonly="1"/>
                            <field name="total_physical_qty" readonly="1"/>
                            <field name="total_difference_qty" readonly="1"/>
                        </group>
                    </group>

                    <!-- Banner Retur -->
                    <div class="alert alert-danger d-flex align-items-center" role="alert"
                         invisible="not wt_is_returned">
                        <i class="fa fa-undo me-2" style="font-size: 1.5em;"/>
                        <div>
                            <strong>This delivery has been returned for the following reason:</strong>
                            <br/>
                            <field name="wt_return_reason" readonly="1" class="font-weight-bold"/>
                        </div>
                    </div>

                    <field name="wt_has_unpulled_lines" invisible="1"/>


                    <notebook>

                        <!-- Tab 2: Route -->
                        <page string="Route">

                            <!-- ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ SECTION A: Rencana DO (hanya saat Draft & Confirmed) ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ -->
                            <!-- Tabel Rencana DO (satu field, perilaku berubah berdasarkan state) -->
                            <field name="do_line_ids"
                                   readonly="state not in ('confirmed', 'in_progress')"
                                   context="{'default_delivery_id': id, 'default_company_id': company_id, 'default_route_id': route_id, 'default_partner_id': partner_id}">
                                <list string="Delivery Plan"
                                      create="false"
                                      delete="false">
                                    <field name="sequence" widget="handle"/>
                                    <field name="route_id" column_invisible="1"/>
                                    <field name="route_line_id" column_invisible="1"/>
                                    <field name="route_type" string="Route Type" optional="show"/>
                                    <field name="picking_type_id"
                                           options="{'no_create': True, 'no_open': True}"
                                           string="Operation Type"/>
                                    <field name="product_id" column_invisible="True"/>
                                    <field name="location_id"
                                           options="{'no_create': True}"
                                           string="Source Location"/>
                                    <field name="location_dest_id"
                                           options="{'no_create': True}"
                                           string="Destination Location"/>
                                    <field name="demand_qty"
                                           string="Demand (kg)"/>
                                    <field name="actual_physical_qty"
                                           string="Actual Physical Weight (kg)"
                                           optional="show"
                                           readonly="1"/>
                                    <field name="partner_id"
                                           options="{'no_create': True}"
                                           string="Receiver Contact"
                                           required="1"
                                           optional="show"/>
                                    <field name="scheduled_date"
                                           string="Scheduled Date"
                                           optional="hide"/>
                                    <!-- Kolom hasil generate ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â hanya tampil setelah done -->
                                    <field name="picking_id"
                                           string="Created DO"
                                           options="{'no_open': False}"
                                           optional="show"
                                           readonly="1"/>
                                    <field name="return_picking_id"
                                           string="Inventory Return"
                                           options="{'no_open': False}"
                                           optional="show"
                                           readonly="1"/>
                                    <field name="generated_transit_lot_id"
                                           string="Lot Transit"
                                           options="{'no_open': False}"
                                           optional="show"
                                           readonly="1"/>
                                    <field name="route_process_status"
                                           string="DO Status"
                                           widget="badge"
                                           decoration-success="route_process_status == 'done'"
                                           decoration-info="route_process_status == 'in_process'"
                                           decoration-muted="route_process_status == 'preparation'"
                                           optional="show"
                                           readonly="1"/>
                                    <field name="picking_state" column_invisible="1"/>
                                    <field name="can_validate_line" column_invisible="1"/>
                                    <button name="action_validate_line"
                                             string="Validate"
                                             type="object"
                                             icon="fa-check"
                                             class="btn-primary"
                                             invisible="not can_validate_line or parent.state not in ('confirmed', 'in_progress')"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                                <form string="Delivery Plan Detail">
                                     <header>
                                         <field name="can_validate_line" invisible="1"/>
                                         <button name="action_auto_allocate_lots"
                                                 string="Load Lots from Source Location"
                                                 type="object"
                                                 class="btn-secondary"
                                                 invisible="picking_state == 'done' or parent.state not in ('confirmed', 'in_progress')"
                                                 confirm="Existing lot details will be replaced based on available stock in the source location and all child locations. Continue?"/>
                                         <button name="action_validate_line"
                                                 string="Validate Delivery Plan"
                                                 type="object"
                                                 class="btn-primary"
                                                 invisible="not can_validate_line or parent.state not in ('confirmed', 'in_progress')"/>
                                         <button name="action_print_despatch_slip"
                                                 string="Print Despatch Slip"
                                                 type="object"
                                                 class="btn-secondary"
                                                 invisible="picking_state != 'done'"/>
                                         <button name="action_print_handover_report"
                                                 string="Print Handover Report"
                                                 type="object"
                                                 class="btn-secondary"
                                                 invisible="picking_state != 'done'"/>
                                         <button name="action_print_seal_layout"
                                                 string="Print Seal Layout"
                                                 type="object"
                                                 class="btn-secondary"
                                                 invisible="picking_state != 'done'"/>
                                         <button name="action_print_surat_jalan"
                                                 string="Print Delivery Letter"
                                                 type="object"
                                                 class="btn-secondary"
                                                 invisible="picking_state != 'done'"/>
                                         <button name="action_open_handover_details"
                                                 string="Edit Document Information"
                                                 type="object"
                                                 class="btn-secondary"
                                                 invisible="picking_state != 'done'"/>
                                         <field name="picking_state" widget="statusbar" statusbar_visible="assigned,done" invisible="not picking_id"/>
                                     </header>
                                    <sheet>
                                         <field name="picking_state" invisible="1"/>
                                         <field name="picking_id" invisible="1"/>
                                         <group>
                                             <group string="Route &amp; Date">
                                                <field name="route_id" invisible="1" force_save="1"/>
                                                <field name="route_line_id" invisible="1" force_save="1"/>
                                                <field name="route_type" readonly="1"/>
                                                <field name="route_process_status" readonly="1" widget="badge"
                                                       decoration-success="route_process_status == 'done'"
                                                       decoration-info="route_process_status == 'in_process'"
                                                       decoration-muted="route_process_status == 'preparation'"/>
                                                <field name="picking_type_id"
                                                       options="{'no_create': True, 'no_open': True}"
                                                       readonly="1"
                                                       force_save="1"/>
                                                <field name="product_id" invisible="1" force_save="1"/>
                                                <field name="location_id"
                                                       options="{'no_create': True}"
                                                       readonly="1"
                                                       force_save="1"/>
                                                <field name="location_dest_id"
                                                       options="{'no_create': True}"
                                                       readonly="1"
                                                       force_save="1"/>
                                                <field name="partner_id"
                                                       string="Receiver"
                                                       options="{'no_create': True}"
                                                       required="1"
                                                       readonly="picking_state == 'done'"/>
                                                <field name="scheduled_date"
                                                       readonly="picking_state == 'done'"/>
                                            </group>
                                            <group string="Stock Information">
                                                <field name="demand_qty" force_save="1"
                                                       string="Demand (kg)"
                                                       readonly="picking_state == 'done'"/>
                                                <field name="actual_physical_qty"
                                                       string="Actual Physical Weight (kg)"
                                                       readonly="1"/>
                                                <field name="generated_transit_lot_id"
                                                       string="Transit Lot"
                                                       readonly="1"
                                                       options="{'no_open': False}"
                                                       invisible="not generated_transit_lot_id"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Lot Details">
                                                <field name="lot_line_ids" context="{'default_do_line_id': id}"
                                                       readonly="picking_state == 'done'">
                                                    <list string="Lot Details" editable="bottom">
                                                        <field name="lot_id" options="{'no_create': True}" domain="[('product_id', '=', product_id), ('quant_ids.location_id', 'child_of', parent.location_id), ('quant_ids.quantity', '&gt;', 0)]" context="{'location_id': parent.location_id, 'default_product_id': product_id}"/>
                                                        <field name="location_id" readonly="1" string="Location"/>
                                                        <field name="allowed_weighing_location_ids" column_invisible="1"/>
                                                        <field name="weighing_location_id" options="{'no_create': True}" string="Weighing Location"/>
                                                        <field name="operator_id" readonly="1" string="Operator"/>
                                                        <field name="wt_qty_on_hand" readonly="1" string="Physical Stock (kg)"/>
                                                        <field name="wt_qty_reserved" readonly="1" string="Reserved (kg)"/>
                                                        <field name="qty_available" readonly="1" string="Available Stock (kg)"/>
                                                        <field name="qty" string="Demand (kg)"/>
                                                        <field name="wt_is_pulled" column_invisible="1"/>
                                                        <field name="wt_physical_qty" string="Physical Weight (kg)" readonly="1" optional="show"/>
                                                        <field name="wt_weighed_at" string="Weighed At" readonly="1" optional="show"/>
                                                        <field name="wt_weighing_status" string="Weighing Status" readonly="1" widget="badge"
                                                               decoration-success="wt_weighing_status == 'weighed'"
                                                               decoration-warning="wt_weighing_status == 'unweighed'"
                                                               decoration-info="wt_weighing_status == 'not_pulled'"
                                                               optional="show"/>
                                                        <field name="wt_difference_qty" string="Difference (kg)" readonly="1" optional="show"/>
                                                        <field name="wt_note" string="Notes" optional="hide"/>
                                                    </list>
                                                </field>
                                            </page>
                                            <page string="Document Information">
                                                <group>
                                                    <group string="Expedition">
                                                        <field name="driver_name"/>
                                                        <field name="vehicle_plate"/>
                                                        <field name="tare_qty"/>
                                                        <field name="handover_date"/>
                                                        <field name="actual_physical_qty" readonly="1"/>
                                                        <field name="gross_qty" readonly="1"/>
                                                    </group>
                                                    <group string="Delivery Letter">
                                                        <field name="delivery_letter_no"/>
                                                        <field name="delivery_letter_date"/>
                                                        <field name="so_number"/>
                                                        <field name="document_do_number"/>
                                                        <field name="receiver_name"/>
                                                        <field name="receiver_address"/>
                                                    </group>
                                                </group>
                                                <group>
                                                    <group string="Despatch Slip">
                                                        <field name="despatch_slip_no"/>
                                                    </group>
                                                    <group/>
                                                </group>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>

                        </page>



                        <!-- Tab 2: Detail Timbang -->
                        <page string="Weighing Details">
                            <field name="do_lot_line_ids"
                                   invisible="not do_line_ids"
                                   readonly="state in ('done','returned','cancelled')">
                                <list string="Weighing Details"
                                      create="false"
                                      delete="false"
                                      edit="false">
                                    <field name="route_id" string="Route" readonly="1"/>
                                    <field name="lot_id" readonly="1"/>
                                    <field name="location_id" readonly="1" string="Location"/>
                                    <field name="allowed_weighing_location_ids" column_invisible="1"/>
                                    <field name="weighing_location_id" options="{'no_create': True}" string="Weighing Location"/>
                                    <field name="operator_id" readonly="1" string="Operator"/>
                                    <field name="wt_is_pulled" column_invisible="1"/>
                                    <field name="wt_original_qty" string="Planned Demand (kg)" readonly="1"/>
                                    <field name="qty" string="DO Demand (kg)" readonly="1" optional="hide"/>
                                    <field name="wt_physical_qty" string="Physical Weight (kg)" readonly="1"/>
                                    <field name="wt_weighed_at" string="Weighed At" readonly="1" optional="show"/>
                                    <field name="wt_weighing_status" string="Weighing Status" readonly="1" widget="badge"
                                           decoration-success="wt_weighing_status == 'weighed'"
                                           decoration-warning="wt_weighing_status == 'unweighed'"
                                           decoration-info="wt_weighing_status == 'not_pulled'"
                                           optional="show"/>
                                    <field name="wt_difference_qty" string="Difference (kg)" readonly="1"
                                           decoration-danger="wt_difference_qty &lt; -0.001"
                                           decoration-success="wt_difference_qty &gt;= -0.001"/>
                                    <field name="wt_is_fully_allocated" column_invisible="1"/>
                                    <field name="wt_unallocated_qty" string="Unallocated"
                                           readonly="1" optional="show"
                                           decoration-danger="wt_unallocated_qty &gt; 0.001"
                                           decoration-success="wt_unallocated_qty &lt;= 0.001"/>
                                    <field name="wt_adjustment_applied" column_invisible="1"/>
                                    <button name="action_configure_allocation"
                                            string="Allocate"
                                            type="object"
                                            icon="fa-sliders"
                                            invisible="wt_difference_qty == 0.0 or wt_adjustment_applied or wt_weighing_status != 'weighed'"/>
                                    <field name="wt_note" string="Notes" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 3: Notes -->
                        <page string="Notes">
                            <group>
                                <field name="note" placeholder="Add notes here..."/>
                            </group>
                            <group string="Return Information" invisible="not wt_is_returned">
                                <field name="wt_return_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>

                    <group string="Validation Information" invisible="state not in ('done', 'returned')">
                        <field name="validated_at" readonly="1"/>
                        <field name="validated_by_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_wt_delivery_search" model="ir.ui.view">
        <field name="name">wt.delivery.search</field>
        <field name="model">wt.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <filter string="Draft"       name="draft"       domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed"   name="confirmed"   domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done"        name="done"        domain="[('state', '=', 'done')]"/>
                <filter string="Returned"    name="returned"    domain="[('state', '=', 'returned')]"/>
                <filter string="Cancelled"   name="cancelled"   domain="[('state', '=', 'cancelled')]"/>
                <filter string="Status"  name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Date" name="group_date"  context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_wt_delivery" model="ir.actions.act_window">
        <field name="name">Delivery Tasks</field>
        <field name="res_model">wt.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_delivery_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a New Delivery Task
            </p>
            <p>
                Create a delivery task, choose a route, confirm it, then manage each route line.
                Operators receive delivery lot lines from the Pull API.
            </p>
        </field>
    </record>


</odoo>
