<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_wt_delivery_list" model="ir.ui.view">
        <field name="name">wt.delivery.list</field>
        <field name="model">wt.delivery</field>
        <field name="arch" type="xml">
            <list string="Tugas Pengiriman"
                  decoration-info="state == 'draft'"
                  decoration-primary="state in ('confirmed','in_progress')"
                  decoration-success="state == 'validated'"
                  decoration-warning="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="picking_count" string="Jumlah DO"/>
                <field name="total_demand_qty" string="Total Demand (kg)"/>
                <field name="total_physical_qty" string="Total Fisik (kg)"/>
                <field name="total_difference_qty" string="Total Selisih (kg)"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state in ('confirmed','in_progress')"
                       decoration-warning="state == 'completed'"
                       decoration-success="state == 'validated'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_wt_delivery_form" model="ir.ui.view">
        <field name="name">wt.delivery.form</field>
        <field name="model">wt.delivery</field>
        <field name="arch" type="xml">
            <form string="Tugas Pengiriman">
                <header>
                    <button name="action_confirm"
                            string="Konfirmasi"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start"
                            string="Mulai"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_complete"
                            string="Selesai Timbang"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_validate"
                            string="Validasi &amp; Kirim"
                            type="object"
                            class="btn-success"
                            invisible="state != 'completed'"
                            confirm="Aksi ini akan mengupdate DO dan membuat dokumen Scrap susut secara otomatis. Lanjutkan?"/>
                    <button name="action_cancel"
                            string="Batalkan"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('validated','cancelled')"
                            confirm="Yakin ingin membatalkan tugas pengiriman ini?"/>
                    <button name="action_draft"
                            string="Set ke Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,completed,validated"/>
                </header>
                <sheet>
                    <!-- Smart Button -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="DO"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="total_demand_qty" readonly="1"/>
                            <field name="total_physical_qty" readonly="1"/>
                            <field name="total_difference_qty" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Daftar DO -->
                        <page string="Delivery Orders (DO)">
                            <div class="mb-2" invisible="state not in ('draft','confirmed')">
                                <button name="action_new_picking"
                                        string="Tambah Pengiriman"
                                        type="object"
                                        class="btn btn-secondary"
                                        icon="fa-plus"/>
                            </div>
                            <field name="picking_ids"
                                   readonly="state not in ('draft','confirmed')"
                                   context="{'default_wt_delivery_id': id, 'default_origin': name, 'default_company_id': company_id}">
                                <list string="Delivery Orders" create="false">
                                    <field name="name"/>
                                    <field name="picking_type_id" string="Tipe Operasi"/>
                                    <field name="wt_operator_id" string="Operator"/>
                                    <field name="location_id" string="Dari"/>
                                    <field name="location_dest_id" string="Ke"/>
                                    <field name="scheduled_date" string="Tgl Jadwal"/>
                                    <field name="wt_push_done" string="Push Selesai" readonly="1"
                                           widget="boolean_toggle"/>
                                    <field name="wt_push_done_at" string="Waktu Push" readonly="1"
                                           optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-warning="state == 'waiting'"
                                           decoration-primary="state == 'confirmed'"
                                           decoration-success="state in ('assigned','done')"
                                           decoration-danger="state == 'cancel'"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 2: Detail Timbang (langsung dari stock.move.line) -->
                        <page string="Detail Timbang">
                            <div class="mb-2 d-flex gap-2"
                                 invisible="not has_adjustable_lines or state not in ('in_progress', 'completed')">
                                <button name="action_apply_adjustment"
                                        string="Apply Adjustment"
                                        type="object"
                                        class="btn btn-warning"
                                        icon="fa-check-circle"
                                        confirm="Aksi ini akan mengkoreksi stok sesuai alokasi selisih yang sudah diatur. Stok lot terdampak akan disesuaikan sekarang. Lanjutkan?"/>
                            </div>
                            <field name="pulled_move_line_ids"
                                   readonly="state in ('validated','cancelled')"
                                   domain="[]"
                                   context="{'show_original_demand': state == 'validated'}">
                                <list string="Detail Timbang"
                                      editable="bottom"
                                      create="false"
                                      delete="false"
                                      decoration-danger="not wt_skip_line and wt_physical_qty == 0.0"
                                      decoration-warning="wt_difference_qty &lt; -0.001 and not wt_is_fully_allocated"
                                      decoration-success="wt_physical_qty &gt; 0.0 and (wt_difference_qty == 0.0 or wt_is_fully_allocated)">
                                    <field name="picking_id" string="DO" readonly="1" optional="show"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="lot_id" readonly="1"/>
                                    <field name="product_uom_id" readonly="1" optional="hide"/>
                                    <field name="wt_original_demand_qty" string="Demand Awal (kg)" readonly="1"
                                           optional="show"
                                           decoration-muted="wt_original_demand_qty == 0"/>
                                    <field name="quantity" string="Terkirim (kg)" readonly="1"/>
                                    <field name="wt_physical_qty" string="Berat Fisik (kg)"/>
                                    <field name="wt_difference_qty" string="Selisih (kg)" readonly="1"
                                           decoration-danger="wt_difference_qty &lt; -0.001"
                                           decoration-success="wt_difference_qty &gt;= -0.001"/>
                                    <field name="wt_is_fully_allocated" column_invisible="1"/>
                                    <field name="wt_unallocated_qty" string="Belum Teralokasi"
                                           readonly="1" optional="show"
                                           decoration-danger="wt_unallocated_qty &gt; 0.001"
                                           decoration-success="wt_unallocated_qty &lt;= 0.001"/>
                                    <button name="action_configure_allocation"
                                            string="Alokasi"
                                            type="object"
                                            icon="fa-sliders"
                                            invisible="wt_difference_qty == 0.0"/>
                                    <field name="wt_note" string="Catatan" optional="hide"/>
                                    <field name="wt_skip_line" string="Lewati" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 3: Catatan -->
                        <page string="Catatan">
                            <field name="note"/>
                        </page>
                    </notebook>

                    <group string="Informasi Validasi" invisible="state != 'validated'">
                        <field name="validated_at" readonly="1"/>
                        <field name="validated_by_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_wt_delivery_search" model="ir.ui.view">
        <field name="name">wt.delivery.search</field>
        <field name="model">wt.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <filter string="Draft"       name="draft"       domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed"   name="confirmed"   domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed"   name="completed"   domain="[('state', '=', 'completed')]"/>
                <filter string="Validated"   name="validated"   domain="[('state', '=', 'validated')]"/>
                <filter string="Cancelled"   name="cancelled"   domain="[('state', '=', 'cancelled')]"/>
                <filter string="Status"  name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Tanggal" name="group_date"  context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_wt_delivery" model="ir.actions.act_window">
        <field name="name">Tugas Pengiriman</field>
        <field name="res_model">wt.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_delivery_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat Tugas Pengiriman Baru
            </p>
            <p>
                Klik "+ Tambah Pengiriman" untuk menambahkan Delivery Order.
                Setelah DO berstatus Siap (Ready), konfirmasi dan mulai untuk
                mengirim data ke aplikasi timbang via Pull API.
            </p>
        </field>
    </record>


</odoo>
