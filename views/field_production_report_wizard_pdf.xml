<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format A3 Landscape untuk tabel lebar -->
    <record id="paperformat_field_production_report_pdf" model="report.paperformat">
        <field name="name">Field Production Report A3 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A3</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">9</field>
        <field name="margin_bottom">9</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report action PDF -->
    <record id="action_report_field_production_report_pdf" model="ir.actions.report">
        <field name="name">Laporan Produksi Field</field>
        <field name="model">wt.field.production.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_field_production_report_document</field>
        <field name="report_file">weightrack.report_field_production_report_document</field>
        <field name="paperformat_id" ref="paperformat_field_production_report_pdf"/>
        <field name="print_report_name">'Laporan Produksi Field - %s - %s' % (object.date_start, object.date_end)</field>
    </record>

    <!-- QWeb PDF Template -->
    <template id="report_field_production_report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-foreach="doc.get_date_chunks()" t-as="date_chunk">
                    <div class="page wt-fp-report">
                        <style>
                            .wt-fp-report {
                                color: #111827;
                                font-family: "Lato", sans-serif;
                                font-size: 8.5px;
                                line-height: 1.3;
                            }
                            .wt-fp-report .header-table {
                                border-collapse: collapse;
                                margin-bottom: 12px;
                                width: 100%;
                            }
                            .wt-fp-report .header-table td { border: 0; vertical-align: top; }
                            .wt-fp-report .logo { max-height: 55px; max-width: 200px; }
                            .wt-fp-report .company-name {
                                font-size: 15px; font-weight: 700; text-align: right;
                            }
                            .wt-fp-report .report-title {
                                font-size: 13px; font-weight: 700; text-align: right;
                                text-transform: uppercase; margin: 2px 0 0;
                            }
                            .wt-fp-report .info-table {
                                border-collapse: collapse;
                                margin-bottom: 10px;
                                width: 100%;
                            }
                            .wt-fp-report .info-table td {
                                border: 1px solid #cbd5e1;
                                padding: 5px 7px !important;
                                vertical-align: top;
                            }
                            .wt-fp-report .info-label {
                                background: #f3f4f6;
                                font-weight: 700;
                                width: 14%;
                                white-space: nowrap;
                            }
                            .wt-fp-report .info-value { width: 30%; }
                            .wt-fp-report .data-table {
                                border-collapse: collapse;
                                table-layout: fixed;
                                width: 100%;
                            }
                            .wt-fp-report .data-table th,
                            .wt-fp-report .data-table td {
                                border: 1px solid #9ca3af;
                                font-size: 8px;
                                line-height: 1.2;
                                padding: 4px 3px !important;
                                vertical-align: middle;
                            }
                            .wt-fp-report .data-table th {
                                background: #e5e7eb;
                                font-weight: 700;
                                text-align: center;
                            }
                            .wt-fp-report .col-no    { width: 3%; }
                            .wt-fp-report .col-div   { width: 9%; }
                            .wt-fp-report .col-field  { width: 9%; }
                            .wt-fp-report .col-clone  { width: 8%; }
                            .wt-fp-report .col-ha     { width: 5%; }
                            .wt-fp-report .col-total  { width: 9%; }
                            .wt-fp-report .text-center { text-align: center; }
                            .wt-fp-report .text-right  {
                                text-align: right; white-space: nowrap;
                            }
                            .wt-fp-report .total-row td {
                                background: #f8fafc; font-weight: 700;
                            }
                        </style>

                        <!-- Header -->
                        <table class="header-table">
                            <tr>
                                <td style="width:40%;">
                                    <t t-if="doc.company_id.logo">
                                        <img class="logo"
                                             t-att-src="image_data_uri(doc.company_id.logo)"
                                             alt="Logo"/>
                                    </t>
                                </td>
                                <td style="width:60%;">
                                    <div class="company-name" t-esc="doc.company_id.name"/>
                                    <div class="report-title">Laporan Produksi Field</div>
                                </td>
                            </tr>
                        </table>

                        <!-- Info -->
                        <table class="info-table">
                            <tr>
                                <td class="info-label">Rentang Tanggal</td>
                                <td class="info-value">
                                    <span t-esc="doc.date_start.strftime('%d/%m/%Y')"/>
                                    <span> - </span>
                                    <span t-esc="doc.date_end.strftime('%d/%m/%Y')"/>
                                </td>
                                <td class="info-label">Divisi</td>
                                <td class="info-value">
                                    <span t-esc="doc.division_id.display_name if doc.division_id else 'Semua'"/>
                                </td>
                                <td class="info-label">Total Produksi</td>
                                <td class="info-value text-right">
                                    <span t-esc="'%.2f kg' % doc.total_weight"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Data Table -->
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="col-no">No.</th>
                                    <th rowspan="2" class="col-div">Divisi</th>
                                    <th rowspan="2" class="col-field">Field</th>
                                    <th rowspan="2" class="col-clone">Clone</th>
                                    <th rowspan="2" class="col-ha">HA</th>
                                    <th t-att-colspan="len(date_chunk)">Produksi (kg)</th>
                                    <th rowspan="2" class="col-total">Total (kg)</th>
                                </tr>
                                <tr>
                                    <t t-foreach="date_chunk" t-as="dc">
                                        <th>
                                            <span t-esc="dc.production_date.strftime('%d/%m/%Y')"/>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="doc.line_ids">
                                    <t t-foreach="doc.line_ids.sorted('sequence')" t-as="line">
                                        <tr>
                                            <td class="text-center" t-esc="line.sequence"/>
                                            <td t-esc="line.division_name or '-'"/>
                                            <td t-esc="line.field_name or '-'"/>
                                            <td t-esc="line.clone or '-'"/>
                                            <td class="text-right" t-esc="'%.2f' % (line.ha or 0.0)"/>
                                            <t t-foreach="date_chunk" t-as="dc">
                                                <td class="text-right">
                                                    <span t-esc="'%.2f' % line.get_daily_weight(dc.production_date)"/>
                                                </td>
                                            </t>
                                            <td class="text-right">
                                                <span t-esc="'%.2f' % line.total_weight"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td t-att-colspan="len(date_chunk) + 6"
                                            class="text-center">
                                            Tidak ada data produksi field.
                                        </td>
                                    </tr>
                                </t>
                                <!-- Total Row -->
                                <tr class="total-row">
                                    <td colspan="5" class="text-right">Total</td>
                                    <t t-foreach="date_chunk" t-as="dc">
                                        <td class="text-right">
                                            <span t-esc="'%.2f' % dc.total_weight"/>
                                        </td>
                                    </t>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % doc.total_weight"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
