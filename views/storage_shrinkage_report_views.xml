<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_storage_shrinkage_report_form" model="ir.ui.view">
        <field name="name">wt.storage.shrinkage.report.form</field>
        <field name="model">wt.storage.shrinkage.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Susut Penyimpanan" edit="0" delete="0">
                <header>
                    <button name="action_open_filter" type="object" string="Filter" class="oe_highlight"/>
                    <button name="action_print_pdf" type="object" string="Export PDF" invisible="not is_filtered"/>
                    <button name="action_export_excel" type="object" string="Export Excel" invisible="not is_filtered"/>
                </header>
                <sheet>
                    <field name="is_filtered" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" invisible="is_filtered">
                        Silakan klik tombol Filter untuk menampilkan data laporan.
                    </div>
                    <group invisible="not is_filtered">
                        <group string="Filter">
                            <field name="company_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="warehouse_id"/>
                            <field name="division_id"/>
                        </group>
                        <group string="Total">
                            <field name="total_opening_qty"/>
                            <field name="total_stock_in_qty"/>
                            <field name="total_stock_qty"/>
                            <field name="total_shrinkage_qty"/>
                            <field name="total_balance_qty"/>
                            <field name="total_shrinkage_percentage"/>
                        </group>
                    </group>
                    <notebook invisible="not is_filtered">
                        <page string="Ringkasan Per Divisi">
                            <field name="summary_line_ids">
                                <list string="Ringkasan Susut Penyimpanan" create="0" edit="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="warehouse_name"/>
                                    <field name="division_name"/>
                                    <field name="opening_qty" sum="Total"/>
                                    <field name="stock_in_qty" sum="Total"/>
                                    <field name="stock_qty" sum="Total"/>
                                    <field name="total_qty" sum="Total"/>
                                    <field name="balance_qty" sum="Total"/>
                                    <field name="shrinkage_percentage"/>
                                </list>
                            </field>
                        </page>
                        <page string="Detail">
                            <field name="detail_line_ids">
                                <list string="Detail Susut Penyimpanan" create="0" edit="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="production_date"/>
                                    <field name="warehouse_name"/>
                                    <field name="division_name"/>
                                    <field name="lot_name"/>
                                    <field name="product_id"/>
                                    <field name="stock_qty" string="Stok" sum="Total"/>
                                    <field name="quantity" string="Qty Susut" sum="Total"/>
                                    <field name="balance_qty" sum="Total"/>
                                    <field name="shrinkage_percentage" string="% Susut"/>
                                    <field name="uom_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_storage_shrinkage_report" model="ir.actions.act_window">
        <field name="name">Laporan Susut Penyimpanan</field>
        <field name="res_model">wt.storage.shrinkage.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_storage_shrinkage_report_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <record id="view_wt_storage_shrinkage_report_wizard_form" model="ir.ui.view">
        <field name="name">wt.storage.shrinkage.report.wizard.form</field>
        <field name="model">wt.storage.shrinkage.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Laporan Susut Penyimpanan">
                <sheet>
                    <field name="report_id" invisible="1"/>
                    <group>
                        <group string="Filter">
                            <field name="company_id" required="1"/>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                            <field name="warehouse_id"/>
                            <field name="division_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_filter" type="object" string="Apply Filter" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wt_storage_shrinkage_report_wizard" model="ir.actions.act_window">
        <field name="name">Filter Laporan Susut Penyimpanan</field>
        <field name="res_model">wt.storage.shrinkage.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_storage_shrinkage_report_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
