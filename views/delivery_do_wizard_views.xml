<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW: Wizard Buat Delivery Order -->
    <record id="view_wt_delivery_do_wizard_form" model="ir.ui.view">
        <field name="name">wt.delivery.do.wizard.form</field>
        <field name="model">wt.delivery.do.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Delivery Order (DO)">
                <sheet>
                    <group>
                        <group string="Delivery Information">
                            <field name="delivery_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="picking_type_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   help="Only shows outgoing delivery operation types."/>
                            <field name="operator_id"
                                   options="{'no_create': True}"
                                   help="Choose the operator responsible for this DO."/>
                        </group>
                        <group string="Address &amp; Schedule">
                            <field name="location_id"
                                   options="{'no_create': True}"/>
                            <field name="partner_id"
                                   options="{'no_create': True}"
                                   help="Destination address that will appear on the DO form."/>
                            <field name="scheduled_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_do"
                            string="Create DO"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
