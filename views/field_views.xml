<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_field_search" model="ir.ui.view">
        <field name="name">wt.field.search</field>
        <field name="model">wt.field</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="clone"/>
                <field name="division_ids"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_wt_field_list" model="ir.ui.view">
        <field name="name">wt.field.list</field>
        <field name="model">wt.field</field>
        <field name="arch" type="xml">
            <list string="Fields" default_order="name asc">
                <field name="name"/>
                <field name="clone"/>
                <field name="ha"/>
                <field name="planting_year"/>
                <field name="division_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_wt_field_form" model="ir.ui.view">
        <field name="name">wt.field.form</field>
        <field name="model">wt.field</field>
        <field name="arch" type="xml">
            <form string="Field">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Field Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="clone"/>
                            <field name="ha"/>
                            <field name="planting_year"/>
                        </group>
                        <group>
                            <field name="division_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_field" model="ir.actions.act_window">
        <field name="name">Fields</field>
        <field name="res_model">wt.field</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_field_search"/>
    </record>
</odoo>
