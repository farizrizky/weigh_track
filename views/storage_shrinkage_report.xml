<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_storage_shrinkage_report" model="report.paperformat">
        <field name="name">Laporan Susut Penyimpanan A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_storage_shrinkage_pdf" model="ir.actions.report">
        <field name="name">Laporan Susut Penyimpanan</field>
        <field name="model">wt.storage.shrinkage.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_storage_shrinkage_document</field>
        <field name="report_file">weightrack.report_storage_shrinkage_document</field>
        <field name="paperformat_id" ref="paperformat_storage_shrinkage_report"/>
        <field name="print_report_name">'Laporan Susut Penyimpanan - %s sd %s' % (object.start_date, object.end_date)</field>
    </record>

    <template id="report_storage_shrinkage_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page wt-storage-shrinkage-report">
                    <style>
.wt-storage-shrinkage-report { color: #111827; font-family: "Lato", sans-serif; font-size: 10px; line-height: 1.35; }
                            .wt-storage-shrinkage-report .header-table { border-collapse: collapse; margin-bottom: 24px; width: 100%; }
                            .wt-storage-shrinkage-report .header-table td { vertical-align: top; }
                            .wt-storage-shrinkage-report .logo { max-height: 72px; max-width: 250px; }
                            .wt-storage-shrinkage-report .title { color: #111827; font-size: 18px; font-weight: 700; margin: 0 0 5px; text-align: right; text-transform: uppercase; }
                            .wt-storage-shrinkage-report .meta { color: #374151; text-align: right; }
                            .wt-storage-shrinkage-report .section-title { background: transparent; border-bottom: 1px solid #cbd5e1; color: inherit; font-size: 10px; font-weight: 700; margin-top: 14px; padding: 0 0 5px; text-transform: uppercase; }
                            .wt-storage-shrinkage-report .info-table { border: 1px solid #cbd5e1; border-collapse: collapse; margin-bottom: 12px; width: 100%; }
                            .wt-storage-shrinkage-report .info-table td { border: 1px solid #cbd5e1; font-size: 10px; padding: 8px 10px !important; vertical-align: top; }
                            .wt-storage-shrinkage-report .info-label { background: #f3f4f6; font-weight: 700; width: 18%; }
                            .wt-storage-shrinkage-report .info-value { width: 32%; }
                            .wt-storage-shrinkage-report .data-table { border-collapse: collapse; table-layout: fixed; width: 100%; }
                            .wt-storage-shrinkage-report .data-table th { background: #f3f4f6; border: 1px solid #9ca3af; font-size: 8px; font-weight: 700; line-height: 1.25; padding: 5px 4px !important; text-align: center; vertical-align: middle; }
                            .wt-storage-shrinkage-report .data-table td { border: 1px solid #cbd5e1; font-size: 8px; line-height: 1.25; padding: 5px 4px !important; vertical-align: middle; word-break: break-word; }
                            .wt-storage-shrinkage-report .total-row td { background: #f9fafb; font-weight: 700; }
                            .wt-storage-shrinkage-report .text-center { text-align: center; }
                            .wt-storage-shrinkage-report .text-right { padding-right: 10px !important; text-align: right; white-space: nowrap; }
                            .wt-storage-shrinkage-report .muted { color: #6b7280; }
                    </style>

                        <table class="header-table">
                            <tr>
                                <td style="width: 40%;">
                                    <t t-if="doc.company_id.logo">
                                        <img class="logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                                    </t>
                                    <t t-else=""><strong t-esc="doc.company_id.name"/></t>
                                </td>
                                <td style="width: 60%;">
                                    <h2 class="title">Laporan Susut Penyimpanan</h2>
                                    <div class="meta">
                                        <div><strong>Tanggal Cetak:</strong> <span t-esc="time.strftime('%d/%m/%Y')"/></div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <table class="info-table">
                            <tr>
                                <td class="info-label">Perusahaan</td>
                                <td class="info-value" t-esc="doc.company_id.name"/>
                                <td class="info-label">Gudang</td>
                                <td class="info-value" t-esc="doc.warehouse_id.display_name if doc.warehouse_id else 'Semua Gudang'"/>
                            </tr>
                            <tr>
                                <td class="info-label">Tanggal Dari</td>
                                <td class="info-value"><span t-field="doc.start_date"/></td>
                                <td class="info-label">Divisi</td>
                                <td class="info-value" t-esc="doc.division_id.display_name if doc.division_id else 'Semua Divisi'"/>
                            </tr>
                            <tr>
                                <td class="info-label">Tanggal Sampai</td>
                                <td class="info-value"><span t-field="doc.end_date"/></td>
                                <td class="info-label">Lokasi Susut</td>
                                <td class="info-value">Inventory Loss / Susut</td>
                            </tr>
                        </table>

                        <div class="section-title">Ringkasan Per Divisi</div>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>No</th><th>Gudang</th><th>Divisi</th>
                                    <th>Stok Awal</th><th>Stok Masuk</th><th>Stok Tersedia</th>
                                    <th>Total Susut</th><th>Saldo Akhir</th><th>% Susut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="doc.summary_line_ids">
                                    <t t-foreach="doc.summary_line_ids" t-as="line">
                                        <tr>
                                            <td class="text-center" t-esc="line.sequence"/>
                                            <td t-esc="line.warehouse_name"/>
                                            <td t-esc="line.division_name"/>
                                            <td class="text-right" t-esc="'%.2f' % (line.opening_qty or 0.0)"/>
                                            <td class="text-right" t-esc="'%.2f' % (line.stock_in_qty or 0.0)"/>
                                            <td class="text-right" t-esc="'%.2f' % (line.stock_qty or 0.0)"/>
                                            <td class="text-right" t-esc="'%.2f' % (line.total_qty or 0.0)"/>
                                            <td class="text-right" t-esc="'%.2f' % (line.balance_qty or 0.0)"/>
                                            <td class="text-right" t-esc="line.shrinkage_percentage or '0.00%'"/>
                                        </tr>
                                    </t>
                                    <tr class="total-row">
                                        <td colspan="3" class="text-right">Total</td>
                                        <td class="text-right" t-esc="'%.2f' % (doc.total_opening_qty or 0.0)"/>
                                        <td class="text-right" t-esc="'%.2f' % (doc.total_stock_in_qty or 0.0)"/>
                                        <td class="text-right" t-esc="'%.2f' % (doc.total_stock_qty or 0.0)"/>
                                        <td class="text-right" t-esc="'%.2f' % (doc.total_shrinkage_qty or 0.0)"/>
                                        <td class="text-right" t-esc="'%.2f' % (doc.total_balance_qty or 0.0)"/>
                                        <td class="text-right" t-esc="doc.total_shrinkage_percentage or '0.00%'"/>
                                    </tr>
                                </t>
                                <tr t-if="not doc.summary_line_ids">
                                    <td colspan="9" class="text-center muted">Tidak ada data pada filter ini.</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="section-title">Detail Pergerakan Susut</div>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>No</th><th>Tanggal Produksi</th><th>Gudang</th><th>Divisi</th>
                                    <th>Lot</th><th>Produk</th><th>Stok</th><th>Qty Susut</th>
                                    <th>Saldo Akhir</th><th>% Susut</th><th>Sat.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="doc.detail_line_ids">
                                    <t t-foreach="doc.detail_line_ids" t-as="line">
                                        <tr>
                                            <td class="text-center" t-esc="line.sequence"/>
                                            <td><span t-field="line.production_date"/></td>
                                            <td t-esc="line.warehouse_name"/>
                                            <td t-esc="line.division_name"/>
                                            <td t-esc="line.lot_name"/>
                                            <td t-esc="line.product_id.display_name"/>
                                            <td class="text-right" t-esc="'%.2f' % (line.stock_qty or 0.0)"/>
                                            <td class="text-right" t-esc="'%.2f' % (line.quantity or 0.0)"/>
                                            <td class="text-right" t-esc="'%.2f' % (line.balance_qty or 0.0)"/>
                                            <td class="text-right"><span t-esc="line.shrinkage_percentage or '0.00%'"/></td>
                                            <td class="text-center" t-esc="line.uom_name or ''"/>
                                        </tr>
                                    </t>
                                    <tr class="total-row">
                                        <td colspan="6" class="text-right">Total</td>
                                        <td class="text-right" t-esc="'%.2f' % (doc.total_stock_qty or 0.0)"/>
                                        <td class="text-right" t-esc="'%.2f' % (doc.total_shrinkage_qty or 0.0)"/>
                                        <td class="text-right" t-esc="'%.2f' % (doc.total_balance_qty or 0.0)"/>
                                        <td class="text-right"><span t-esc="doc.total_shrinkage_percentage or '0.00%'"/></td>
                                        <td/>
                                    </tr>
                                </t>
                                <tr t-if="not doc.detail_line_ids">
                                    <td colspan="11" class="text-center muted">Tidak ada detail susut pada filter ini.</td>
                                </tr>
                            </tbody>
                        </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
