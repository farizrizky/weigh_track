<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_kpi_budget_target_report_form" model="ir.ui.view">
        <field name="name">wt.kpi.budget.target.report.form</field>
        <field name="model">wt.kpi.budget.target.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Budget Target" edit="0" delete="0">
                <header>
                    <button name="action_open_filter"
                            type="object"
                            string="Filter"
                            class="oe_highlight"/>
                    <button name="action_export_excel"
                            type="object"
                            string="Export Excel"
                            invisible="not is_filtered"/>
                </header>
                <sheet>
                    <field name="is_filtered" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" role="status" invisible="is_filtered">
                        Klik tombol Filter untuk memilih tahun Budget Target Valid.
                    </div>
                    <group invisible="not is_filtered">
                        <group string="Filter">
                            <field name="company_id"/>
                            <field name="year" invisible="1"/>
                            <field name="year_display"/>
                            <field name="budget_target_id" invisible="0"/>
                        </group>
                    </group>
                    <field name="preview_html"
                           widget="html"
                           nolabel="1"
                           readonly="1"
                           invisible="not is_filtered"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_kpi_budget_target_report" model="ir.actions.act_window">
        <field name="name">Laporan Budget Target</field>
        <field name="res_model">wt.kpi.budget.target.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_kpi_budget_target_report_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <record id="view_wt_kpi_budget_target_report_wizard_form" model="ir.ui.view">
        <field name="name">wt.kpi.budget.target.report.wizard.form</field>
        <field name="model">wt.kpi.budget.target.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Laporan Budget Target">
                <sheet>
                    <field name="report_id" invisible="1"/>
                    <group>
                        <group string="Filter">
                            <field name="company_id" required="1"/>
                            <field name="year" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_filter"
                            type="object"
                            string="Terapkan Filter"
                            class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
