<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_delivery_manual_weighing_wizard_form" model="ir.ui.view">
        <field name="name">wt.delivery.manual.weighing.wizard.form</field>
        <field name="model">wt.delivery.manual.weighing.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual Delivery Weighing">
                <sheet>
                    <group>
                        <group>
                            <field name="delivery_id"/>
                            <field name="effective_date"/>
                        </group>
                        <group>
                            <field name="reason" placeholder="Explain why the weighing data is entered manually..."/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        Manual input only applies to unweighed lots. A reason is required, and the weighing time must use the Delivery Effective Date.
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="selected"/>
                            <field name="do_lot_line_id" column_invisible="1" force_save="1"/>
                            <field name="do_line_id" readonly="1"/>
                            <field name="lot_id" readonly="1"/>
                            <field name="demand_qty" readonly="1"/>
                            <field name="allowed_weighing_location_ids" column_invisible="1"/>
                            <field name="weighing_location_id" options="{'no_create': True}"/>
                            <field name="operator_id" readonly="1"/>
                            <field name="physical_qty"/>
                            <field name="weighed_at"/>
                            <field name="note" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply"
                            string="Apply Manual Weighing"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
