<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_stock_out_report_form" model="ir.ui.view">
        <field name="name">wt.stock.out.report.form</field>
        <field name="model">wt.stock.out.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Stock Keluar" edit="0" delete="0">
                <header>
                    <button name="action_open_filter" type="object" string="Filter" class="oe_highlight"/>
                    <button name="action_print_pdf" type="object" string="Export PDF" invisible="not is_filtered"/>
                    <button name="action_export_excel" type="object" string="Export Excel" invisible="not is_filtered"/>
                </header>
                <sheet>
                    <field name="is_filtered" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" invisible="is_filtered">
                        Silakan klik tombol Filter untuk menampilkan data laporan.
                    </div>
                    <group invisible="not is_filtered">
                        <group string="Filter">
                            <field name="company_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="warehouse_id"/>
                            <field name="division_id"/>
                        </group>
                        <group string="Total">
                            <field name="total_quantity"/>
                            <field name="total_storage_shrinkage_qty"/>
                            <field name="total_transfer_shrinkage_qty"/>
                            <field name="total_shipping_qty"/>
                        </group>
                    </group>
                    <notebook invisible="not is_filtered">
                        <page string="Stock Keluar Per Gudang dan Divisi">
                            <field name="summary_line_ids">
                                <list string="Ringkasan Stock Keluar" create="0" edit="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="warehouse_name"/>
                                    <field name="division_name"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="storage_shrinkage_qty" sum="Total"/>
                                    <field name="transfer_shrinkage_qty" sum="Total"/>
                                    <field name="shipping_qty" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Detail">
                            <field name="detail_line_ids">
                                <list string="Detail Stock Keluar" create="0" edit="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="movement_date"/>
                                    <field name="source_document"/>
                                    <field name="warehouse_name"/>
                                    <field name="division_name"/>
                                    <field name="lot_name"/>
                                    <field name="category_label"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="uom_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_stock_out_report" model="ir.actions.act_window">
        <field name="name">Laporan Stock Keluar</field>
        <field name="res_model">wt.stock.out.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_stock_out_report_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <record id="view_wt_stock_out_report_wizard_form" model="ir.ui.view">
        <field name="name">wt.stock.out.report.wizard.form</field>
        <field name="model">wt.stock.out.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Laporan Stock Keluar">
                <sheet>
                    <field name="report_id" invisible="1"/>
                    <group>
                        <group string="Filter">
                            <field name="company_id" required="1"/>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                            <field name="warehouse_id"/>
                            <field name="division_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_filter" type="object" string="Apply Filter" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wt_stock_out_report_wizard" model="ir.actions.act_window">
        <field name="name">Filter Laporan Stock Keluar</field>
        <field name="res_model">wt.stock.out.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_stock_out_report_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
