<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== FORM VIEW: Report ===== -->
    <record id="view_wt_field_production_report_form" model="ir.ui.view">
        <field name="name">wt.field.production.report.form</field>
        <field name="model">wt.field.production.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Produksi Field" edit="0" delete="0">
                <header>
                    <button name="action_open_filter"
                        type="object"
                        string="Filter"
                        class="oe_highlight"/>
                    <button name="action_print_pdf"
                        type="object"
                        string="Export PDF"
                        invisible="not is_filtered"/>
                    <button name="action_export_excel"
                        type="object"
                        string="Export Excel"
                        invisible="not is_filtered"/>
                </header>
                <sheet>
                    <field name="is_filtered" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-info" role="status" invisible="is_filtered">
                        Klik <strong>Filter</strong> untuk memilih rentang tanggal dan divisi.
                    </div>

                    <group invisible="not is_filtered">
                        <group string="Filter">
                            <field name="company_id"/>
                            <field name="date_start" string="Dari Tanggal"/>
                            <field name="date_end" string="Sampai Tanggal"/>
                        </group>
                        <group>
                            <field name="division_id" string="Divisi"/>
                            <field name="total_weight" string="Total Produksi (kg)"/>
                        </group>
                    </group>

                    <field name="preview_html"
                        widget="html"
                        nolabel="1"
                        readonly="1"
                        invisible="not is_filtered"/>

                    <field name="date_column_ids" invisible="1"/>
                    <field name="line_ids" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===== ACTION: Report ===== -->
    <record id="action_wt_field_production_report" model="ir.actions.act_window">
        <field name="name">Laporan Produksi Field</field>
        <field name="res_model">wt.field.production.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_field_production_report_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <!-- ===== FORM VIEW: Wizard Filter ===== -->
    <record id="view_wt_field_production_report_wizard_form" model="ir.ui.view">
        <field name="name">wt.field.production.report.wizard.form</field>
        <field name="model">wt.field.production.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Laporan Produksi Field">
                <sheet>
                    <field name="report_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group string="Filter">
                            <field name="date_start" required="1"/>
                            <field name="date_end" required="1"/>
                            <field name="division_id"
                                placeholder="Kosongkan untuk semua divisi"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_filter"
                        type="object"
                        string="Terapkan Filter"
                        class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
