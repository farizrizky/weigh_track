<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_delivery_customer_correction_wizard_form" model="ir.ui.view">
        <field name="name">wt.delivery.customer.correction.wizard.form</field>
        <field name="model">wt.delivery.customer.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Koreksi Customer">
                <sheet>
                    <group>
                        <field name="delivery_id" invisible="1"/>
                        <field name="current_partner_id" readonly="1" string="Customer Saat Ini"/>
                        <field name="new_partner_id"
                               string="Customer Baru"
                               options="{'no_create': True}"
                               placeholder="Pilih customer baru..."/>
                        <field name="reason"
                               string="Alasan Koreksi"
                               placeholder="Jelaskan alasan perubahan customer..."/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        <strong>Perhatian:</strong> Perubahan customer akan memperbarui data pengiriman ini
                        dan semua baris rencana DO yang belum selesai (Done).
                        Perubahan akan dicatat di log aktivitas.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply"
                            string="Terapkan Koreksi"
                            type="object"
                            class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
