<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_weighing_reject_slab_report" model="report.paperformat">
        <field name="name">Weighing Reject Slab Report A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_weighing_reject_slab_pdf" model="ir.actions.report">
        <field name="name">Laporan Reject dan Slab</field>
        <field name="model">wt.weighing.reject.slab.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_weighing_reject_slab_doc</field>
        <field name="report_file">weightrack.report_weighing_reject_slab_doc</field>
        <field name="paperformat_id" ref="paperformat_weighing_reject_slab_report"/>
        <field name="print_report_name">'Laporan Reject dan Slab - %s sd %s' % (object.start_date, object.end_date)</field>
    </record>

    <template id="report_weighing_reject_slab_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page wt-weighing-reject-slab-report">
                    <style>
                        .wt-weighing-reject-slab-report {
                            color: #111;
                            font-family: "Times New Roman", Times, serif;
                            font-size: 10px;
                        }
                        .wt-weighing-reject-slab-report .header-table {
                            border-collapse: collapse;
                            margin-bottom: 15px;
                            width: 100%;
                        }
                        .wt-weighing-reject-slab-report .logo-cell {
                            vertical-align: top;
                            width: 20%;
                        }
                        .wt-weighing-reject-slab-report .logo {
                            max-height: 55px;
                            max-width: 150px;
                        }
                        .wt-weighing-reject-slab-report .title-cell {
                            text-align: center;
                            vertical-align: top;
                            width: 60%;
                        }
                        .wt-weighing-reject-slab-report .company-title {
                            font-size: 16px;
                            font-weight: 700;
                            line-height: 1.15;
                            text-transform: uppercase;
                        }
                        .wt-weighing-reject-slab-report .report-title {
                            font-size: 16px;
                            font-weight: 700;
                            line-height: 1.15;
                            text-transform: uppercase;
                        }
                        .wt-weighing-reject-slab-report .title-line {
                            font-family: "Courier New", monospace;
                            font-size: 14px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            line-height: 1;
                        }
                        .wt-weighing-reject-slab-report .meta-table {
                            border-collapse: collapse;
                            margin-bottom: 15px;
                            width: 70%;
                        }
                        .wt-weighing-reject-slab-report .meta-table td {
                            font-size: 11px;
                            line-height: 1.3;
                            padding: 1px 4px;
                        }
                        .wt-weighing-reject-slab-report .meta-label {
                            width: 130px;
                            font-weight: bold;
                        }
                        .wt-weighing-reject-slab-report .meta-separator {
                            text-align: center;
                            width: 10px;
                        }
                        .wt-weighing-reject-slab-report .meta-value {
                            min-width: 200px;
                        }
                        .wt-weighing-reject-slab-report .data-table {
                            border-collapse: collapse;
                            width: 100%;
                        }
                        .wt-weighing-reject-slab-report .data-table th,
                        .wt-weighing-reject-slab-report .data-table td {
                            border: 1px solid #111;
                            font-size: 9px;
                            line-height: 1.3;
                            padding: 4px 5px;
                            vertical-align: middle;
                        }
                        .wt-weighing-reject-slab-report .data-table th {
                            font-size: 9.5px;
                            font-weight: 700;
                            text-align: center;
                            background-color: #f2f2f2;
                        }
                        .wt-weighing-reject-slab-report .text-center {
                            text-align: center;
                        }
                        .wt-weighing-reject-slab-report .text-right {
                            text-align: right;
                            padding-right: 6px !important;
                            white-space: nowrap;
                        }
                        .wt-weighing-reject-slab-report .total-row td {
                            font-weight: 700;
                            background-color: #f9f9f9;
                        }
                    </style>

                    <table class="header-table">
                        <tr>
                            <td class="logo-cell">
                                <t t-if="doc.company_id.logo">
                                    <img class="logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <strong t-esc="doc.company_id.name"/>
                                </t>
                            </td>
                            <td class="title-cell">
                                <div class="company-title" t-esc="doc.company_id.name"/>
                                <div class="report-title">Laporan Reject dan Slab</div>
                                <div class="title-line">========================================</div>
                            </td>
                            <td style="width: 20%;"></td>
                        </tr>
                    </table>

                    <table class="meta-table">
                        <tr>
                            <td class="meta-label">Rentang Tanggal</td>
                            <td class="meta-separator">:</td>
                            <td class="meta-value">
                                <span t-esc="doc.start_date"/> s/d <span t-esc="doc.end_date"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="meta-label">Estate</td>
                            <td class="meta-separator">:</td>
                            <td class="meta-value">
                                <span t-if="doc.estate_id" t-esc="doc.estate_id.name"/>
                                <span t-else="">-</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="meta-label">Divisi</td>
                            <td class="meta-separator">:</td>
                            <td class="meta-value">
                                <span t-if="doc.division_id" t-esc="doc.division_id.name"/>
                                <span t-else="">Semua Divisi</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="meta-label">Mandor</td>
                            <td class="meta-separator">:</td>
                            <td class="meta-value">
                                <span t-if="doc.foreman_id" t-esc="doc.foreman_id.name"/>
                                <span t-else="">Semua Mandor</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="meta-label">Tapper</td>
                            <td class="meta-separator">:</td>
                            <td class="meta-value">
                                <span t-if="doc.tapper_id" t-esc="doc.tapper_id.name"/>
                                <span t-else="">Semua Tapper</span>
                            </td>
                        </tr>
                    </table>

                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">No</th>
                                <th style="width: 20%;">Estate</th>
                                <th style="width: 20%;">Divisi</th>
                                <th style="width: 25%;">Mandor</th>
                                <th style="width: 30%;">Tapper</th>
                                <th style="width: 15%;">Total Reject</th>
                                <th style="width: 15%;">Total Slab</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="doc.line_ids">
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center" t-esc="line.sequence"/>
                                        <td><span t-esc="line.estate_name"/></td>
                                        <td><span t-esc="line.division_name"/></td>
                                        <td><span t-esc="line.foreman_name"/></td>
                                        <td><span t-esc="line.tapper_name"/></td>
                                        <td class="text-right"><span t-esc="'%.2f' % line.total_reject"/></td>
                                        <td class="text-right"><span t-esc="'%.2f' % line.total_slab"/></td>
                                    </tr>
                                </t>
                                <tr class="total-row">
                                    <td colspan="5" class="text-center">Total</td>
                                    <td class="text-right"><span t-esc="'%.2f' % doc.total_reject_weight"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % doc.total_slab_weight"/></td>
                                </tr>
                            </t>
                            <tr t-if="not doc.line_ids">
                                <td colspan="7" class="text-center">Tidak ada data penimbangan reject dan slab pada periode ini.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
