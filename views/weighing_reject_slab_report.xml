<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_weighing_reject_slab_report" model="report.paperformat">
        <field name="name">Weighing Reject Slab Report A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_weighing_reject_slab_pdf" model="ir.actions.report">
        <field name="name">Laporan Reject dan Slab</field>
        <field name="model">wt.weighing.reject.slab.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_weighing_reject_slab_doc</field>
        <field name="report_file">weightrack.report_weighing_reject_slab_doc</field>
        <field name="paperformat_id" ref="paperformat_weighing_reject_slab_report"/>
        <field name="print_report_name">'Laporan Reject dan Slab - %s sd %s' % (object.start_date, object.end_date)</field>
    </record>

    <template id="report_weighing_reject_slab_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page wt-weighing-reject-slab-report">
                    <style>
                        .wt-weighing-reject-slab-report {
                            color: #111827;
                            font-family: Arial, sans-serif;
                            font-size: 10px;
                            line-height: 1.35;
                        }
                        .wt-weighing-reject-slab-report .header-table {
                            border-collapse: collapse;
                            margin-bottom: 14px;
                            width: 100%;
                        }
                        .wt-weighing-reject-slab-report .header-table td {
                            vertical-align: top;
                        }
                        .wt-weighing-reject-slab-report .logo {
                            max-height: 72px;
                            max-width: 250px;
                        }
                        .wt-weighing-reject-slab-report .title {
                            color: #111827;
                            font-size: 18px;
                            font-weight: 700;
                            margin: 0 0 5px;
                            text-align: right;
                            text-transform: uppercase;
                        }
                        .wt-weighing-reject-slab-report .meta {
                            color: #374151;
                            text-align: right;
                        }
                        .wt-weighing-reject-slab-report .section-title {
                            background: #111827;
                            color: #fff;
                            font-size: 10px;
                            font-weight: 700;
                            margin-top: 10px;
                            padding: 7px 10px;
                            text-transform: uppercase;
                        }
                        .wt-weighing-reject-slab-report .info-table {
                            border: 1px solid #cbd5e1;
                            border-collapse: collapse;
                            margin-bottom: 12px;
                            width: 100%;
                        }
                        .wt-weighing-reject-slab-report .info-table td {
                            border: 1px solid #cbd5e1;
                            font-size: 10px;
                            padding: 8px 10px !important;
                            vertical-align: top;
                        }
                        .wt-weighing-reject-slab-report .info-label {
                            background: #f3f4f6;
                            font-weight: bold;
                            width: 18%;
                        }
                        .wt-weighing-reject-slab-report .info-value {
                            width: 32%;
                        }
                        .wt-weighing-reject-slab-report .data-table {
                            border-collapse: collapse;
                            width: 100%;
                        }
                        .wt-weighing-reject-slab-report .data-table th,
                        .wt-weighing-reject-slab-report .data-table td {
                            border: 1px solid #cbd5e1;
                            font-size: 10px;
                            line-height: 1.35;
                            padding: 8px 10px !important;
                            vertical-align: middle;
                        }
                        .wt-weighing-reject-slab-report .data-table th {
                            border: 1px solid #9ca3af;
                            font-size: 10px;
                            font-weight: 700;
                            text-align: center;
                            background: #f3f4f6;
                        }
                        .wt-weighing-reject-slab-report .text-center {
                            text-align: center;
                        }
                        .wt-weighing-reject-slab-report .text-right {
                            text-align: right;
                            padding-right: 10px !important;
                            white-space: nowrap;
                        }
                        .wt-weighing-reject-slab-report .total-row td {
                            font-weight: 700;
                            background: #f9fafb;
                        }
                    </style>

                    <table class="header-table">
                        <tr>
                            <td style="width: 40%;">
                                <t t-if="doc.company_id.logo">
                                    <img class="logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <strong t-esc="doc.company_id.name"/>
                                </t>
                            </td>
                            <td style="width: 60%;">
                                <h2 class="title">Laporan Reject dan Slab</h2>
                                <div class="meta">
                                    <div><strong>Tanggal Cetak:</strong> <span t-esc="time.strftime('%d/%m/%Y')"/></div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="info-table">
                        <tr>
                            <td class="info-label">Perusahaan</td>
                            <td class="info-value" t-esc="doc.company_id.name"/>
                            <td class="info-label">Rentang Tanggal</td>
                            <td class="info-value">
                                <span t-esc="doc.start_date"/> s/d <span t-esc="doc.end_date"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="info-label">Estate</td>
                            <td class="info-value">
                                <span t-if="doc.estate_id" t-esc="doc.estate_id.name"/>
                                <span t-else="">-</span>
                            </td>
                            <td class="info-label">Divisi</td>
                            <td class="info-value">
                                <span t-if="doc.division_id" t-esc="doc.division_id.name"/>
                                <span t-else="">Semua Divisi</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="info-label">Mandor</td>
                            <td class="info-value">
                                <span t-if="doc.foreman_id" t-esc="doc.foreman_id.name"/>
                                <span t-else="">Semua Mandor</span>
                            </td>
                            <td class="info-label">Tapper</td>
                            <td class="info-value">
                                <span t-if="doc.tapper_id" t-esc="doc.tapper_id.name"/>
                                <span t-else="">Semua Tapper</span>
                            </td>
                        </tr>
                    </table>

                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">No</th>
                                <th style="width: 20%;">Estate</th>
                                <th style="width: 20%;">Divisi</th>
                                <th style="width: 25%;">Mandor</th>
                                <th style="width: 30%;">Tapper</th>
                                <th style="width: 15%;">Total Reject</th>
                                <th style="width: 15%;">Total Slab</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="doc.line_ids">
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center" t-esc="line.sequence"/>
                                        <td><span t-esc="line.estate_name"/></td>
                                        <td><span t-esc="line.division_name"/></td>
                                        <td><span t-esc="line.foreman_name"/></td>
                                        <td><span t-esc="line.tapper_name"/></td>
                                        <td class="text-right"><span t-esc="'%.2f' % line.total_reject"/></td>
                                        <td class="text-right"><span t-esc="'%.2f' % line.total_slab"/></td>
                                    </tr>
                                </t>
                                <tr class="total-row">
                                    <td colspan="5" class="text-center">Total</td>
                                    <td class="text-right"><span t-esc="'%.2f' % doc.total_reject_weight"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % doc.total_slab_weight"/></td>
                                </tr>
                            </t>
                            <tr t-if="not doc.line_ids">
                                <td colspan="7" class="text-center">Tidak ada data penimbangan reject dan slab pada periode ini.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
