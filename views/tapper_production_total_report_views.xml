<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_tapper_production_total_report_form" model="ir.ui.view">
        <field name="name">wt.tapper.production.total.report.form</field>
        <field name="model">wt.tapper.production.total.report</field>
        <field name="arch" type="xml">
            <form string="Tapper Production Total Report" edit="0" delete="0">
                <header>
                    <button name="action_open_filter" type="object" string="Filter" class="oe_highlight"/>
                    <button name="action_print_pdf" type="object" string="Export PDF" invisible="not is_filtered"/>
                    <button name="action_export_excel" type="object" string="Export Excel" invisible="not is_filtered"/>
                </header>
                <sheet>
                    <field name="is_filtered" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" role="status" invisible="is_filtered">
                        Please click Filter to display the report data.
                    </div>
                    <group invisible="not is_filtered">
                        <group string="Filter">
                            <field name="company_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="estate_id"/>
                        </group>
                        <group>
                            <field name="division_id"/>
                            <field name="foreman_id"/>
                            <field name="tapper_id"/>
                            <field name="total_production"/>
                        </group>
                    </group>
                    <field name="preview_html"
                           widget="html"
                           nolabel="1"
                           readonly="1"
                           invisible="not is_filtered"/>
                    <field name="date_column_ids" invisible="1"/>
                    <field name="line_ids" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_tapper_production_total_report" model="ir.actions.act_window">
        <field name="name">Tapper Production Total Report</field>
        <field name="res_model">wt.tapper.production.total.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_tapper_production_total_report_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <record id="view_wt_tapper_production_total_report_wizard_form" model="ir.ui.view">
        <field name="name">wt.tapper.production.total.report.wizard.form</field>
        <field name="model">wt.tapper.production.total.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Tapper Production Total Report">
                <sheet>
                    <field name="report_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group string="Filter">
                            <field name="date_start" required="1"/>
                            <field name="date_end" required="1"/>
                            <field name="estate_id"/>
                            <field name="division_id"/>
                            <field name="foreman_id"/>
                            <field name="tapper_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_filter" type="object" string="Apply Filter" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wt_tapper_production_total_report_wizard" model="ir.actions.act_window">
        <field name="name">Tapper Production Total Report</field>
        <field name="res_model">wt.tapper.production.total.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_tapper_production_total_report_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
