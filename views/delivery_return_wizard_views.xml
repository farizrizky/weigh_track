<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_delivery_return_wizard_form" model="ir.ui.view">
        <field name="name">wt.delivery.return.wizard.form</field>
        <field name="model">wt.delivery.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Retur Pengiriman">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        Aksi ini akan memproses retur seluruh barang fisik yang telah terkirim ke customer.
                        Stok fisik akan dikembalikan dari customer ke gudang pengirim terakhir.
                    </div>
                    <group>
                        <field name="delivery_id"/>
                        <field name="reason" placeholder="Contoh: Barang cacat / ditolak oleh customer..." required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Proses Retur" class="btn-danger" confirm="Yakin ingin memproses retur untuk pengiriman ini?"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
