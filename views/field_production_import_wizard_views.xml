<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_field_production_import_wizard_form" model="ir.ui.view">
        <field name="name">wt.field.production.import.wizard.form</field>
        <field name="model">wt.field.production.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Excel Produksi Field">
                <sheet>
                    <field name="production_id" invisible="1"/>
                    <div class="alert alert-info" role="status">
                        <strong>Petunjuk Import:</strong>
                        <ul style="margin-bottom:0;padding-left:1.2em;">
                            <li>Upload file <strong>.xlsx</strong> dengan kolom <strong>Field</strong> dan <strong>Produksi Hari Ini (kg)</strong>.</li>
                            <li>Kolom <strong>Field</strong> harus berisi nama/kode field yang sesuai dengan daftar field di produksi ini.</li>
                            <li>Gunakan tombol <strong>"Download Template"</strong> untuk mendapatkan file template yang sudah terisi daftar field.</li>
                        </ul>
                    </div>
                    <group>
                        <field name="file_data"
                            filename="file_name"
                            widget="binary"
                            string="File Excel (.xlsx)"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"/>
                    <button name="action_download_template"
                        type="object"
                        string="Download Template"
                        class="btn-secondary"/>
                    <button string="Batal"
                        special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
