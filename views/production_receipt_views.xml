<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_production_receipt_search" model="ir.ui.view">
        <field name="name">wt.production.receipt.search</field>
        <field name="model">wt.production.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <field name="production_date"/>
                <field name="division_id"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="processed" string="Processed" domain="[('state', '=', 'processed')]"/>
                <filter name="validated" string="Validated" domain="[('state', '=', 'validated')]"/>
            </search>
        </field>
    </record>

    <record id="view_wt_production_receipt_list" model="ir.ui.view">
        <field name="name">wt.production.receipt.list</field>
        <field name="model">wt.production.receipt</field>
        <field name="arch" type="xml">
            <list string="Production Receipt">
                <field name="name"/>
                <field name="production_date"/>
                <field name="company_id"/>
                <field name="division_id"/>
                <field name="total_weighing"/>
                <field name="data_problem_count"/>
                <field name="total_bag" sum="Total"/>
                <field name="total_stock_weight" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_wt_production_receipt_form" model="ir.ui.view">
        <field name="name">wt.production.receipt.form</field>
        <field name="model">wt.production.receipt</field>
        <field name="arch" type="xml">
            <form string="Production Receipt">
                <header>
                    <button name="action_process" type="object" string="Process" class="oe_highlight" invisible="state not in ('draft', 'processed')"/>
                    <button name="action_validate" type="object" string="Validate" class="oe_highlight" invisible="state not in ('draft', 'processed')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'validated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed,validated,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="company_id" readonly="state != 'draft'" required="1"/>
                            <field name="production_date" readonly="state != 'draft'" required="1"/>
                            <field name="division_id" readonly="state != 'draft'" required="1" domain="[('company_id', '=', company_id)]"/>
                        </group>
                        <group string="Summary">
                            <field name="total_weighing" readonly="1"/>
                            <field name="data_problem_count" readonly="1"/>
                            <field name="total_bag" readonly="1"/>
                            <field name="total_stock_weight" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Weighing">
                            <field name="line_ids" readonly="state == 'validated' or state == 'cancelled'">
                                <list string="Weighing" create="0" delete="1">
                                    <field name="weighing_cup_lump_id" string="Weighing Number" options="{'no_open': False}"/>
                                    <field name="operator_employee_id"/>
                                    <field name="foreman_employee_id"/>
                                    <field name="tapper_employee_id"/>
                                    <field name="total_bag" sum="Total"/>
                                    <field name="stock_weight" string="Weight" sum="Total"/>
                                    <field name="has_data_problem"/>
                                </list>
                            </field>
                        </page>
                        <page string="Validation">
                            <group>
                                <group>
                                    <field name="validated_at" readonly="1"/>
                                    <field name="validated_by_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="cancelled_at" readonly="1"/>
                                    <field name="cancelled_by_id" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="cancel_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_production_receipt" model="ir.actions.act_window">
        <field name="name">Production Receipt</field>
        <field name="res_model">wt.production.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_production_receipt_search"/>
        <field name="context">{'group_by': ['production_date', 'division_id']}</field>
    </record>
</odoo>
