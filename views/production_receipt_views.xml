<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_production_receipt_search" model="ir.ui.view">
        <field name="name">wt.production.receipt.search</field>
        <field name="model">wt.production.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <field name="production_date"/>
                <field name="received_date"/>
                <field name="division_id"/>
                <field name="clerk_employee_id"/>
                <field name="product_id"/>
                <field name="operation_type_id"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="lot_id"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="processed" string="Processed" domain="[('state', '=', 'processed')]"/>
                <filter name="validated" string="Validated" domain="[('state', '=', 'validated')]"/>
            </search>
        </field>
    </record>

    <record id="view_wt_production_receipt_list" model="ir.ui.view">
        <field name="name">wt.production.receipt.list</field>
        <field name="model">wt.production.receipt</field>
        <field name="arch" type="xml">
            <list string="Production Receipt">
                <field name="name"/>
                <field name="production_date"/>
                <field name="received_date"/>
                <field name="company_id"/>
                <field name="division_id"/>
                <field name="product_id"/>
                <field name="operation_type_id"/>
                <field name="location_id"/>
                <field name="clerk_employee_id"/>
                <field name="total_weighing"/>
                <field name="data_problem_count"/>
                <field name="total_bag" sum="Total"/>
                <field name="total_stock_weight" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'processed'"
                       decoration-success="state == 'validated'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_wt_production_receipt_form" model="ir.ui.view">
        <field name="name">wt.production.receipt.form</field>
        <field name="model">wt.production.receipt</field>
        <field name="arch" type="xml">
            <form string="Production Receipt">
                <header>
                    <button name="action_process" type="object" string="Process" class="oe_highlight" invisible="state not in ('draft', 'processed')"/>
                    <button name="action_validate" type="object" string="Validate" class="oe_highlight" invisible="state not in ('draft', 'processed')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'validated'"/>
                    <button name="action_open_movement_date_correction" type="object"
                            string="Correct Movement Date" invisible="state != 'validated'"
                            groups="weightrack.group_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed,validated,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inventory_receipts" type="object" class="oe_stat_button" icon="fa-truck" invisible="stock_picking_count == 0">
                            <field name="stock_picking_count" widget="statinfo" string="Inventory Receipts"/>
                        </button>
                        <button name="action_view_inventory_reversals" type="object" class="oe_stat_button" icon="fa-undo" invisible="reverse_picking_count == 0">
                            <field name="reverse_picking_count" widget="statinfo" string="Inventory Reversals"/>
                        </button>
                        <button name="action_view_lots" type="object" class="oe_stat_button" icon="fa-tags" invisible="lot_count == 0">
                            <field name="lot_count" widget="statinfo" string="Lots"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Production Receipt">
                            <field name="allowed_product_ids" invisible="1"/>
                            <field name="allowed_warehouse_ids" invisible="1"/>
                            <field name="allowed_operation_type_ids" invisible="1"/>
                            <field name="allowed_location_ids" invisible="1"/>
                            <field name="company_id" readonly="state != 'draft'" required="1"/>
                            <field name="product_id" readonly="1" required="1" force_save="1" domain="[('id', 'in', allowed_product_ids)]"/>
                            <field name="production_date" readonly="state != 'draft'" required="1"/>
                            <field name="received_date" readonly="state != 'draft'" required="1"/>
                            <field name="division_id" readonly="state != 'draft'" required="1" domain="[('company_id', '=', company_id)]"/>
                            <field name="clerk_employee_id" readonly="1" required="1" force_save="1"/>
                            <field name="warehouse_id" readonly="state != 'draft'" required="1" domain="[('id', 'in', allowed_warehouse_ids)]"/>
                            <field name="operation_type_id" readonly="state != 'draft'" domain="[('id', 'in', allowed_operation_type_ids)]"/>
                            <field name="location_id" readonly="state != 'draft'" domain="[('id', 'in', allowed_location_ids)]"/>
                        </group>
                        <group string="Summary">
                            <field name="total_weighing" readonly="1"/>
                            <field name="data_problem_count" readonly="1"/>
                            <field name="total_bag" readonly="1"/>
                            <field name="total_stock_weight" readonly="1"/>
                            <field name="stock_picking_count" readonly="1"/>
                            <field name="reverse_picking_count" readonly="1"/>
                            <field name="lot_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Note" col="1" colspan="4">
                        <field name="note" nolabel="1" colspan="4" placeholder="Production receipt note..."/>
                    </group>
                    <notebook>
                        <page string="Weighing">
                            <field name="line_ids" readonly="state == 'validated' or state == 'cancelled'">
                                <list string="Weighing" create="0" delete="1">
                                    <field name="weighing_id" string="Weighing Number" options="{'no_open': False}"/>
                                    <field name="weighing_location_id"/>
                                    <field name="operation_type_id" optional="show"/>
                                    <field name="location_id" optional="show"/>
                                    <field name="operator_employee_id"/>
                                    <field name="foreman_employee_id"/>
                                    <field name="tapper_employee_id"/>
                                    <field name="total_bag" sum="Total"/>
                                    <field name="stock_weight" string="Weight" sum="Total"/>
                                    <field name="stock_picking_id" optional="show"/>
                                    <field name="lot_id" optional="show"/>
                                    <field name="has_data_problem"/>
                                </list>
                            </field>
                        </page>
                        <page string="Validation">
                            <group>
                                <group>
                                    <field name="validated_at" readonly="1"/>
                                    <field name="validated_by_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="cancelled_at" readonly="1"/>
                                    <field name="cancelled_by_id" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="cancel_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_production_receipt" model="ir.actions.act_window">
        <field name="name">Production Receipt</field>
        <field name="res_model">wt.production.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_production_receipt_search"/>
        <field name="context">{}</field>
    </record>
</odoo>
