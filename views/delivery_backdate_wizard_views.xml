<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_delivery_backdate_wizard_form" model="ir.ui.view">
        <field name="name">wt.delivery.backdate.wizard.form</field>
        <field name="model">wt.delivery.backdate.wizard</field>
        <field name="arch" type="xml">
            <form string="Correct Effective Date">
                <sheet>
                    <group>
                        <field name="delivery_id"/>
                        <field name="current_date"/>
                        <field name="effective_date"/>
                        <field name="reason" placeholder="Explain why this delivery must be recorded on an earlier date..."/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        This correction changes the transaction date of the completed transfers and stock movements.
                        Quantities are not changed.
                    </div>
                    <group string="Affected Records">
                        <group>
                            <field name="picking_count" readonly="1"/>
                            <field name="move_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="picking_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply"
                            string="Apply Correction"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
