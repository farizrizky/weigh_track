<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_inherit_weightrack" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.weightrack</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@type='action'][@data-hotkey='k']" position="attributes">
                <attribute name="invisible">state != 'done' or production_receipt_id or production_receipt_reverse_id</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="production_receipt_id" readonly="1"/>
                <field name="production_receipt_reverse_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
