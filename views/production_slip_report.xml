<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_production_slip" model="report.paperformat">
        <field name="name">Production Slip A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="paperformat_production_receipt_slip" model="report.paperformat">
        <field name="name">Production Receipt Slip A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">14</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_production_slip" model="ir.actions.report">
        <field name="name">Production Slip</field>
        <field name="model">wt.production.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_production_slip_document</field>
        <field name="report_file">weightrack.report_production_slip_document</field>
        <field name="paperformat_id" ref="paperformat_production_slip"/>
        <field name="binding_model_id" ref="model_wt_production_receipt"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Production Slip - %s' % (object.name)</field>
    </record>

    <record id="action_report_production_receipt_slip" model="ir.actions.report">
        <field name="name">Production Receipt Slip</field>
        <field name="model">wt.production.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_production_receipt_slip_document</field>
        <field name="report_file">weightrack.report_production_receipt_slip_document</field>
        <field name="paperformat_id" ref="paperformat_production_receipt_slip"/>
        <field name="binding_model_id" ref="model_wt_production_receipt"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Production Receipt Slip - %s' % (object.name)</field>
    </record>

    <template id="report_production_slip_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page wt-production-slip">
                    <style>
.wt-production-slip {
                            font-family: "Lato", sans-serif;
                            color: #111;
                            font-size: 12px;
                        }
                        .wt-production-slip .top-grid {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 10px;
                        }
                        .wt-production-slip .top-grid td {
                            vertical-align: top;
                        }
                        .wt-production-slip .brand-cell {
                            width: 36%;
                        }
                        .wt-production-slip .title-cell {
                            width: 30%;
                            text-align: center;
                            padding-top: 34px;
                        }
                        .wt-production-slip .meta-cell {
                            width: 34%;
                            padding-left: 18px;
                        }
                        .wt-production-slip .company-logo {
                            max-height: 118px;
                            max-width: 390px;
                        }
                        .wt-production-slip .company-name {
                            font-size: 28px;
                            font-weight: 700;
                            line-height: 1.1;
                        }
                        .wt-production-slip .company-subtitle {
                            font-size: 14px;
                            font-weight: 700;
                            margin-left: 48px;
                        }
                        .wt-production-slip .slip-title {
                            font-size: 22px;
                            font-weight: 700;
                            text-decoration: underline;
                            letter-spacing: .5px;
                        }
                        .wt-production-slip .slip-number {
                            margin-top: 2px;
                            font-size: 15px;
                        }
                        .wt-production-slip .number-segment {
                            display: inline-block;
                            width: 54px;
                            border-bottom: 1px dotted #333;
                            vertical-align: bottom;
                        }
                        .wt-production-slip .form-meta {
                            text-align: right;
                            font-size: 11px;
                            line-height: 1.25;
                            margin-bottom: 12px;
                        }
                        .wt-production-slip .field-line {
                            display: table;
                            width: 100%;
                            line-height: 1.8;
                        }
                        .wt-production-slip .field-label {
                            display: table-cell;
                            width: 110px;
                            white-space: nowrap;
                            padding-right: 8px;
                        }
                        .wt-production-slip .field-label:after {
                            content: ":";
                            float: right;
                        }
                        .wt-production-slip .field-value {
                            display: table-cell;
                            border-bottom: 1px dotted #333;
                            min-height: 16px;
                            padding-left: 4px;
                        }
                        .wt-production-slip .field-value.time-value {
                            text-align: right;
                            padding-right: 2px;
                        }
                        .wt-production-slip .recipient-row {
                            display: table;
                            table-layout: fixed;
                            width: 100%;
                            line-height: 1.8;
                            white-space: nowrap;
                        }
                        .wt-production-slip .recipient-label {
                            display: table-cell;
                            width: 118px;
                            white-space: nowrap;
                        }
                        .wt-production-slip .recipient-separator {
                            display: table-cell;
                            width: 12px;
                            text-align: center;
                        }
                        .wt-production-slip .recipient-value {
                            display: table-cell;
                            border-bottom: 1px dotted #333;
                        }
                        .wt-production-slip .place-block {
                            margin-top: 3px;
                            line-height: 1.4;
                        }
                        .wt-production-slip .place-label {
                            display: block;
                            margin-left: 0;
                        }
                        .wt-production-slip .place-value {
                            display: inline-block;
                            margin-left: 20px;
                            min-width: 72px;
                            border-bottom: 1px solid #333;
                            font-style: italic;
                            text-align: center;
                        }
                        .wt-production-slip .subheader-grid {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 16px;
                        }
                        .wt-production-slip .subheader-grid td {
                            vertical-align: bottom;
                            padding-right: 24px;
                        }
                        .wt-production-slip .subheader-grid td:last-child {
                            padding-right: 0;
                        }
                        .wt-production-slip .item-table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                            font-size: 12px;
                        }
                        .wt-production-slip .item-table th,
                        .wt-production-slip .item-table td {
                            border: 1px solid #222;
                            padding: 2px 3px;
                            vertical-align: middle;
                        }
                        .wt-production-slip .item-table th {
                            text-align: center;
                            font-weight: 700;
                        }
                        .wt-production-slip .number {
                            text-align: right;
                        }
                        .wt-production-slip .center {
                            text-align: center;
                        }
                        .wt-production-slip .note-label-cell {
                            white-space: nowrap;
                        }
                        .wt-production-slip .note-value-cell {
                            width: 5%;
                        }
                        .wt-production-slip .signature-table {
                            width: 100%;
                            margin-top: 12px;
                            border-collapse: collapse;
                            table-layout: fixed;
                            font-size: 12px;
                        }
                        .wt-production-slip .signature-table td {
                            text-align: center;
                            vertical-align: bottom;
                        }
                        .wt-production-slip .signature-space {
                            height: 52px;
                        }
                        .wt-production-slip .signature-name {
                            display: inline-block;
                            min-width: 120px;
                            border-bottom: 1px dotted #333;
                            padding: 0 8px 2px;
                        }
                    </style>

                    <table class="top-grid">
                        <tr>
                            <td class="brand-cell">
                                <t t-if="doc.company_id.logo">
                                    <img class="company-logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <div class="company-name" t-esc="doc.company_id.name"/>
                                    <div class="company-subtitle">Plantations</div>
                                </t>
                            </td>
                            <td class="title-cell">
                                <div class="slip-title">PRODUCTION SLIP</div>
                                <div class="slip-number">
                                    No.
                                    <span class="number-segment"></span>
                                    /
                                    <span class="number-segment"></span>
                                    /
                                    <span class="number-segment"></span>
                                </div>
                            </td>
                            <td class="meta-cell">
                                <div class="form-meta">
                                    <div>Form No : BME-FR-26</div>
                                    <div>Rev : 00</div>
                                </div>
                                <div class="field-line">
                                    <span class="field-label">Tanggal</span>
                                    <span class="field-value">
                                        <span t-field="doc.received_date"/>
                                    </span>
                                </div>
                                <div class="recipient-row">
                                    <span class="recipient-label">Kepada Saudara</span>
                                    <span class="recipient-separator">:</span>
                                    <span class="recipient-value"></span>
                                </div>
                                <div class="place-block">
                                    <span class="place-label">Di</span>
                                    <span class="place-value">Tempat</span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="subheader-grid">
                        <tr>
                            <td style="width: 34%;">
                                <div class="field-line">
                                    <span class="field-label">Kendaraan</span>
                                    <span class="field-value"></span>
                                </div>
                                <div class="field-line">
                                    <span class="field-label">Divisi</span>
                                    <span class="field-value">
                                        <span t-esc="doc.division_id.name"/>
                                    </span>
                                </div>
                            </td>
                            <td style="width: 28%;">
                                <div class="field-line">
                                    <span class="field-label">No. Polisi</span>
                                    <span class="field-value"></span>
                                </div>
                                <div class="field-line">
                                    <span class="field-label">Ancak</span>
                                    <span class="field-value">A / B / C / D</span>
                                </div>
                            </td>
                            <td style="width: 38%;">
                                <div class="field-line">
                                    <span class="field-label">Berangkat</span>
                                    <span class="field-value"></span>
                                </div>
                                <div class="field-line">
                                    <span class="field-label">Jam</span>
                                    <span class="field-value time-value">WIB</span>
                                </div>
                                <div class="field-line">
                                    <span class="field-label">Tiba</span>
                                    <span class="field-value time-value">WIB</span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="item-table">
                        <thead>
                            <tr>
                                <th rowspan="2" style="width: 4%;">No</th>
                                <th rowspan="2" style="width: 15%;">Jenis Barang</th>
                                <th colspan="2" style="width: 12%;">Dari Kebun</th>
                                <th colspan="4" style="width: 24%;">Analisa Mutu</th>
                                <th rowspan="2" style="width: 6%;">%<br/>Susut</th>
                                <th rowspan="2" style="width: 13%;">Keterangan</th>
                                <th colspan="2" rowspan="2" style="width: 18%;">Catatan Hari ini</th>
                            </tr>
                            <tr>
                                <th>KB</th>
                                <th>Deep<br/>Stik</th>
                                <th>KB</th>
                                <th>% DRC</th>
                                <th>KK</th>
                                <th>Deep<br/>Stik</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="center">1</td>
                                <td>Latex</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">- Tapper</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">2</td>
                                <td>Latex Siap</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">- Serep Tapp</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">3</td>
                                <td>Slab Kebun</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">- Serep Apit</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">4</td>
                                <td>Cuci Kaleng</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">- Anca Kosong</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">5</td>
                                <td>Tree Lace</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">- Jam Sadap</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">6</td>
                                <td>Cup Lump</td>
                                <td class="number">
                                    <span t-esc="'%.0f' % (doc.total_stock_weight or 0.0)"/>
                                </td>
                                <td/>
                                <td class="number">
                                    <span t-esc="'%.0f' % (doc.total_stock_weight or 0.0)"/>
                                </td>
                                <td/><td/><td/><td/>
                                <td>
                                    <span t-if="doc.total_bag">
                                        <span t-esc="doc.total_bag"/> krg.
                                    </span>
                                </td>
                                <td class="note-label-cell">- Jam Pungut</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">7</td>
                                <td>Total</td>
                                <td class="number">
                                    <span t-esc="'%.0f' % (doc.total_stock_weight or 0.0)"/>
                                </td>
                                <td/>
                                <td class="number">
                                    <span t-esc="'%.0f' % (doc.total_stock_weight or 0.0)"/>
                                </td>
                                <td/><td/><td/><td/>
                                <td>
                                    <span t-if="doc.total_bag">
                                        <span t-esc="doc.total_bag"/> krg.
                                    </span>
                                </td>
                                <td class="note-label-cell">- Cuaca</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">8</td>
                                <td>Prod Per Tapp</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">Total HK Maju</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">9</td>
                                <td>Prod Latex VS Off grade</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell"/>
                                <td class="note-value-cell"/>
                            </tr>
                        </tbody>
                    </table>

                    <table class="signature-table">
                        <tr>
                            <td>Dikirim Oleh,</td>
                            <td>Diperiksa Oleh,</td>
                            <td>Diketahui Oleh,</td>
                            <td>Penerima</td>
                            <td>Driver</td>
                        </tr>
                        <tr>
                            <td class="signature-space"/>
                            <td class="signature-space"/>
                            <td class="signature-space"/>
                            <td class="signature-space"/>
                            <td class="signature-space"/>
                        </tr>
                        <tr>
                            <td>( <span class="signature-name"></span> )</td>
                            <td>( <span class="signature-name"></span> )</td>
                            <td>( <span class="signature-name"></span> )</td>
                            <td>( <span class="signature-name"></span> )</td>
                            <td>( <span class="signature-name"></span> )</td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="external_layout_weightrack_production_receipt">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-set="company" t-value="o.company_id.sudo() if o and o.company_id else res_company"/>
        <div
            t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"
            t-att-data-oe-model="o and o._name"
            t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout"/>
    </template>

    <template id="report_production_receipt_slip_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="uom_name" t-value="doc.product_id.uom_id.name or ''"/>
                <t t-set="lot_lines" t-value="doc.wt_get_report_lot_lines()"/>
                <t t-set="report_company" t-value="doc.company_id.sudo() if doc.company_id else res_company"/>
                <t t-call="weightrack.external_layout_weightrack_production_receipt">
                    <div class="page wt-production-receipt-slip">
                        <style>
                            .wt-production-receipt-slip {
                                color: inherit;
                                font-family: inherit;
                                font-size: 10px;
                                line-height: 1.45;
                            }
                            .wt-production-receipt-slip .label-en {
                                display: block;
                                font-weight: 700;
                                line-height: 1.25;
                            }
                            .wt-production-receipt-slip .label-id {
                                color: #6b7280;
                                display: block;
                                font-size: 8px;
                                font-weight: 400;
                                line-height: 1.25;
                                margin-top: 1px;
                            }
                            .wt-production-receipt-slip .wt-borderless,
                            .wt-production-receipt-slip .wt-borderless > tbody,
                            .wt-production-receipt-slip .wt-borderless > tbody > tr,
                            .wt-production-receipt-slip .wt-borderless > tbody > tr > td {
                                border: 0 !important;
                                box-shadow: none !important;
                                outline: 0 !important;
                            }
                            .wt-production-receipt-slip .wt-framed-table,
                            .wt-production-receipt-slip .wt-framed-table > thead,
                            .wt-production-receipt-slip .wt-framed-table > tbody,
                            .wt-production-receipt-slip .wt-framed-table > thead > tr,
                            .wt-production-receipt-slip .wt-framed-table > tbody > tr {
                                border: 0 !important;
                                box-shadow: none !important;
                                outline: 0 !important;
                            }
                            .wt-production-receipt-slip .brand-table {
                                border-collapse: collapse;
                                table-layout: fixed;
                                width: 100%;
                            }
                            .wt-production-receipt-slip .brand-table > tbody > tr > td {
                                background: transparent !important;
                                padding: 0 !important;
                                vertical-align: middle;
                                width: 50%;
                            }
                            .wt-production-receipt-slip .brand-logo {
                                display: block;
                                max-height: 54px;
                                max-width: 210px;
                            }
                            .wt-production-receipt-slip .brand-company-name {
                                color: inherit;
                                font-size: 20px;
                                font-weight: 700;
                                line-height: 1.2;
                                text-align: right;
                            }
                            .wt-production-receipt-slip .brand-content-gap {
                                height: 30px;
                            }
                            .wt-production-receipt-slip .document-meta-table {
                                border-collapse: collapse;
                                margin: 0 0 14px;
                                table-layout: fixed;
                                width: 100%;
                            }
                            .wt-production-receipt-slip .document-meta-table > tbody > tr > td {
                                background: transparent !important;
                                padding: 0 !important;
                                vertical-align: top;
                            }
                            .wt-production-receipt-slip .document-title {
                                color: inherit;
                                font-size: 18px;
                                font-weight: 700;
                                letter-spacing: 0;
                                line-height: 1.2;
                                margin: 0 0 8px;
                                text-align: left;
                                text-transform: none;
                            }
                            .wt-production-receipt-slip .document-number-table {
                                border-collapse: collapse;
                                table-layout: fixed;
                                width: 100%;
                            }
                            .wt-production-receipt-slip .document-number-table td {
                                background: transparent !important;
                                padding: 2px 0 !important;
                                vertical-align: top;
                            }
                            .wt-production-receipt-slip .document-label {
                                width: 34%;
                            }
                            .wt-production-receipt-slip .document-value {
                                text-align: left;
                                width: 66%;
                                word-wrap: break-word;
                            }
                            .wt-production-receipt-slip .scope-table {
                                border-collapse: collapse;
                                margin-bottom: 16px;
                                table-layout: fixed;
                                width: 100%;
                            }
                            .wt-production-receipt-slip .scope-table td {
                                background: #fff !important;
                                border: 1px solid #cbd5e1 !important;
                                box-shadow: none !important;
                                font-size: 10px;
                                outline: 0 !important;
                                padding: 7px 8px !important;
                                vertical-align: middle;
                            }
                            .wt-production-receipt-slip .scope-label {
                                background: #f3f4f6 !important;
                                font-weight: 700;
                                width: 17%;
                            }
                            .wt-production-receipt-slip .scope-table td.scope-value {
                                width: 33%;
                                word-break: break-word;
                                word-wrap: break-word;
                            }
                            .wt-production-receipt-slip .section-title {
                                background: transparent;
                                border-bottom: 1px solid #cbd5e1;
                                color: inherit;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 0;
                                line-height: 1.4;
                                margin-top: 14px;
                                padding: 0 0 5px;
                                text-transform: none;
                            }
                            .wt-production-receipt-slip .control-table {
                                border-collapse: collapse;
                                margin-top: 0;
                                table-layout: fixed;
                                width: 100%;
                            }
                            .wt-production-receipt-slip .control-table th {
                                background: #f3f4f6;
                                border: 1px solid #cbd5e1 !important;
                                color: inherit;
                                font-size: 10px;
                                font-weight: 700;
                                line-height: 1.4;
                                padding: 9px 10px !important;
                                text-align: center;
                                vertical-align: middle;
                            }
                            .wt-production-receipt-slip .control-table td {
                                border: 1px solid #cbd5e1 !important;
                                font-size: 10px;
                                line-height: 1.6;
                                overflow-wrap: anywhere;
                                padding: 10px 12px !important;
                                vertical-align: top;
                                word-break: break-word;
                                word-wrap: break-word;
                            }
                            .wt-production-receipt-slip .control-table td.text-right {
                                padding-left: 10px !important;
                                padding-right: 16px !important;
                                white-space: nowrap;
                                word-break: normal;
                                word-wrap: normal;
                            }
                            .wt-production-receipt-slip .total-row td {
                                background: #f9fafb;
                                font-weight: 700;
                            }
                            .wt-production-receipt-slip .text-right {
                                text-align: right;
                            }
                            .wt-production-receipt-slip .text-center {
                                text-align: center;
                            }
                            .wt-production-receipt-slip .muted {
                                color: #6b7280;
                                line-height: 1.45;
                            }
                            .wt-production-receipt-slip .audit-note {
                                border: 1px solid #d1d5db;
                                min-height: 64px;
                                padding: 10px;
                            }
                            .wt-production-receipt-slip .signature-table,
                            .wt-production-receipt-slip .signature-table tbody,
                            .wt-production-receipt-slip .signature-table tr,
                            .wt-production-receipt-slip .signature-table td {
                                border: 0 !important;
                                box-shadow: none !important;
                                outline: 0 !important;
                            }
                            .wt-production-receipt-slip .signature-table {
                                border-collapse: collapse;
                                margin-top: 18px;
                                table-layout: fixed;
                                width: 100%;
                            }
                            .wt-production-receipt-slip .signature-table td {
                                padding: 0 !important;
                                text-align: center;
                                vertical-align: bottom;
                            }
                            .wt-production-receipt-slip .signature-space {
                                height: 48px;
                            }
                            .wt-production-receipt-slip .signature-name {
                                border-bottom: 1px dotted #333;
                                display: inline-block;
                                min-width: 100px;
                            }
                        </style>

                        <table class="brand-table wt-borderless table-borderless" border="0" cellspacing="0" cellpadding="0" style="border: 0 !important; box-shadow: none !important; outline: 0 !important;">
                            <tbody style="border: 0 !important; outline: 0 !important;">
                                <tr style="border: 0 !important; outline: 0 !important;">
                                    <td style="border: 0 !important; outline: 0 !important;">
                                        <t t-if="report_company.logo">
                                            <img class="brand-logo" t-att-src="image_data_uri(report_company.logo)" alt="Logo"/>
                                        </t>
                                    </td>
                                    <td style="border: 0 !important; outline: 0 !important;">
                                        <div class="brand-company-name" t-esc="report_company.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="brand-content-gap"/>

                        <table class="document-meta-table wt-borderless table-borderless" border="0" cellspacing="0" cellpadding="0" style="border: 0 !important; box-shadow: none !important; outline: 0 !important;">
                            <tbody style="border: 0 !important; outline: 0 !important;">
                                <tr style="border: 0 !important; outline: 0 !important;">
                                    <td style="border: 0 !important; outline: 0 !important; width: 48%;">
                                        <div class="document-title">
                                            <span class="label-en">PRODUCTION RECEIPT SLIP</span>
                                            <span class="label-id">Penerimaan Produksi</span>
                                        </div>
                                        <table class="document-number-table wt-borderless table-borderless" border="0" cellspacing="0" cellpadding="0" style="border: 0 !important; box-shadow: none !important; outline: 0 !important;">
                                            <tbody style="border: 0 !important; outline: 0 !important;">
                                                <tr style="border: 0 !important; outline: 0 !important;">
                                                    <td class="document-label" style="border: 0 !important; outline: 0 !important;">
                                                        <span class="label-en">RECEIPT NO.</span>
                                                        <span class="label-id">Nomor Penerimaan</span>
                                                    </td>
                                                    <td class="document-value" style="border: 0 !important; outline: 0 !important; padding-left: 8px !important;" t-esc="doc.name"/>
                                                </tr>
                                                <tr style="border: 0 !important; outline: 0 !important;">
                                                    <td class="document-label" style="border: 0 !important; outline: 0 !important;">
                                                        <span class="label-en">DATE</span>
                                                        <span class="label-id">Tanggal</span>
                                                    </td>
                                                    <td class="document-value" style="border: 0 !important; outline: 0 !important; padding-left: 8px !important;"><span t-field="doc.received_date"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                    <td style="border: 0 !important; outline: 0 !important; width: 52%;"></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="scope-table" cellspacing="0" cellpadding="0">
                            <tbody>
                                <tr>
                                    <td class="scope-label">Estate</td>
                                    <td class="scope-value" t-esc="doc.division_id.estate_id.name or '-'"/>
                                    <td class="scope-label">Tanggal Produksi</td>
                                    <td class="scope-value"><span t-field="doc.production_date"/></td>
                                </tr>
                                <tr>
                                    <td class="scope-label">Divisi</td>
                                    <td class="scope-value" t-esc="doc.division_id.name or '-'"/>
                                    <td class="scope-label">Total Penimbangan</td>
                                    <td class="scope-value" t-esc="doc.total_weighing"/>
                                </tr>
                                <tr>
                                    <td class="scope-label">Gudang</td>
                                    <td class="scope-value" t-esc="doc.warehouse_id.display_name or '-'"/>
                                    <td class="scope-label">Total Karung</td>
                                    <td class="scope-value" t-esc="doc.total_bag"/>
                                </tr>
                                <tr>
                                    <td class="scope-label">Lokasi</td>
                                    <td class="scope-value">
                                        <span t-if="doc.location_id" t-esc="doc.location_id.display_name"/>
                                        <span t-else="">Semua</span>
                                    </td>
                                    <td class="scope-label">Total Berat</td>
                                    <td class="scope-value">
                                        <span t-esc="'%.2f' % (doc.total_stock_weight or 0.0)"/>
                                        <span t-esc="uom_name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="section-title">LOT</div>
                        <table class="control-table wt-framed-table" border="0" cellspacing="0" cellpadding="0" style="border: 0 !important; box-shadow: none !important; outline: 0 !important;">
                            <thead>
                                <tr>
                                    <th style="width: 40%;">Lot</th>
                                    <th style="width: 40%;">Lokasi</th>
                                    <th style="width: 20%;">Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="lot_lines">
                                    <t t-foreach="lot_lines" t-as="lot_line">
                                        <tr>
                                            <td t-esc="lot_line.get('lot_name') or '-'"/>
                                            <td t-esc="lot_line.get('location_name') or '-'"/>
                                            <td class="text-right">
                                                <span t-esc="'%.2f' % (lot_line.get('qty') or 0.0)"/>
                                                <span t-esc="lot_line.get('uom_name') or uom_name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <tr t-if="lot_lines" class="total-row">
                                    <td colspan="2" class="text-right">Total</td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % (doc.total_stock_weight or 0.0)"/>
                                        <span t-esc="uom_name"/>
                                    </td>
                                </tr>
                                <tr t-if="not lot_lines">
                                    <td colspan="3" class="text-center muted">Belum ada Lot.</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="section-title">DETAIL PENIMBANGAN</div>
                        <table class="control-table wt-framed-table" border="0" cellspacing="0" cellpadding="0" style="border: 0 !important; box-shadow: none !important; outline: 0 !important;">
                            <thead>
                                <tr>
                                    <th style="width: 5%;">No</th>
                                    <th style="width: 16%;">Nomor Timbang</th>
                                    <th style="width: 16%;">Lokasi Timbang</th>
                                    <th style="width: 13%;">Mandor</th>
                                    <th style="width: 13%;">Tapper</th>
                                    <th style="width: 15%;">Lot</th>
                                    <th style="width: 9%;">Karung</th>
                                    <th style="width: 13%;">Berat</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="doc.line_ids">
                                    <t t-foreach="doc.line_ids" t-as="line">
                                        <tr>
                                            <td class="text-center" t-esc="line_index + 1"/>
                                            <td><span t-esc="line.weighing_id.name"/></td>
                                            <td><span t-esc="line.weighing_location_id.display_name"/></td>
                                            <td><span t-esc="line.foreman_employee_id.name"/></td>
                                            <td><span t-esc="line.tapper_employee_id.name"/></td>
                                            <td><span t-esc="line.lot_id.name"/></td>
                                            <td class="text-right"><span t-esc="line.total_bag"/></td>
                                            <td class="text-right">
                                                <span t-esc="'%.2f' % (line.stock_weight or 0.0)"/>
                                                <span t-esc="uom_name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <tr t-if="doc.line_ids" class="total-row">
                                    <td colspan="6" class="text-right">Total</td>
                                    <td class="text-right"><span t-esc="doc.total_bag"/></td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % (doc.total_stock_weight or 0.0)"/>
                                        <span t-esc="uom_name"/>
                                    </td>
                                </tr>
                                <tr t-if="not doc.line_ids">
                                    <td colspan="8" class="text-center muted">Belum ada data penimbangan.</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="section-title">CATATAN PENERIMAAN PRODUKSI</div>
                        <div class="audit-note">
                            <span t-if="doc.note" t-esc="doc.note"/>
                            <span t-else=""></span>
                        </div>

                        <table class="signature-table">
                            <tr>
                                <td>Dikirim Oleh,</td>
                                <td>Diperiksa Oleh,</td>
                                <td>Diketahui Oleh,</td>
                                <td>Penerima</td>
                                <td>Driver</td>
                            </tr>
                            <tr>
                                <td class="signature-space"/>
                                <td class="signature-space"/>
                                <td class="signature-space"/>
                                <td class="signature-space"/>
                                <td class="signature-space"/>
                            </tr>
                            <tr>
                                <td>( <span class="signature-name"></span> )</td>
                                <td>( <span class="signature-name"></span> )</td>
                                <td>( <span class="signature-name"></span> )</td>
                                <td>( <span class="signature-name"></span> )</td>
                                <td>( <span class="signature-name"></span> )</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
