<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_production_slip" model="report.paperformat">
        <field name="name">Production Slip A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="paperformat_production_receipt_slip" model="report.paperformat">
        <field name="name">Production Receipt Slip A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">36</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">28</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_production_slip" model="ir.actions.report">
        <field name="name">Production Slip</field>
        <field name="model">wt.production.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_production_slip_document</field>
        <field name="report_file">weightrack.report_production_slip_document</field>
        <field name="paperformat_id" ref="paperformat_production_slip"/>
        <field name="binding_model_id" ref="model_wt_production_receipt"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Production Slip - %s' % (object.name)</field>
    </record>

    <record id="action_report_production_receipt_slip" model="ir.actions.report">
        <field name="name">Production Receipt Slip</field>
        <field name="model">wt.production.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">weightrack.report_production_receipt_slip_document</field>
        <field name="report_file">weightrack.report_production_receipt_slip_document</field>
        <field name="paperformat_id" ref="paperformat_production_receipt_slip"/>
        <field name="binding_model_id" ref="model_wt_production_receipt"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Production Receipt Slip - %s' % (object.name)</field>
    </record>

    <template id="report_production_slip_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page wt-production-slip">
                    <style>
                        .wt-production-slip {
                            font-family: Arial, Helvetica, sans-serif;
                            color: #111;
                            font-size: 12px;
                        }
                        .wt-production-slip .top-grid {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 10px;
                        }
                        .wt-production-slip .top-grid td {
                            vertical-align: top;
                        }
                        .wt-production-slip .brand-cell {
                            width: 36%;
                        }
                        .wt-production-slip .title-cell {
                            width: 30%;
                            text-align: center;
                            padding-top: 34px;
                        }
                        .wt-production-slip .meta-cell {
                            width: 34%;
                            padding-left: 18px;
                        }
                        .wt-production-slip .company-logo {
                            max-height: 118px;
                            max-width: 390px;
                        }
                        .wt-production-slip .company-name {
                            font-size: 28px;
                            font-weight: 700;
                            line-height: 1.1;
                        }
                        .wt-production-slip .company-subtitle {
                            font-size: 14px;
                            font-weight: 700;
                            margin-left: 48px;
                        }
                        .wt-production-slip .slip-title {
                            font-size: 22px;
                            font-weight: 700;
                            text-decoration: underline;
                            letter-spacing: .5px;
                        }
                        .wt-production-slip .slip-number {
                            margin-top: 2px;
                            font-size: 15px;
                        }
                        .wt-production-slip .number-segment {
                            display: inline-block;
                            width: 54px;
                            border-bottom: 1px dotted #333;
                            vertical-align: bottom;
                        }
                        .wt-production-slip .form-meta {
                            text-align: right;
                            font-size: 11px;
                            line-height: 1.25;
                            margin-bottom: 12px;
                        }
                        .wt-production-slip .field-line {
                            display: table;
                            width: 100%;
                            line-height: 1.8;
                        }
                        .wt-production-slip .field-label {
                            display: table-cell;
                            width: 110px;
                            white-space: nowrap;
                            padding-right: 8px;
                        }
                        .wt-production-slip .field-label:after {
                            content: ":";
                            float: right;
                        }
                        .wt-production-slip .field-value {
                            display: table-cell;
                            border-bottom: 1px dotted #333;
                            min-height: 16px;
                            padding-left: 4px;
                        }
                        .wt-production-slip .field-value.time-value {
                            text-align: right;
                            padding-right: 2px;
                        }
                        .wt-production-slip .recipient-row {
                            display: table;
                            table-layout: fixed;
                            width: 100%;
                            line-height: 1.8;
                            white-space: nowrap;
                        }
                        .wt-production-slip .recipient-label {
                            display: table-cell;
                            width: 118px;
                            white-space: nowrap;
                        }
                        .wt-production-slip .recipient-separator {
                            display: table-cell;
                            width: 12px;
                            text-align: center;
                        }
                        .wt-production-slip .recipient-value {
                            display: table-cell;
                            border-bottom: 1px dotted #333;
                        }
                        .wt-production-slip .place-block {
                            margin-top: 3px;
                            line-height: 1.4;
                        }
                        .wt-production-slip .place-label {
                            display: block;
                            margin-left: 0;
                        }
                        .wt-production-slip .place-value {
                            display: inline-block;
                            margin-left: 20px;
                            min-width: 72px;
                            border-bottom: 1px solid #333;
                            font-style: italic;
                            text-align: center;
                        }
                        .wt-production-slip .subheader-grid {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 16px;
                        }
                        .wt-production-slip .subheader-grid td {
                            vertical-align: bottom;
                            padding-right: 24px;
                        }
                        .wt-production-slip .subheader-grid td:last-child {
                            padding-right: 0;
                        }
                        .wt-production-slip .item-table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                            font-size: 12px;
                        }
                        .wt-production-slip .item-table th,
                        .wt-production-slip .item-table td {
                            border: 1px solid #222;
                            padding: 2px 3px;
                            vertical-align: middle;
                        }
                        .wt-production-slip .item-table th {
                            text-align: center;
                            font-weight: 700;
                        }
                        .wt-production-slip .number {
                            text-align: right;
                        }
                        .wt-production-slip .center {
                            text-align: center;
                        }
                        .wt-production-slip .note-label-cell {
                            white-space: nowrap;
                        }
                        .wt-production-slip .note-value-cell {
                            width: 5%;
                        }
                        .wt-production-slip .signature-table {
                            width: 100%;
                            margin-top: 12px;
                            border-collapse: collapse;
                            table-layout: fixed;
                            font-size: 12px;
                        }
                        .wt-production-slip .signature-table td {
                            text-align: center;
                            vertical-align: bottom;
                        }
                        .wt-production-slip .signature-space {
                            height: 52px;
                        }
                        .wt-production-slip .signature-name {
                            display: inline-block;
                            min-width: 120px;
                            border-bottom: 1px dotted #333;
                            padding: 0 8px 2px;
                        }
                    </style>

                    <table class="top-grid">
                        <tr>
                            <td class="brand-cell">
                                <t t-if="doc.company_id.logo">
                                    <img class="company-logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <div class="company-name" t-esc="doc.company_id.name"/>
                                    <div class="company-subtitle">Plantations</div>
                                </t>
                            </td>
                            <td class="title-cell">
                                <div class="slip-title">PRODUCTION SLIP</div>
                                <div class="slip-number">
                                    No.
                                    <span class="number-segment"></span>
                                    /
                                    <span class="number-segment"></span>
                                    /
                                    <span class="number-segment"></span>
                                </div>
                            </td>
                            <td class="meta-cell">
                                <div class="form-meta">
                                    <div>Form No : BME-FR-26</div>
                                    <div>Rev : 00</div>
                                </div>
                                <div class="field-line">
                                    <span class="field-label">Tanggal</span>
                                    <span class="field-value">
                                        <span t-field="doc.received_date"/>
                                    </span>
                                </div>
                                <div class="recipient-row">
                                    <span class="recipient-label">Kepada Saudara</span>
                                    <span class="recipient-separator">:</span>
                                    <span class="recipient-value"></span>
                                </div>
                                <div class="place-block">
                                    <span class="place-label">Di</span>
                                    <span class="place-value">Tempat</span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="subheader-grid">
                        <tr>
                            <td style="width: 34%;">
                                <div class="field-line">
                                    <span class="field-label">Kendaraan</span>
                                    <span class="field-value"></span>
                                </div>
                                <div class="field-line">
                                    <span class="field-label">Divisi</span>
                                    <span class="field-value">
                                        <span t-esc="doc.division_id.name"/>
                                    </span>
                                </div>
                            </td>
                            <td style="width: 28%;">
                                <div class="field-line">
                                    <span class="field-label">No. Polisi</span>
                                    <span class="field-value"></span>
                                </div>
                                <div class="field-line">
                                    <span class="field-label">Ancak</span>
                                    <span class="field-value">A / B / C / D</span>
                                </div>
                            </td>
                            <td style="width: 38%;">
                                <div class="field-line">
                                    <span class="field-label">Berangkat</span>
                                    <span class="field-value"></span>
                                </div>
                                <div class="field-line">
                                    <span class="field-label">Jam</span>
                                    <span class="field-value time-value">WIB</span>
                                </div>
                                <div class="field-line">
                                    <span class="field-label">Tiba</span>
                                    <span class="field-value time-value">WIB</span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="item-table">
                        <thead>
                            <tr>
                                <th rowspan="2" style="width: 4%;">No</th>
                                <th rowspan="2" style="width: 15%;">Jenis Barang</th>
                                <th colspan="2" style="width: 12%;">Dari Kebun</th>
                                <th colspan="4" style="width: 24%;">Analisa Mutu</th>
                                <th rowspan="2" style="width: 6%;">%<br/>Susut</th>
                                <th rowspan="2" style="width: 13%;">Keterangan</th>
                                <th colspan="2" rowspan="2" style="width: 18%;">Catatan Hari ini</th>
                            </tr>
                            <tr>
                                <th>KB</th>
                                <th>Deep<br/>Stik</th>
                                <th>KB</th>
                                <th>% DRC</th>
                                <th>KK</th>
                                <th>Deep<br/>Stik</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="center">1</td>
                                <td>Latex</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">- Tapper</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">2</td>
                                <td>Latex Siap</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">- Serep Tapp</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">3</td>
                                <td>Slab Kebun</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">- Serep Apit</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">4</td>
                                <td>Cuci Kaleng</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">- Anca Kosong</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">5</td>
                                <td>Tree Lace</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">- Jam Sadap</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">6</td>
                                <td>Cup Lump</td>
                                <td class="number">
                                    <span t-esc="'%.0f' % (doc.total_stock_weight or 0.0)"/>
                                </td>
                                <td/>
                                <td class="number">
                                    <span t-esc="'%.0f' % (doc.total_stock_weight or 0.0)"/>
                                </td>
                                <td/><td/><td/><td/>
                                <td>
                                    <span t-if="doc.total_bag">
                                        <span t-esc="doc.total_bag"/> krg.
                                    </span>
                                </td>
                                <td class="note-label-cell">- Jam Pungut</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">7</td>
                                <td>Total</td>
                                <td class="number">
                                    <span t-esc="'%.0f' % (doc.total_stock_weight or 0.0)"/>
                                </td>
                                <td/>
                                <td class="number">
                                    <span t-esc="'%.0f' % (doc.total_stock_weight or 0.0)"/>
                                </td>
                                <td/><td/><td/><td/>
                                <td>
                                    <span t-if="doc.total_bag">
                                        <span t-esc="doc.total_bag"/> krg.
                                    </span>
                                </td>
                                <td class="note-label-cell">- Cuaca</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">8</td>
                                <td>Prod Per Tapp</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell">Total HK Maju</td>
                                <td class="note-value-cell"/>
                            </tr>
                            <tr>
                                <td class="center">9</td>
                                <td>Prod Latex VS Off grade</td>
                                <td/><td/><td/><td/><td/><td/><td/><td/>
                                <td class="note-label-cell"/>
                                <td class="note-value-cell"/>
                            </tr>
                        </tbody>
                    </table>

                    <table class="signature-table">
                        <tr>
                            <td>Dikirim Oleh,</td>
                            <td>Diperiksa Oleh,</td>
                            <td>Diketahui Oleh,</td>
                            <td>Penerima</td>
                            <td>Driver</td>
                        </tr>
                        <tr>
                            <td class="signature-space"/>
                            <td class="signature-space"/>
                            <td class="signature-space"/>
                            <td class="signature-space"/>
                            <td class="signature-space"/>
                        </tr>
                        <tr>
                            <td>( <span class="signature-name"></span> )</td>
                            <td>( <span class="signature-name"></span> )</td>
                            <td>( <span class="signature-name"></span> )</td>
                            <td>( <span class="signature-name"></span> )</td>
                            <td>( <span class="signature-name"></span> )</td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="report_production_receipt_slip_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-call="web.external_layout">
                    <t t-set="uom_name" t-value="doc.product_id.uom_id.name or ''"/>
                    <div class="page wt-production-receipt-slip">
                        <style>
                            .wt-production-receipt-slip {
                                color: #111827;
                                font-size: 11px;
                                line-height: 1.35;
                            }
                            .wt-production-receipt-slip .header-grid {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 20px;
                            }
                            .wt-production-receipt-slip .header-grid td {
                                vertical-align: top;
                            }
                            .wt-production-receipt-slip .document-title {
                                font-size: 22px;
                                font-weight: 700;
                                letter-spacing: .5px;
                                margin: 0 0 8px;
                                text-transform: uppercase;
                                text-align: right;
                            }
                            .wt-production-receipt-slip .company-logo {
                                max-height: 96px;
                                max-width: 340px;
                            }
                            .wt-production-receipt-slip .document-number {
                                padding: 0;
                                text-align: right;
                            }
                            .wt-production-receipt-slip .document-number .label {
                                color: #4b5563;
                                font-size: 10px;
                                text-transform: uppercase;
                            }
                            .wt-production-receipt-slip .document-number .value {
                                font-size: 17px;
                                font-weight: 700;
                            }
                            .wt-production-receipt-slip .section-title {
                                background: #111827;
                                color: #fff;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: .3px;
                                margin-top: 12px;
                                padding: 8px 12px;
                                text-transform: uppercase;
                            }
                            .wt-production-receipt-slip .info-table {
                                width: 100%;
                                border-collapse: collapse;
                                border: 1px solid #d1d5db;
                            }
                            .wt-production-receipt-slip .info-table td {
                                border: 1px solid #d1d5db;
                                line-height: 1.55;
                                padding: 10px 16px !important;
                                vertical-align: top;
                            }
                            .wt-production-receipt-slip .info-label {
                                background: #f3f4f6;
                                color: #374151;
                                font-weight: 700;
                                width: 16%;
                            }
                            .wt-production-receipt-slip .info-value {
                                width: 34%;
                            }
                            .wt-production-receipt-slip .summary-grid {
                                width: 100%;
                                border-collapse: separate;
                                border-spacing: 0 8px;
                                margin-top: 4px;
                            }
                            .wt-production-receipt-slip .summary-card {
                                border: 1px solid #d1d5db;
                                line-height: 1.45;
                                padding: 12px 16px !important;
                                width: 20%;
                            }
                            .wt-production-receipt-slip .summary-label {
                                color: #6b7280;
                                font-size: 9px;
                                padding-left: 2px;
                                padding-right: 2px;
                                text-transform: uppercase;
                            }
                            .wt-production-receipt-slip .summary-value {
                                font-size: 16px;
                                font-weight: 700;
                                margin-top: 2px;
                                padding-left: 2px;
                                padding-right: 2px;
                            }
                            .wt-production-receipt-slip .control-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 0;
                                table-layout: fixed;
                            }
                            .wt-production-receipt-slip .control-table th {
                                background: #f3f4f6;
                                border: 1px solid #9ca3af;
                                font-size: 10px;
                                font-weight: 700;
                                line-height: 1.35;
                                padding: 9px 10px !important;
                                text-align: center;
                                vertical-align: middle;
                            }
                            .wt-production-receipt-slip .control-table td {
                                border: 1px solid #d1d5db;
                                line-height: 1.45;
                                padding: 9px 11px !important;
                                vertical-align: top;
                            }
                            .wt-production-receipt-slip .control-table td.text-right {
                                padding-left: 10px !important;
                                padding-right: 16px !important;
                                white-space: nowrap;
                            }
                            .wt-production-receipt-slip .total-row td {
                                background: #f9fafb;
                                font-weight: 700;
                            }
                            .wt-production-receipt-slip .text-right {
                                text-align: right;
                            }
                            .wt-production-receipt-slip .text-center {
                                text-align: center;
                            }
                            .wt-production-receipt-slip .muted {
                                color: #6b7280;
                            }
                            .wt-production-receipt-slip .audit-note {
                                border: 1px solid #d1d5db;
                                min-height: 64px;
                                padding: 10px;
                            }
                            .wt-production-receipt-slip .signature-table {
                                width: 100%;
                                margin-top: 18px;
                                border-collapse: collapse;
                                table-layout: fixed;
                            }
                            .wt-production-receipt-slip .signature-table td {
                                text-align: center;
                                vertical-align: bottom;
                            }
                            .wt-production-receipt-slip .signature-space {
                                height: 48px;
                            }
                            .wt-production-receipt-slip .signature-name {
                                display: inline-block;
                                min-width: 100px;
                                border-bottom: 1px dotted #333;
                            }
                        </style>

                        <table class="header-grid">
                            <tr>
                                <td style="width: 45%;">
                                    <t t-if="doc.company_id.logo">
                                        <img class="company-logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                                    </t>
                                    <t t-else="">
                                        <strong t-esc="doc.company_id.name"/>
                                    </t>
                                </td>
                                <td style="width: 55%;">
                                    <h2 class="document-title">Production Receipt Slip</h2>
                                    <div class="document-number">
                                        <div class="label">Nomor Dokumen</div>
                                        <div class="value" t-esc="doc.name"/>
                                        <div style="margin-top: 5px;">
                                            <span class="label">Tanggal Cetak</span>
                                            <strong t-esc="time.strftime('%d/%m/%Y')"/>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <div class="section-title">Scope Penerimaan</div>
                        <table class="info-table">
                            <tr>
                                <td class="info-label">Perusahaan</td>
                                <td class="info-value"><span t-esc="doc.company_id.name"/></td>
                                <td class="info-label">Produk</td>
                                <td class="info-value"><span t-esc="doc.product_id.display_name"/></td>
                            </tr>
                            <tr>
                                <td class="info-label">Estate</td>
                                <td class="info-value"><span t-esc="doc.division_id.estate_id.name"/></td>
                                <td class="info-label">Tanggal Produksi</td>
                                <td class="info-value"><span t-field="doc.production_date"/></td>
                            </tr>
                            <tr>
                                <td class="info-label">Divisi</td>
                                <td class="info-value"><span t-esc="doc.division_id.name"/></td>
                                <td class="info-label">Tanggal Penerimaan</td>
                                <td class="info-value"><span t-field="doc.received_date"/></td>
                            </tr>
                            <tr>
                                <td class="info-label">Kerani</td>
                                <td class="info-value"><span t-esc="doc.clerk_employee_id.name"/></td>
                                <td class="info-label">Gudang</td>
                                <td class="info-value"><span t-esc="doc.warehouse_id.display_name"/></td>
                            </tr>
                            <tr>
                                <td class="info-label">Filter Operation Type</td>
                                <td class="info-value">
                                    <span t-if="doc.operation_type_id" t-esc="doc.operation_type_id.display_name"/>
                                    <span t-else="" class="muted">Semua operation type di gudang</span>
                                </td>
                                <td class="info-label">Filter Lokasi</td>
                                <td class="info-value">
                                    <span t-if="doc.location_id" t-esc="doc.location_id.display_name"/>
                                    <span t-else="" class="muted">Semua lokasi penerimaan di gudang</span>
                                </td>
                            </tr>
                        </table>

                        <div class="section-title">Ringkasan Penerimaan Produksi</div>
                        <table class="summary-grid">
                            <tr>
                                <td class="summary-card">
                                    <div class="summary-label">Total Penimbangan</div>
                                    <div class="summary-value" t-esc="doc.total_weighing"/>
                                </td>
                                <td class="summary-card">
                                    <div class="summary-label">Total Karung</div>
                                    <div class="summary-value" t-esc="doc.total_bag"/>
                                </td>
                                <td class="summary-card">
                                    <div class="summary-label">Total Berat</div>
                                    <div class="summary-value">
                                        <span t-esc="'%.2f' % (doc.total_stock_weight or 0.0)"/>
                                        <span t-esc="uom_name"/>
                                    </div>
                                </td>
                                <td class="summary-card">
                                    <div class="summary-label">Inventory Receipt</div>
                                    <div class="summary-value" t-esc="doc.stock_picking_count"/>
                                </td>
                                <td class="summary-card">
                                    <div class="summary-label">Lot</div>
                                    <div class="summary-value" t-esc="doc.lot_count"/>
                                </td>
                            </tr>
                        </table>

                        <div class="section-title">Inventory Receipt &amp; Lot</div>
                        <table class="control-table">
                            <thead>
                                <tr>
                                    <th style="width: 5%;">No</th>
                                    <th style="width: 22%;">Inventory Receipt</th>
                                    <th style="width: 20%;">Operation Type</th>
                                    <th style="width: 23%;">Lokasi Penerimaan</th>
                                    <th style="width: 18%;">Lot</th>
                                    <th style="width: 12%;">Berat</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="doc.stock_picking_ids">
                                    <t t-foreach="doc.stock_picking_ids" t-as="picking">
                                        <tr>
                                            <td class="text-center" t-esc="picking_index + 1"/>
                                            <td>
                                                <span t-esc="picking.name"/>
                                                <div class="muted" t-if="picking.date_done">
                                                    Done: <span t-field="picking.date_done"/>
                                                </div>
                                            </td>
                                            <td><span t-esc="picking.picking_type_id.display_name"/></td>
                                            <td><span t-esc="picking.location_dest_id.display_name"/></td>
                                            <td>
                                                <span t-esc="', '.join(picking.move_line_ids.mapped('lot_id.name'))"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="'%.2f' % sum(picking.move_ids.mapped('product_uom_qty'))"/>
                                                <span t-esc="uom_name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <tr t-if="doc.stock_picking_ids" class="total-row">
                                    <td colspan="5" class="text-right">Total</td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % sum(doc.stock_picking_ids.mapped('move_ids.product_uom_qty'))"/>
                                        <span t-esc="uom_name"/>
                                    </td>
                                </tr>
                                <tr t-if="not doc.stock_picking_ids">
                                    <td colspan="6" class="text-center muted">Belum ada Inventory Receipt.</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="section-title">Detail Penimbangan</div>
                        <table class="control-table">
                            <thead>
                                <tr>
                                    <th style="width: 4%;">No</th>
                                    <th style="width: 13%;">Nomor Timbang</th>
                                    <th style="width: 13%;">Lokasi Timbang</th>
                                    <th style="width: 12%;">Mandor</th>
                                    <th style="width: 12%;">Tapper</th>
                                    <th style="width: 14%;">Inventory Receipt</th>
                                    <th style="width: 12%;">Lot</th>
                                    <th style="width: 8%;">Karung</th>
                                    <th style="width: 12%;">Berat</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="doc.line_ids">
                                    <t t-foreach="doc.line_ids" t-as="line">
                                        <tr>
                                            <td class="text-center" t-esc="line_index + 1"/>
                                            <td><span t-esc="line.weighing_id.name"/></td>
                                            <td><span t-esc="line.weighing_location_id.display_name"/></td>
                                            <td><span t-esc="line.foreman_employee_id.name"/></td>
                                            <td><span t-esc="line.tapper_employee_id.name"/></td>
                                            <td><span t-esc="line.stock_picking_id.name"/></td>
                                            <td><span t-esc="line.lot_id.name"/></td>
                                            <td class="text-right"><span t-esc="line.total_bag"/></td>
                                            <td class="text-right">
                                                <span t-esc="'%.2f' % (line.stock_weight or 0.0)"/>
                                                <span t-esc="uom_name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <tr t-if="doc.line_ids" class="total-row">
                                    <td colspan="7" class="text-right">Total</td>
                                    <td class="text-right"><span t-esc="doc.total_bag"/></td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % (doc.total_stock_weight or 0.0)"/>
                                        <span t-esc="uom_name"/>
                                    </td>
                                </tr>
                                <tr t-if="not doc.line_ids">
                                    <td colspan="9" class="text-center muted">Belum ada data penimbangan.</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="section-title">Catatan Penerimaan Produksi</div>
                        <div class="audit-note">
                            <span t-if="doc.note" t-esc="doc.note"/>
                            <span t-else=""></span>
                        </div>

                        <table class="signature-table">
                            <tr>
                                <td>Dikirim Oleh,</td>
                                <td>Diperiksa Oleh,</td>
                                <td>Diketahui Oleh,</td>
                                <td>Penerima</td>
                                <td>Driver</td>
                            </tr>
                            <tr>
                                <td class="signature-space"/>
                                <td class="signature-space"/>
                                <td class="signature-space"/>
                                <td class="signature-space"/>
                                <td class="signature-space"/>
                            </tr>
                            <tr>
                                <td>( <span class="signature-name"></span> )</td>
                                <td>( <span class="signature-name"></span> )</td>
                                <td>( <span class="signature-name"></span> )</td>
                                <td>( <span class="signature-name"></span> )</td>
                                <td>( <span class="signature-name"></span> )</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
