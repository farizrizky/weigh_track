<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_device_state_reason_wizard_form" model="ir.ui.view">
        <field name="name">wt.device.state.reason.wizard.form</field>
        <field name="model">wt.device.state.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason">
                <sheet>
                    <group>
                        <field name="device_id"/>
                        <field name="action" invisible="1"/>
                        <field name="reason" placeholder="Reason" required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
