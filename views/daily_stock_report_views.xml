<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_daily_stock_report_form" model="ir.ui.view">
        <field name="name">wt.daily.stock.report.form</field>
        <field name="model">wt.daily.stock.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Stock Harian" edit="0" delete="0">
                <header>
                    <button name="action_open_filter" type="object" string="Filter" class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Export PDF" class="btn-secondary" invisible="not is_filtered"/>
                    <button name="action_export_excel" type="object" string="Export Excel" class="btn-secondary" invisible="not is_filtered"/>
                </header>
                <sheet>
                    <field name="is_filtered" invisible="1"/>
                    <field name="matrix_data_json" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" invisible="is_filtered">
                        Silakan klik tombol Filter untuk menampilkan laporan pada satu tanggal.
                    </div>
                    <group invisible="not is_filtered">
                        <group string="Periode">
                            <field name="company_id"/>
                            <field name="report_date"/>
                            <field name="month_start_date"/>
                        </group>
                        <group string="Ringkasan">
                            <field name="opening_stock"/>
                            <field name="total_weighing"/>
                            <field name="total_sales"/>
                            <field name="total_shrinkage"/>
                            <field name="closing_stock"/>
                        </group>
                    </group>
                    <field name="preview_html" widget="html" nolabel="1" readonly="1" invisible="not is_filtered"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_daily_stock_report" model="ir.actions.act_window">
        <field name="name">Laporan Stock Harian</field>
        <field name="res_model">wt.daily.stock.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_daily_stock_report_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <record id="view_wt_daily_stock_report_wizard_form" model="ir.ui.view">
        <field name="name">wt.daily.stock.report.wizard.form</field>
        <field name="model">wt.daily.stock.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Laporan Stock Harian">
                <sheet>
                    <field name="report_id" invisible="1"/>
                    <group>
                        <field name="company_id" required="1"/>
                        <field name="report_date" required="1"/>
                    </group>
                    <div class="text-muted">
                        Nilai sampai dengan hari ini dihitung sejak tanggal pertama pada bulan yang sama.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply_filter" type="object" string="Terapkan Filter" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
