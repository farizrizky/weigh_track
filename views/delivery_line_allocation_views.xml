<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_delivery_do_lot_allocation_popup" model="ir.ui.view">
        <field name="name">wt.delivery.do.line.lot.allocation.popup</field>
        <field name="model">wt.delivery.do.line.lot</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Difference Allocation">
                <sheet>
                    <field name="delivery_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="wt_is_fully_allocated" invisible="1"/>
                    <field name="wt_difference_qty" invisible="1"/>
                    <field name="wt_adjustment_applied" invisible="1"/>

                    <div class="alert alert-warning" role="alert"
                         invisible="not wt_adjustment_applied">
                         <i class="fa fa-lock me-1"/>
                         Adjustment sudah diterapkan - alokasi tidak dapat diubah lagi.
                    </div>

                    <group>
                        <group string="Lot Information">
                            <field name="product_id" readonly="1"/>
                            <field name="lot_id" readonly="1"/>
                        </group>
                        <group string="Qty">
                            <field name="wt_original_qty" readonly="1" string="Planned Demand (kg)"/>
                            <field name="qty" readonly="1" string="Demand DO (kg)"/>
                            <field name="wt_physical_qty" readonly="1" string="Physical Weight (kg)"/>
                            <field name="wt_difference_qty" readonly="1" string="Difference (kg)"/>
                            <field name="wt_allocated_qty" readonly="1" string="Allocated Qty"/>
                            <field name="wt_unallocated_qty" readonly="1" string="Unallocated Qty"
                                   decoration-danger="wt_unallocated_qty &gt; 0.001"
                                   decoration-success="wt_unallocated_qty &lt;= 0.001"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert"
                         invisible="wt_difference_qty != 0">
                        <i class="fa fa-info-circle me-1"/>
                        Lot ini tidak memiliki selisih - alokasi tidak diperlukan.
                    </div>

                    <div class="alert alert-success" role="alert"
                         invisible="not wt_is_fully_allocated or wt_difference_qty == 0">
                        <i class="fa fa-check-circle me-1"/>
                        Selisih sudah teralokasi penuh.
                    </div>

                    <div class="alert alert-info" role="alert"
                         invisible="wt_is_fully_allocated or wt_difference_qty == 0">
                        <i class="fa fa-info-circle me-1"/>
                        Alokasikan semua selisih yang ada.
                    </div>

                    <field name="wt_allocation_ids"
                           readonly="wt_difference_qty == 0 or wt_adjustment_applied"
                           context="{'default_do_lot_line_id': id}"
                           nolabel="1">
                        <list editable="bottom">
                            <field name="reason_id"/>
                            <field name="qty" string="Allocation Qty"/>
                            <field name="uom_id" readonly="1" string="Unit"/>
                            <field name="location_dest_id" string="Destination Location"
                                   domain="[('usage', 'not in', ['view'])]"/>
                            <field name="note" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"
                            invisible="wt_difference_qty == 0 or wt_adjustment_applied"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
