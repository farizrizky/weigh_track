<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_daily_stock_analysis_search" model="ir.ui.view">
        <field name="name">wt.daily.stock.analysis.search</field>
        <field name="model">wt.daily.stock.analysis</field>
        <field name="arch" type="xml">
            <search string="Data Analitik Stock Harian">
                <field name="report_date"/>
                <field name="company_id"/>
                <field name="estate_id"/>
                <field name="division_id"/>
                <field name="product_id"/>
                <field name="scope_type"/>
                <filter string="Tanggal" name="group_report_date" context="{'group_by': 'report_date:day'}"/>
                <filter string="Estate" name="group_estate" context="{'group_by': 'estate_id'}"/>
                <filter string="Divisi" name="group_division" context="{'group_by': 'division_id'}"/>
                <group>
                    <filter string="Perusahaan" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Produk" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Tipe Lingkup" name="group_scope_type" context="{'group_by': 'scope_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wt_daily_stock_analysis_refresh_wizard_form" model="ir.ui.view">
        <field name="name">wt.daily.stock.analysis.refresh.wizard.form</field>
        <field name="model">wt.daily.stock.analysis.refresh.wizard</field>
        <field name="arch" type="xml">
            <form string="Hitung Ulang Data Dashboard">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_refresh" type="object" string="Hitung Ulang" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wt_daily_stock_analysis_refresh" model="ir.actions.act_window">
        <field name="name">Hitung Ulang Data Dashboard</field>
        <field name="res_model">wt.daily.stock.analysis.refresh.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wt_daily_stock_analysis_refresh_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="view_wt_daily_stock_analysis_list" model="ir.ui.view">
        <field name="name">wt.daily.stock.analysis.list</field>
        <field name="model">wt.daily.stock.analysis</field>
        <field name="arch" type="xml">
            <list string="Data Analitik Stock Harian" create="0" edit="0" delete="0">
                <header>
                    <button name="%(action_wt_daily_stock_analysis_refresh)d"
                            type="action"
                            string="Filter"
                            icon="fa-filter"
                            class="btn-primary"
                            display="always"/>
                </header>
                <field name="report_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="estate_id"/>
                <field name="division_id"/>
                <field name="scope_name"/>
                <field name="product_id" optional="hide"/>
                <field name="opening_stock" sum="Total"/>
                <field name="weighing_qty" sum="Total"/>
                <field name="sales_qty" sum="Total"/>
                <field name="storage_shrinkage_qty" sum="Total"/>
                <field name="closing_stock" sum="Total"/>
                <field name="balance_difference" sum="Total" optional="hide"/>
                <field name="computed_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wt_daily_stock_analysis_pivot" model="ir.ui.view">
        <field name="name">wt.daily.stock.analysis.pivot</field>
        <field name="model">wt.daily.stock.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Analisis Stock Harian" sample="1">
                <field name="estate_id" type="row"/>
                <field name="division_id" type="row"/>
                <field name="scope_name" type="row"/>
                <field name="report_date" type="col" interval="day"/>
                <field name="opening_stock" type="measure"/>
                <field name="weighing_qty" type="measure"/>
                <field name="sales_qty" type="measure"/>
                <field name="storage_shrinkage_qty" type="measure"/>
                <field name="closing_stock" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_wt_daily_stock_analysis_graph" model="ir.ui.view">
        <field name="name">wt.daily.stock.analysis.graph</field>
        <field name="model">wt.daily.stock.analysis</field>
        <field name="arch" type="xml">
            <graph string="Tren Stock Harian" type="line" sample="1">
                <field name="report_date" interval="day"/>
                <field name="weighing_qty" type="measure"/>
                <field name="sales_qty" type="measure"/>
                <field name="closing_stock" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_wt_daily_stock_analysis_form" model="ir.ui.view">
        <field name="name">wt.daily.stock.analysis.form</field>
        <field name="model">wt.daily.stock.analysis</field>
        <field name="arch" type="xml">
            <form string="Data Analitik Stock Harian" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="report_date"/>
                            <field name="company_id"/>
                            <field name="product_id"/>
                            <field name="computed_at"/>
                        </group>
                        <group>
                            <field name="estate_id"/>
                            <field name="division_id"/>
                            <field name="scope_name"/>
                            <field name="scope_type"/>
                        </group>
                    </group>
                    <group string="Nilai Harian">
                        <group>
                            <field name="opening_stock"/>
                            <field name="weighing_qty"/>
                            <field name="sales_qty"/>
                            <field name="closing_stock"/>
                        </group>
                        <group>
                            <field name="storage_shrinkage_qty"/>
                            <field name="balance_difference"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wt_daily_stock_analysis" model="ir.actions.act_window">
        <field name="name">Data Analitik Stock Harian</field>
        <field name="res_model">wt.daily.stock.analysis</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_wt_daily_stock_analysis_search"/>
        <field name="context">{'search_default_group_report_date': 1}</field>
    </record>
</odoo>
