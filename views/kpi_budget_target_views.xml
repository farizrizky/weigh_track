<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_kpi_budget_target_search" model="ir.ui.view">
        <field name="name">wt.kpi.budget.target.search</field>
        <field name="model">wt.kpi.budget.target</field>
        <field name="arch" type="xml">
            <search string="Budget Target">
                <field name="name"/>
                <field name="year"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Tahun Ini" name="current_year"
                    domain="[('year', '=', context_today().year)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Valid" name="valid" domain="[('state', '=', 'valid')]"/>
                <separator/>
                <filter string="Tahun" name="group_by_year"
                    context="{'group_by': 'year'}"/>
                <filter string="Perusahaan" name="group_by_company"
                    context="{'group_by': 'company_id'}"
                    groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="view_wt_kpi_budget_target_list" model="ir.ui.view">
        <field name="name">wt.kpi.budget.target.list</field>
        <field name="model">wt.kpi.budget.target</field>
        <field name="arch" type="xml">
            <list string="Budget Target" default_order="year desc, create_date desc, id desc">
                <field name="name"/>
                <field name="year" options="{'enable_formatting': False}"/>
                <field name="create_date" string="Created Date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'valid'"/>
            </list>
        </field>
    </record>

    <record id="view_wt_kpi_budget_target_form" model="ir.ui.view">
        <field name="name">wt.kpi.budget.target.form</field>
        <field name="model">wt.kpi.budget.target</field>
        <field name="arch" type="xml">
            <form string="Budget Target">
                <header>
                    <button name="action_validate" string="Validasi"
                        type="object" class="btn-primary"
                        invisible="state != 'draft' or not id"/>
                    <button name="action_set_draft" string="Reset ke Draft"
                        type="object" class="btn-secondary"
                        invisible="state != 'valid'"/>
                    <button name="action_sync_divisions" string="Sync Divisi"
                        type="object" class="btn-secondary"
                        invisible="state != 'draft' or not id"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,valid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="year" widget="kpi_year_autosave"
                                options="{'enable_formatting': False}"
                                readonly="id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                readonly="id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Target Produksi" name="production_target">
                            <field name="production_target_line_ids"
                                readonly="state == 'valid'"
                                context="{'default_line_type': 'production_target'}">
                                <list editable="bottom" create="0" delete="0"
                                    default_order="division_id asc">
                                    <field name="line_type" column_invisible="True"/>
                                    <field name="division_id" readonly="1"/>
                                    <field name="uom_name" readonly="1"/>
                                    <field name="january"/>
                                    <field name="february"/>
                                    <field name="march"/>
                                    <field name="april"/>
                                    <field name="may"/>
                                    <field name="june"/>
                                    <field name="july"/>
                                    <field name="august"/>
                                    <field name="september"/>
                                    <field name="october"/>
                                    <field name="november"/>
                                    <field name="december"/>
                                </list>
                            </field>
                        </page>

                        <page string="Target Penjualan" name="sales_target">
                            <field name="sales_target_line_ids"
                                readonly="state == 'valid'"
                                context="{'default_line_type': 'sales_target'}">
                                <list editable="bottom" create="0" delete="0"
                                    default_order="division_id asc">
                                    <field name="line_type" column_invisible="True"/>
                                    <field name="division_id" readonly="1"/>
                                    <field name="uom_name" readonly="1"/>
                                    <field name="january"/>
                                    <field name="february"/>
                                    <field name="march"/>
                                    <field name="april"/>
                                    <field name="may"/>
                                    <field name="june"/>
                                    <field name="july"/>
                                    <field name="august"/>
                                    <field name="september"/>
                                    <field name="october"/>
                                    <field name="november"/>
                                    <field name="december"/>
                                </list>
                            </field>
                        </page>

                        <page string="Produksi Terima Pabrik" name="factory_received">
                            <field name="factory_received_line_ids"
                                readonly="state == 'valid'"
                                context="{'default_line_type': 'factory_received'}">
                                <list editable="bottom" create="0" delete="0"
                                    default_order="sequence asc">
                                    <field name="line_type" column_invisible="True"/>
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="month" readonly="1"/>
                                    <field name="uom_name" readonly="1"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>

                        <page string="Produksi Kering" name="dry_production">
                            <field name="dry_production_line_ids"
                                readonly="state == 'valid'"
                                context="{'default_line_type': 'dry_production'}">
                                <list editable="bottom" create="0" delete="0"
                                    default_order="sequence asc">
                                    <field name="line_type" column_invisible="True"/>
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="month" readonly="1"/>
                                    <field name="uom_name" readonly="1"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_kpi_budget_target" model="ir.actions.act_window">
        <field name="name">Budget Target</field>
        <field name="res_model">wt.kpi.budget.target</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_kpi_budget_target_search"/>
    </record>
</odoo>
