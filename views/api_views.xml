<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_api_search" model="ir.ui.view">
        <field name="name">wt.api.search</field>
        <field name="model">wt.api</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="bot_user_id"/>
                <field name="pull_enabled"/>
                <field name="push_enabled"/>
            </search>
        </field>
    </record>

    <record id="view_wt_api_list" model="ir.ui.view">
        <field name="name">wt.api.list</field>
        <field name="model">wt.api</field>
        <field name="arch" type="xml">
            <list string="APIs">
                <field name="company_id"/>
                <field name="bot_user_id"/>
                <field name="pull_enabled"/>
                <field name="push_enabled"/>
            </list>
        </field>
    </record>

    <record id="view_wt_api_form" model="ir.ui.view">
        <field name="name">wt.api.form</field>
        <field name="model">wt.api</field>
        <field name="arch" type="xml">
            <form string="API">
                <sheet>
                    <div class="oe_title">
                        <label for="company_id"/>
                        <h1>
                            <field name="company_id" placeholder="Company"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="bot_user_id" required="1" domain="[('share', '=', False), ('active', '=', True)]"/>
                            <field name="pull_enabled"/>
                            <field name="push_enabled"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_api" model="ir.actions.act_window">
        <field name="name">APIs</field>
        <field name="res_model">wt.api</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_api_search"/>
    </record>
</odoo>
