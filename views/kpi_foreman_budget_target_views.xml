<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wt_kpi_foreman_budget_target_search" model="ir.ui.view">
        <field name="name">wt.kpi.foreman.budget.target.search</field>
        <field name="model">wt.kpi.foreman.budget.target</field>
        <field name="arch" type="xml">
            <search string="Budget Target Mandor">
                <field name="name"/>
                <field name="year"/>
                <field name="budget_target_id"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Valid" name="valid" domain="[('state', '=', 'valid')]"/>
                <separator/>
                <filter string="Tahun" name="group_by_year"
                    context="{'group_by': 'year'}"/>
                <filter string="Status" name="group_by_state"
                    context="{'group_by': 'state'}"/>
                <filter string="Perusahaan" name="group_by_company"
                    context="{'group_by': 'company_id'}"
                    groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="view_wt_kpi_foreman_budget_target_list" model="ir.ui.view">
        <field name="name">wt.kpi.foreman.budget.target.list</field>
        <field name="model">wt.kpi.foreman.budget.target</field>
        <field name="arch" type="xml">
            <list string="Budget Target Mandor" default_order="year desc, id desc">
                <field name="name"/>
                <field name="year" options="{'enable_formatting': False}"/>
                <field name="budget_target_id"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'valid'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="create_uid" string="Created By"/>
                <field name="create_date" string="Created Date"/>
            </list>
        </field>
    </record>

    <record id="view_wt_kpi_foreman_budget_target_form" model="ir.ui.view">
        <field name="name">wt.kpi.foreman.budget.target.form</field>
        <field name="model">wt.kpi.foreman.budget.target</field>
        <field name="arch" type="xml">
            <form string="Budget Target Mandor">
                <header>
                    <button name="action_validate" string="Validasi"
                        type="object" class="btn-primary"
                        invisible="state != 'draft' or not id"/>
                    <button name="action_set_draft" string="Reset ke Draft"
                        type="object" class="btn-secondary"
                        invisible="state != 'valid'"/>
                    <button name="action_sync_foremen" string="Sync Mandor"
                        type="object" class="btn-secondary"
                        invisible="state != 'draft' or not id"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,valid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="year" widget="kpi_year_autosave"
                                options="{'enable_formatting': False}"
                                readonly="id"/>
                            <field name="budget_target_id" readonly="1"
                                options="{'no_create': True, 'no_open': False}"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="id"
                                groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Target Mandor" name="foreman_targets">
                            <field name="foreman_line_ids" readonly="state == 'valid'">
                                <list editable="bottom" create="0" delete="0"
                                    default_order="division_id asc, employee_id asc">
                                    <field name="division_id" readonly="1"/>
                                    <field name="employee_id" readonly="1"/>
                                    <field name="uom_name" readonly="1"/>
                                    <field name="january"/>
                                    <field name="february"/>
                                    <field name="march"/>
                                    <field name="april"/>
                                    <field name="may"/>
                                    <field name="june"/>
                                    <field name="july"/>
                                    <field name="august"/>
                                    <field name="september"/>
                                    <field name="october"/>
                                    <field name="november"/>
                                    <field name="december"/>
                                </list>
                            </field>
                        </page>
                        <page string="Kontrol Budget" name="budget_control">
                            <field name="control_line_ids" readonly="1">
                                <list create="0" edit="0" delete="0"
                                    default_order="division_id asc, sequence asc">
                                    <field name="division_id"/>
                                    <field name="month"/>
                                    <field name="target_production"/>
                                    <field name="total_foreman"/>
                                    <field name="remaining"/>
                                    <field name="allocation_percentage"/>
                                    <field name="allocation_status" widget="badge"
                                        decoration-warning="allocation_status == 'less'"
                                        decoration-success="allocation_status == 'matched'"
                                        decoration-danger="allocation_status == 'over'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wt_kpi_foreman_budget_target" model="ir.actions.act_window">
        <field name="name">Budget Target Mandor</field>
        <field name="res_model">wt.kpi.foreman.budget.target</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wt_kpi_foreman_budget_target_search"/>
    </record>
</odoo>
