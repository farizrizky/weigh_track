<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_inherit_weightrack" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.weightrack</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="wt_lot_type"/>
                <field name="wt_transit_state" widget="badge"
                       decoration-info="wt_transit_state == 'open'"
                       decoration-success="wt_transit_state == 'closed'"
                       invisible="wt_lot_type != 'transit'"/>
                <field name="division_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="production_date"/>
                <field name="wt_receiving_location_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="wt_source_delivery_id" invisible="wt_lot_type != 'transit'"/>
                <field name="wt_source_picking_id" invisible="wt_lot_type != 'transit'"/>
                <field name="wt_transit_date" invisible="wt_lot_type != 'transit'"/>
            </field>
        </field>
    </record>
    <record id="view_production_lot_tree_inherit_weightrack" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit.weightrack</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="wt_lot_type" string="Tipe Lot" optional="show"/>
                <field name="wt_transit_state" string="Status Transit" widget="badge" optional="show"
                       decoration-info="wt_transit_state == 'open'"
                       decoration-success="wt_transit_state == 'closed'"/>
                <field name="wt_receiving_location_id" string="Lokasi Penerimaan" optional="show"/>
                <field name="wt_location_names" string="Lokasi Stok"/>
                <field name="wt_total_qty" string="Stok Tersedia (kg)"/>
            </field>
        </field>
    </record>
</odoo>
