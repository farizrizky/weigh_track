Ref: wt_receipt_rule.weighing_location_id > wt_weighing_location.id [delete: restrict]
Ref: wt_receipt_rule.division_id > wt_division.id [delete: restrict]
Ref: wt_receipt_rule.product_id > product_product.id [delete: restrict]
Ref: wt_receipt_rule.warehouse_id > stock_warehouse.id [delete: restrict]
Ref: wt_receipt_rule.location_id > stock_location.id [delete: restrict]
Ref: wt_receipt_rule.operation_type_id > stock_picking_type.id [delete: restrict]

