Ref: wt_inbound_weighing_product.company_id > res_company.id
Ref: wt_inbound_weighing_product.product_id > product_product.id [delete: restrict]
Ref: wt_inbound_weighing_product.receipt_rule_id > wt_receipt_rule.id [delete: restrict]

Ref: wt_weighing_lump.inbound_product_id > wt_inbound_weighing_product.id [delete: cascade]
Ref: wt_weighing_lump.inbound_weighing_id > wt_inbound_weighing.id
Ref: wt_weighing_lump.device_record_id > wt_device.id [delete: restrict]
Ref: wt_weighing_lump.company_id > res_company.id
Ref: wt_weighing_lump.estate_id > wt_estate.id [delete: restrict]
Ref: wt_weighing_lump.weighing_location_id > wt_weighing_location.id [delete: restrict]
Ref: wt_weighing_lump.division_id > wt_division.id [delete: restrict]
Ref: wt_weighing_lump.product_id > product_product.id [delete: restrict]
Ref: wt_weighing_lump.receipt_rule_id > wt_receipt_rule.id [delete: restrict]
Ref: wt_weighing_lump.uom_id > uom_uom.id [delete: restrict]
Ref: wt_weighing_lump.operator_employee_id > hr_employee.id [delete: restrict]
Ref: wt_weighing_lump.clerk_employee_id > hr_employee.id [delete: restrict]
Ref: wt_weighing_lump.foreman_id > wt_foreman.id [delete: restrict]
Ref: wt_weighing_lump.foreman_employee_id > hr_employee.id [delete: restrict]
Ref: wt_weighing_lump.tapper_id > wt_tapper.id [delete: restrict]
Ref: wt_weighing_lump.tapper_employee_id > hr_employee.id [delete: restrict]
Ref: wt_weighing_lump.initial_device_employee_id > hr_employee.id [delete: restrict]

Ref: wt_api.company_id > res_company.id
Ref: wt_api.bot_user_id > res_users.id [delete: restrict]

Ref: wt_api_request_log.device_record_id > wt_device.id
Ref: wt_api_request_log.company_id > res_company.id
Ref: wt_api_request_log.employee_id > hr_employee.id

Ref: wt_division.estate_id > wt_estate.id [delete: restrict]
Ref: wt_division.company_id > res_company.id
Ref: wt_division.clerk_id > hr_employee.id [delete: restrict]

Ref: wt_weighing_location.estate_id > wt_estate.id [delete: restrict]
Ref: wt_weighing_location.company_id > res_company.id
Ref: wt_weighing_location.operator_id > hr_employee.id [delete: restrict]

Ref: wt_weighing_location_division_rel.weighing_location_id > wt_weighing_location.id
Ref: wt_weighing_location_division_rel.division_id > wt_division.id

Ref: wt_foreman.employee_id > hr_employee.id [delete: restrict]
Ref: wt_foreman.division_id > wt_division.id [delete: restrict]
Ref: wt_foreman.company_id > res_company.id

Ref: wt_tapper.employee_id > hr_employee.id [delete: restrict]
Ref: wt_tapper.division_id > wt_division.id [delete: restrict]
Ref: wt_tapper.foreman_id > wt_foreman.id [delete: restrict]
Ref: wt_tapper.company_id > res_company.id

Ref: wt_device.company_id > res_company.id
Ref: wt_device.employee_id > hr_employee.id [delete: restrict]
Ref: wt_device.blocked_by > res_users.id [delete: restrict]
Ref: wt_device.reactivated_by > res_users.id [delete: restrict]
Ref: wt_device.revoked_by > res_users.id [delete: restrict]

Ref: wt_device_state_reason_wizard.device_id > wt_device.id

Ref: hr_employee.company_id > res_company.id
Ref: hr_employee.job_id > hr_job.id
Ref: hr_job.company_id > res_company.id
Ref: stock_warehouse.company_id > res_company.id
Ref: stock_location.company_id > res_company.id
Ref: stock_picking_type.company_id > res_company.id
Ref: stock_picking_type.warehouse_id > stock_warehouse.id
Ref: product_product.company_id > res_company.id

Ref: wt_estate.create_uid > res_users.id
Ref: wt_estate.write_uid > res_users.id
Ref: wt_weather.create_uid > res_users.id
Ref: wt_weather.write_uid > res_users.id
Ref: wt_weather_data.create_uid > res_users.id
Ref: wt_weather_data.write_uid > res_users.id
Ref: wt_employee_role.create_uid > res_users.id
Ref: wt_employee_role.write_uid > res_users.id
Ref: wt_product.create_uid > res_users.id
Ref: wt_product.write_uid > res_users.id
