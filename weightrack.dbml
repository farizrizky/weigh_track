// WeighTrack DBML for dbdiagram.io / db.io
// Source: custom-addons/weightrack/models/*.py
// Notes:
// - Odoo model table names use dot-to-underscore conversion.
// - Only stored database fields are modeled here.
// - Non-stored computed helper fields such as allowed_*_employee_ids are omitted.
// - One2many fields are represented by the inverse Many2one relation.
// - Abstract service models are not represented because they do not create tables.

Project WeighTrack {
  database_type: "PostgreSQL"
  Note: "Generated from Odoo custom module models. Current API scope includes device activation, pull master, push weighing, Production Receipt validation, and Inventory Receipt creation from validated Production Receipt."
}

Enum wt_employee_role {
  operator
  clerk
  foreman
  tapper
}

Enum wt_device_role {
  operator
}

Enum wt_weighing_location_type {
  warehouse
  field
}

Enum wt_device_status {
  inactive
  active
  blocked
  revoked
}

Enum wt_device_type {
  mobile
  desktop
}

Enum wt_api_request_status {
  success
  failed
}

Enum wt_device_state_reason_action {
  block
  revoke
}

Enum wt_weighing_state {
  not_receipted
  in_production_receipt
  receipt_validated
  receipt_cancelled
}

Enum wt_data_source {
  manual
  api
}

Enum wt_production_receipt_state {
  draft
  processed
  validated
  cancelled
}

Enum wt_data_problem_code {
  none
  company_mismatch
  estate_mismatch
  operator_mismatch
  weighing_location_mismatch
  division_not_allowed
  receipt_rule_mismatch
  product_mapping_mismatch
  clerk_mismatch
  foreman_mismatch
  tapper_mismatch
  weight_formula_mismatch
  initial_weighing_date_mismatch
  initial_weight_mismatch
  shrinkage_tolerance_mismatch
  inactive_master
  missing_master
  multiple_problem
}

Table res_users {
  id integer [pk]
  name varchar
  active boolean
  share boolean

  Note: "Odoo core table stub, included only for audit and bot user references. Bot user must be active internal user: active=true, share=false."
}

Table res_company {
  id integer [pk]
  name varchar

  Note: "Odoo core table stub."
}

Table hr_employee {
  id integer [pk]
  name varchar
  barcode varchar
  company_id integer
  job_id integer

  Note: "Odoo HR table stub. barcode is used in device activation response."
}

Table hr_job {
  id integer [pk]
  name varchar
  company_id integer

  Note: "Odoo HR job table stub."
}

Table stock_warehouse {
  id integer [pk]
  code varchar
  name varchar
  company_id integer
  estate_id integer

  indexes {
    estate_id
  }

  Note: "Odoo stock warehouse table stub extended by WeighTrack with estate_id."
}

Table stock_location {
  id integer [pk]
  name varchar
  company_id integer

  Note: "Odoo stock location table stub."
}

Table stock_picking_type {
  id integer [pk]
  name varchar
  code varchar
  warehouse_id integer
  company_id integer

  Note: "Odoo stock operation type table stub."
}

Table stock_lot {
  id integer [pk]
  name varchar
  product_id integer
  company_id integer

  Note: "Odoo stock lot/serial table stub."
}

Table stock_picking {
  id integer [pk]
  name varchar
  picking_type_id integer
  location_id integer
  location_dest_id integer
  company_id integer

  Note: "Odoo stock picking table stub."
}

Table product_product {
  id integer [pk]
  display_name varchar
  company_id integer

  Note: "Odoo product variant table stub. Company can be empty for global products."
}

Table uom_uom {
  id integer [pk]
  name varchar

  Note: "Odoo UoM table stub."
}

Table wt_estate {
  id integer [pk, increment]
  code varchar [not null, note: "Indexed in Odoo"]
  name varchar [not null]
  company_id integer [not null]
  active boolean [not null, default: true]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    code
    company_id
    // Partial unique index in PostgreSQL: WHERE active
    (code, company_id) [unique, name: "wt_estate_code_company_active_uniq"]
  }

  Note: "Odoo model: wt.estate. Order: code, name. Archive supported through active. Business key is unique only for active records."
}

Table wt_weather {
  id integer [pk, increment]
  name varchar [not null, note: "Indexed in Odoo"]
  description text
  active boolean [not null, default: true]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    name
  }

  Note: "Odoo model: wt.weather. Simple weather master with name and description. Archive supported through active."
}

Table wt_weather_data {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from date, estate, and weather. Stored for display/search; hidden on the form view."]
  weather_date date [not null, note: "Indexed in Odoo"]
  estate_id integer [not null]
  company_id integer [not null]
  weather_id integer [not null]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    weather_date
    estate_id
    company_id
    weather_id
    (estate_id, weather_date) [unique, name: "estate_date_uniq"]
  }

  Note: "Odoo model: wt.weather.data. Daily weather data per estate. Form starts from weather_date; computed name is hidden."
}

Table wt_employee_role {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from company, role, and job position"]
  company_id integer [not null]
  role wt_employee_role [not null]
  job_id integer [note: "Required by Python constraint"]
  active boolean [not null, default: true]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    role
    job_id
    // Partial unique index in PostgreSQL: WHERE active
    (company_id, role, job_id) [unique, name: "wt_employee_role_company_role_job_active_uniq"]
  }

  Note: "Odoo model: wt.employee.role. Role source for Operator, Clerk, Foreman, and Tapper employee validation. Archive supported through active. Business key is unique only for active records."
}

Table wt_product {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from company and product"]
  company_id integer [not null]
  product_id integer [not null]
  active boolean [not null, default: true]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    product_id
    // Partial unique index in PostgreSQL: WHERE active
    (company_id) [unique, name: "wt_product_company_active_uniq"]
  }

  Note: "Odoo model: wt.product. Company-level mapping to the single active Odoo product.product used by WeighTrack. Product must belong to the same company or be global. Archive supported through active. Business key is unique only for active records."
}

Table wt_shrinkage_tolerance {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from company and division. Stored for display/search; hidden on the form view."]
  company_id integer [not null]
  division_id integer [not null]
  shrinkage_tolerance_percentage decimal [not null]
  active boolean [not null, default: true]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    division_id
    // Partial unique index in PostgreSQL: WHERE active
    (company_id, division_id) [unique, name: "wt_shrinkage_tolerance_company_division_active_uniq"]
  }

  Note: "Odoo model: wt.shrinkage.tolerance. Defines maximum production shrinkage tolerance per company and division when production date differs from warehouse weighing date. Form starts from company_id; computed name is hidden. Archive supported through active. Business key is unique only for active records."
}

Table wt_receipt_rule {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from weighing location and division"]
  company_id integer [not null]
  estate_id integer [not null, note: "Stored related field from weighing_location_id.estate_id"]
  weighing_location_id integer [not null]
  division_id integer [not null]
  warehouse_id integer [not null]
  location_id integer [not null]
  operation_type_id integer [not null]
  active boolean [not null, default: true]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    estate_id
    weighing_location_id
    division_id
    warehouse_id
    location_id
    operation_type_id
    // Partial unique index in PostgreSQL: WHERE active
    (weighing_location_id, division_id) [unique, name: "wt_receipt_rule_scope_active_uniq"]
  }

  Note: "Odoo model: wt.receipt.rule. Defines the stock receiving route for a weighing location and division: warehouse, internal receiving location, and operation type. Receiving location must be under the selected warehouse. Estate follows weighing location. Archive supported through active. Business key is unique only for active records."
}

Table wt_weighing {
  id integer [pk, increment]
  name varchar [note: "Stored number from ir.sequence wt.weighing; default format WG/YYYYMMDD/NNN"]
  local_id varchar
  device_id varchar
  device_record_id integer
  company_id integer [not null]
  production_date date [not null]
  weighing_date timestamp [not null]
  master_synced_at timestamp
  sent_at timestamp
  received_at timestamp
  batch_local_id varchar
  state wt_weighing_state [not null, default: "not_receipted"]
  production_receipt_id integer
  data_source wt_data_source [not null, default: "manual"]
  has_data_problem boolean
  data_problem_code wt_data_problem_code
  data_problem_note_en text [note: "Stored English audit/debug note"]
  data_problem_note_idn text [note: "Stored Indonesian note. Non-stored ORM field data_problem_note displays this for id_ID users."]
  device_snapshot_json text
  odoo_snapshot_json text
  estate_id integer
  weighing_location_id integer
  division_id integer
  product_id integer
  receipt_rule_id integer
  uom_id integer
  operator_employee_id integer
  operator_name varchar
  operator_barcode varchar
  clerk_employee_id integer
  clerk_name varchar
  clerk_barcode varchar
  foreman_id integer
  foreman_employee_id integer
  foreman_name varchar
  foreman_barcode varchar
  tapper_id integer
  tapper_employee_id integer
  tapper_name varchar
  tapper_barcode varchar
  total_bag integer
  production_weight decimal
  reject_weight decimal
  slab_weight decimal
  net_weight decimal
  shrinkage_tolerance_percentage decimal
  shrinkage_tolerance_weight decimal
  shrinkage_tolerance_override boolean [default: false]
  shrinkage_tolerance_override_reason text
  shrinkage_tolerance_override_at timestamp
  shrinkage_tolerance_override_by_id integer
  shrinkage_tolerance_override_id integer
  original_shrinkage_tolerance_percentage decimal
  original_shrinkage_tolerance_weight decimal
  original_production_weight decimal
  original_net_weight decimal
  is_manual_weighing boolean
  manual_weighing_reason text
  note text
  initial_weighing_date timestamp
  initial_weighing_location_id integer
  initial_device_id integer
  initial_device_role varchar
  initial_device_employee_id integer
  initial_device_employee_name varchar
  initial_device_employee_barcode varchar
  initial_weight decimal
  initial_is_manual_weighing boolean
  initial_manual_weighing_reason text
  initial_note text
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    local_id
    device_id
    device_record_id
    company_id
    production_date
    weighing_date
    state
    data_source
    production_receipt_id
    has_data_problem
    data_problem_code
    estate_id
    weighing_location_id
    division_id
    product_id
    receipt_rule_id
    initial_weighing_location_id
    operator_employee_id
    clerk_employee_id
    foreman_id
    foreman_employee_id
    tapper_id
    tapper_employee_id
    (device_id, local_id) [unique, name: "wt_weighing_device_local_api_uniq"]
  }

  Note: "Odoo model: wt.weighing. Draft weighing data created manually or by push API. API idempotency uses device_id + local_id for data_source = api. Product and UoM are prioritized from the active wt.product mapping for the company. Final weighing_location_id must be Warehouse; initial_weighing_location_id must be Field when filled."
}

Table wt_production_receipt {
  id integer [pk, increment]
  name varchar [note: "Stored number from ir.sequence wt.production.receipt; default format PR/YYYYMMDD/NNN"]
  company_id integer [not null]
  production_date date [not null]
  received_date date [not null]
  division_id integer [not null]
  clerk_employee_id integer
  product_id integer [not null]
  operation_type_id integer [not null]
  warehouse_id integer
  location_id integer [not null, note: "Receiving Location"]
  lot_id integer
  stock_picking_id integer
  reverse_picking_id integer
  total_weighing integer
  total_bag integer
  total_stock_weight decimal
  data_problem_count integer
  state wt_production_receipt_state [not null, default: "draft"]
  validated_at timestamp
  validated_by_id integer
  cancel_reason text
  cancelled_at timestamp
  cancelled_by_id integer
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    production_date
    received_date
    division_id
    clerk_employee_id
    product_id
    operation_type_id
    warehouse_id
    location_id
    lot_id
    stock_picking_id
    reverse_picking_id
    state
  }

  Note: "Odoo model: wt.production.receipt. Aggregates Weighing lines per company, production date, division, product, operation type, and receiving location. Validation creates one lot and one Inventory Receipt; cancel creates one Inventory Reversal only when the lot stock is still available at the original receiving location."
}

Table wt_production_receipt_line {
  id integer [pk, increment]
  receipt_id integer [not null]
  receipt_state wt_production_receipt_state
  weighing_id integer [not null]
  company_id integer
  production_date date
  weighing_date timestamp
  estate_id integer
  weighing_location_id integer
  division_id integer
  product_id integer
  uom_id integer
  receipt_rule_id integer
  operator_employee_id integer
  clerk_employee_id integer
  foreman_employee_id integer
  tapper_employee_id integer
  total_bag integer
  stock_weight decimal
  has_data_problem boolean
  data_problem_code wt_data_problem_code
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    receipt_id
    receipt_state
    weighing_id
    company_id
    production_date
    division_id
    product_id
    receipt_rule_id
    has_data_problem
  }

  Note: "Odoo model: wt.production.receipt.line. Links one wt.weighing record into a Production Receipt. Active duplicates are blocked in ORM; cancelled receipts preserve audit history."
}

Table wt_shrinkage_tolerance_override {
  id integer [pk, increment]
  name varchar [note: "Stored number from ir.sequence wt.shrinkage.tolerance.override; default format STO/YYYYMMDD/NNN"]
  company_id integer [not null]
  estate_id integer [not null]
  division_id integer [not null]
  foreman_id integer
  tapper_id integer
  production_date date [not null]
  shrinkage_tolerance_percentage decimal [not null]
  reason text [not null]
  total_count integer
  state varchar [not null, default: "draft"]
  applied_at timestamp
  applied_by_id integer
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    estate_id
    division_id
    foreman_id
    tapper_id
    production_date
    state
  }

  Note: "Odoo model: wt.shrinkage.tolerance.override. Persistent batch document for shrinkage tolerance override history."
}

Table wt_shrinkage_tolerance_override_line {
  id integer [pk, increment]
  override_id integer [not null]
  sequence integer
  weighing_id integer
  production_receipt_id integer
  weighing_state varchar
  foreman_id integer
  tapper_id integer
  initial_weight decimal
  reject_weight decimal
  slab_weight decimal
  current_shrinkage_tolerance_percentage decimal
  current_shrinkage_tolerance_weight decimal
  current_production_weight decimal
  current_net_weight decimal
  new_shrinkage_tolerance_weight decimal
  new_production_weight decimal
  new_net_weight decimal
  already_overridden boolean
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    override_id
    weighing_id
    production_receipt_id
  }

  Note: "Odoo model: wt.shrinkage.tolerance.override.line. Snapshot candidate/result rows for one override batch."
}

Table wt_api {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from company and bot user"]
  company_id integer [not null]
  bot_user_id integer [not null]
  pull_enabled boolean [default: true, note: "Controls whether device pull endpoints are open for this company"]
  push_enabled boolean [default: true, note: "Controls whether device push endpoints are open for this company"]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id [unique, name: "company_uniq"]
    bot_user_id
  }

  Note: "Odoo model: wt.api. One configuration per company for the internal bot user used by device activation and pull master now, plus push later. pull_enabled and push_enabled can close each data flow independently."
}

Table wt_api_request_log {
  id integer [pk, increment]
  request_id varchar [not null]
  endpoint varchar [not null]
  method varchar [not null]
  status wt_api_request_status [not null]
  http_status integer
  error_code varchar
  error_message text
  device_id varchar
  device_record_id integer
  company_id integer
  employee_id integer
  role wt_device_role
  request_ip varchar
  user_agent varchar
  duration_ms integer
  requested_at timestamp [not null]
  finished_at timestamp
  payload_hash varchar [note: "SHA-256 fingerprint of raw request body"]
  payload text [note: "Complete sanitized request payload"]
  response text [note: "Complete sanitized response body"]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    request_id
    endpoint
    status
    error_code
    device_id
  }

  Note: "Odoo model: wt.api.request.log. Audit trail for custom API calls. Current active scope is device activation and pull master. Sensitive keys such as token, password, secret, and api_key are sanitized."
}

Table wt_division {
  id integer [pk, increment]
  code varchar [not null, note: "Indexed in Odoo"]
  name varchar [not null]
  estate_id integer [not null]
  company_id integer [note: "Stored related field from estate_id.company_id"]
  clerk_id integer
  active boolean [not null, default: true]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    code
    estate_id
    company_id
    clerk_id
    // Partial unique index in PostgreSQL: WHERE active
    (code, company_id) [unique, name: "wt_division_code_company_active_uniq"]
  }

  Note: "Odoo model: wt.division. Clerk must be allowed by wt_employee_role role clerk. Archive supported through active. Division code is unique per company for active records."
}

Table wt_weighing_location {
  id integer [pk, increment]
  code varchar [not null, note: "Indexed in Odoo"]
  name varchar [not null]
  location_type wt_weighing_location_type [not null, default: "warehouse"]
  estate_id integer [not null]
  company_id integer [note: "Stored related field from estate_id.company_id"]
  warehouse_weighing_location_id integer
  operator_id integer
  active boolean [not null, default: true]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    code
    estate_id
    company_id
    location_type
    warehouse_weighing_location_id
    operator_id
    // Partial unique index in PostgreSQL: WHERE active
    (code, estate_id) [unique, name: "wt_weighing_location_code_estate_active_uniq"]
  }

  Note: "Odoo model: wt.weighing.location. Operator must be allowed by wt_employee_role role operator. Archive supported through active. Business key is unique only for active records. Warehouse locations are final weighing locations and Receipt Rule scope. Field locations must reference a Warehouse location in the same estate and are used as initial weighing locations."
}

Table wt_weighing_location_division_rel {
  weighing_location_id integer [not null]
  division_id integer [not null]

  indexes {
    (weighing_location_id, division_id) [pk]
    division_id
  }

  Note: "Explicit Many2many relation for allowed_division_ids. Python constraint requires division estate to match weighing location estate."
}

Table wt_foreman {
  id integer [pk, increment]
  name varchar [note: "Stored related field from employee_id.name"]
  employee_id integer [not null]
  division_id integer [not null]
  company_id integer [note: "Stored related field from division_id.company_id"]
  active boolean [not null, default: true]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    employee_id
    division_id
    company_id
    // Partial unique index in PostgreSQL: WHERE active
    (employee_id, division_id) [unique, name: "wt_foreman_employee_division_active_uniq"]
  }

  Note: "Odoo model: wt.foreman. Employee must be allowed by wt_employee_role role foreman. Archive supported through active. Business key is unique only for active records."
}

Table wt_tapper {
  id integer [pk, increment]
  name varchar [note: "Stored related field from employee_id.name"]
  employee_id integer [not null]
  division_id integer [not null]
  foreman_id integer
  company_id integer [note: "Stored related field from division_id.company_id"]
  active boolean [not null, default: true]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    employee_id
    division_id
    foreman_id
    company_id
    // Partial unique index in PostgreSQL: WHERE active
    employee_id [unique, name: "wt_tapper_employee_active_uniq"]
  }

  Note: "Odoo model: wt.tapper. Employee must be allowed by role tapper, and foreman must belong to the same division. Archive supported through active. Business key is unique only for active records."
}

Table wt_device {
  id integer [pk, increment]
  device_id varchar [note: "Indexed in Odoo"]
  name varchar
  company_id integer [not null]
  role wt_device_role [not null]
  employee_id integer [not null]
  status wt_device_status [not null, default: "inactive"]
  token varchar [note: "Generated automatically on create and indexed in Odoo"]
  actived_at timestamp
  last_pull timestamp
  last_push timestamp
  last_seen timestamp
  app_version varchar
  device_type wt_device_type [note: "Required by activation API"]
  blocked_at timestamp
  blocked_by integer
  blocked_reason text
  reactivated_at timestamp
  reactivated_by integer
  revoked_at timestamp
  revoked_by integer
  revoked_reason text
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    device_id [unique, name: "device_id_uniq"]
    company_id
    role
    employee_id
    status
    token [unique, name: "token_uniq"]
  }

  Note: "Odoo model: wt.device. Assignment/enrollment record. Activation and pull master are exposed through custom API. last_pull and last_seen are updated when pull master succeeds. Employee domain is driven by selected company and role. After active/blocked/revoked, only name is manually editable without special context."
}

Table wt_device_state_reason_wizard {
  id integer [pk, increment]
  action wt_device_state_reason_action [not null]
  device_id integer [not null]
  reason text [not null]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    device_id
  }

  Note: "Odoo TransientModel: wt.device.state.reason.wizard. Used to require a reason before block or revoke. Records are temporary in Odoo."
}

Ref: wt_estate.company_id > res_company.id

Ref: wt_weather_data.estate_id > wt_estate.id [delete: restrict]
Ref: wt_weather_data.company_id > res_company.id
Ref: wt_weather_data.weather_id > wt_weather.id [delete: restrict]

Ref: wt_employee_role.company_id > res_company.id
Ref: wt_employee_role.job_id > hr_job.id [delete: restrict]

Ref: wt_product.company_id > res_company.id
Ref: wt_product.product_id > product_product.id [delete: restrict]

Ref: wt_shrinkage_tolerance.company_id > res_company.id
Ref: wt_shrinkage_tolerance.division_id > wt_division.id [delete: restrict]

Ref: wt_receipt_rule.company_id > res_company.id
