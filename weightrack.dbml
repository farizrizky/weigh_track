// WeighTrack DBML for dbdiagram.io / db.io
// Source: custom-addons/weightrack/models/*.py
// Notes:
// - Odoo model table names use dot-to-underscore conversion.
// - Only stored database fields are modeled here.
// - Non-stored computed helper fields such as allowed_*_employee_ids are omitted.
// - One2many fields are represented by the inverse Many2one relation.
// - Abstract service models are not represented because they do not create tables.

Project WeighTrack {
  database_type: "PostgreSQL"
  Note: "Generated from Odoo custom module models. Current API scope includes device activation and pull master. Push is planned but not exposed."
}

Enum wt_employee_role {
  operator
  clerk
  foreman
  tapper
}

Enum wt_device_role {
  clerk
  foreman
  operator
}

Enum wt_device_status {
  inactive
  active
  blocked
  revoked
}

Enum wt_device_type {
  mobile
  desktop
}

Enum wt_api_request_status {
  success
  failed
}

Enum wt_device_state_reason_action {
  block
  revoke
}

Enum wt_product_type {
  cup_lump
}

Enum wt_inbound_state {
  draft
  validated
}

Enum wt_data_gap_code {
  none
  master_sync_expired
  company_mismatch
  operator_mismatch
  weighing_location_mismatch
  division_not_allowed
  receipt_rule_mismatch
  product_mapping_mismatch
  clerk_mismatch
  foreman_mismatch
  tapper_mismatch
  missing_master
  multiple_gap
}

Table res_users {
  id integer [pk]
  name varchar
  active boolean
  share boolean

  Note: "Odoo core table stub, included only for audit and bot user references. Bot user must be active internal user: active=true, share=false."
}

Table res_company {
  id integer [pk]
  name varchar

  Note: "Odoo core table stub."
}

Table hr_employee {
  id integer [pk]
  name varchar
  barcode varchar
  company_id integer
  job_id integer

  Note: "Odoo HR table stub. barcode is used in device activation response."
}

Table hr_job {
  id integer [pk]
  name varchar
  company_id integer

  Note: "Odoo HR job table stub."
}

Table stock_warehouse {
  id integer [pk]
  code varchar
  name varchar
  company_id integer

  Note: "Odoo stock warehouse table stub."
}

Table stock_location {
  id integer [pk]
  name varchar
  company_id integer

  Note: "Odoo stock location table stub."
}

Table stock_picking_type {
  id integer [pk]
  name varchar
  code varchar
  warehouse_id integer
  company_id integer

  Note: "Odoo stock operation type table stub."
}

Table product_product {
  id integer [pk]
  display_name varchar
  company_id integer

  Note: "Odoo product variant table stub. Company can be empty for global products."
}

Table uom_uom {
  id integer [pk]
  name varchar

  Note: "Odoo UoM table stub."
}

Table wt_estate {
  id integer [pk, increment]
  code varchar [not null, note: "Indexed in Odoo"]
  name varchar [not null]
  company_id integer [not null]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    code
    company_id
    (code, company_id) [unique, name: "code_company_uniq"]
  }

  Note: "Odoo model: wt.estate. Order: code, name."
}

Table wt_weather {
  id integer [pk, increment]
  name varchar [not null, note: "Indexed in Odoo"]
  description text
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    name
  }

  Note: "Odoo model: wt.weather. Simple weather master with name and description."
}

Table wt_weather_data {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from date, estate, and weather. Stored for display/search; hidden on the form view."]
  weather_date date [not null, note: "Indexed in Odoo"]
  estate_id integer [not null]
  company_id integer [not null]
  weather_id integer [not null]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    weather_date
    estate_id
    company_id
    weather_id
    (estate_id, weather_date) [unique, name: "estate_date_uniq"]
  }

  Note: "Odoo model: wt.weather.data. Daily weather data per estate. Form starts from weather_date; computed name is hidden."
}

Table wt_employee_role {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from company, role, and job position"]
  company_id integer [not null]
  role wt_employee_role [not null]
  job_id integer [note: "Required by Python constraint"]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    role
    job_id
    (company_id, role, job_id) [unique, name: "company_role_job_uniq"]
  }

  Note: "Odoo model: wt.employee.role. Role source for Operator, Clerk, Foreman, and Tapper employee validation."
}

Table wt_product {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from company, product type, and product"]
  company_id integer [not null]
  product_type wt_product_type [not null]
  product_id integer [not null]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    product_type
    product_id
    (company_id, product_type) [unique, name: "company_product_type_uniq"]
  }

  Note: "Odoo model: wt.product. Company-level mapping from weighing product type to Odoo product.product. Product must belong to the same company or be global."
}

Table wt_shrinkage_tolerance {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from company, product type, and division. Stored for display/search; hidden on the form view."]
  company_id integer [not null]
  product_type wt_product_type [not null]
  division_id integer [not null]
  shrinkage_tolerance_percentage decimal [not null]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    product_type
    division_id
    (company_id, product_type, division_id) [unique, name: "company_product_type_division_uniq"]
  }

  Note: "Odoo model: wt.shrinkage.tolerance. Defines maximum production shrinkage tolerance per company, product type, and division when production date differs from warehouse weighing date. Form starts from company_id; computed name is hidden."
}

Table wt_receipt_rule {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from weighing location, division, and product"]
  company_id integer [not null]
  weighing_location_id integer [not null]
  division_id integer [not null]
  product_id integer [not null]
  warehouse_id integer [not null]
  location_id integer [not null]
  operation_type_id integer [not null]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    weighing_location_id
    division_id
    product_id
    warehouse_id
    location_id
    operation_type_id
    (weighing_location_id, division_id, product_id) [unique, name: "receipt_rule_uniq"]
  }

  Note: "Odoo model: wt.receipt.rule. Defines which product can be weighed by which division at a weighing location and the stock warehouse/location/operation type destination."
}

Table wt_inbound_weighing {
  id integer [pk, increment]
  name varchar [note: "Number format: INB/KODE_DIVISI/YYYYMMDD/NNN"]
  company_id integer [not null]
  production_date date [not null]
  weighing_location_id integer
  division_id integer
  operator_employee_id integer
  device_record_id integer
  device_id varchar
  device_name varchar
  batch_local_id varchar
  master_synced_at timestamp
  sent_at timestamp
  received_at timestamp
  state wt_inbound_state [not null, default: "draft"]
  has_data_gap boolean
  data_gap_count integer
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id
    production_date
    weighing_location_id
    division_id
    operator_employee_id
    device_record_id
    device_id
    state
    has_data_gap
  }

  Note: "Odoo model: wt.inbound.weighing. Draft inbound weighing header created by push API, grouped by company, production_date, weighing location, and division."
}

Table wt_inbound_weighing_product {
  id integer [pk, increment]
  name varchar [note: "Number format: PRD/PRODUCT_TYPE/YYYYMMDD/NNN"]
  inbound_weighing_id integer [not null]
  company_id integer
  production_date date
  product_type wt_product_type [not null]
  product_id integer
  receipt_rule_id integer
  state wt_inbound_state [not null, default: "draft"]
  has_data_gap boolean
  data_gap_count integer
  total_bag integer
  inbound_stock decimal
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    inbound_weighing_id
    company_id
    production_date
    product_type
    product_id
    receipt_rule_id
    state
    has_data_gap
  }

  Note: "Odoo model: wt.inbound.weighing.product. Product aggregation line; for cup_lump, inbound_stock is total net_weight from detail lines."
}

Table wt_weighing_lump {
  id integer [pk, increment]
  name varchar [note: "Number format: WH/PRODUCT_TYPE/YYYYMMDD/NNN"]
  inbound_product_id integer [not null]
  inbound_weighing_id integer
  local_id varchar [not null]
  device_id varchar [not null]
  device_record_id integer
  company_id integer [not null]
  product_type wt_product_type [not null, default: "cup_lump"]
  production_date date [not null]
  weighing_date timestamp [not null]
  master_synced_at timestamp
  sent_at timestamp
  received_at timestamp
  batch_local_id varchar
  state wt_inbound_state [not null, default: "draft"]
  has_data_gap boolean
  data_gap_code wt_data_gap_code
  data_gap_note text
  device_snapshot_json text
  odoo_snapshot_json text
  estate_id integer
  weighing_location_id integer
  division_id integer
  product_id integer
  receipt_rule_id integer
  uom_id integer
  operator_employee_id integer
  operator_name varchar
  operator_barcode varchar
  clerk_employee_id integer
  clerk_name varchar
  clerk_barcode varchar
  foreman_id integer
  foreman_employee_id integer
  foreman_name varchar
  foreman_barcode varchar
  tapper_id integer
  tapper_employee_id integer
  tapper_name varchar
  tapper_barcode varchar
  total_bag integer
  production_weight decimal
  reject_weight decimal
  slab_weight decimal
  net_weight decimal
  shrinkage_tolerance_percentage decimal
  shrinkage_tolerance_weight decimal
  is_manual_weighing boolean
  manual_weighing_reason text
  note text
  initial_weighing_date timestamp
  initial_device_id varchar
  initial_device_role varchar
  initial_device_employee_id integer
  initial_device_employee_name varchar
  initial_device_employee_barcode varchar
  initial_weight decimal
  initial_is_manual_weighing boolean
  initial_manual_weighing_reason text
  initial_note text
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    inbound_product_id
    inbound_weighing_id
    local_id
    device_id
    device_record_id
    company_id
    product_type
    production_date
    weighing_date
    state
    has_data_gap
    data_gap_code
    estate_id
    weighing_location_id
    division_id
    product_id
    receipt_rule_id
    operator_employee_id
    clerk_employee_id
    foreman_id
    foreman_employee_id
    tapper_id
    tapper_employee_id
    (device_id, product_type, local_id) [unique, name: "device_product_local_uniq"]
  }

  Note: "Odoo model: wt.weighing.lump. Detail cup lump weighing pushed from offline app. Officer name/barcode fields are stored related fields from hr_employee."
}

Table wt_api {
  id integer [pk, increment]
  name varchar [note: "Computed and stored from company and bot user"]
  company_id integer [not null]
  bot_user_id integer [not null]
  pull_enabled boolean [default: true, note: "Controls whether device pull endpoints are open for this company"]
  push_enabled boolean [default: true, note: "Controls whether device push endpoints are open for this company"]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    company_id [unique, name: "company_uniq"]
    bot_user_id
  }

  Note: "Odoo model: wt.api. One configuration per company for the internal bot user used by device activation and pull master now, plus push later. pull_enabled and push_enabled can close each data flow independently."
}

Table wt_api_request_log {
  id integer [pk, increment]
  request_id varchar [not null]
  endpoint varchar [not null]
  method varchar [not null]
  status wt_api_request_status [not null]
  http_status integer
  error_code varchar
  error_message text
  device_id varchar
  device_record_id integer
  company_id integer
  employee_id integer
  role wt_device_role
  request_ip varchar
  user_agent varchar
  duration_ms integer
  requested_at timestamp [not null]
  finished_at timestamp
  payload_hash varchar [note: "SHA-256 fingerprint of raw request body"]
  payload text [note: "Complete sanitized request payload"]
  response text [note: "Complete sanitized response body"]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    request_id
    endpoint
    status
    error_code
    device_id
  }

  Note: "Odoo model: wt.api.request.log. Audit trail for custom API calls. Current active scope is device activation and pull master. Sensitive keys such as token, password, secret, and api_key are sanitized."
}

Table wt_division {
  id integer [pk, increment]
  code varchar [not null, note: "Indexed in Odoo"]
  name varchar [not null]
  estate_id integer [not null]
  company_id integer [note: "Stored related field from estate_id.company_id"]
  clerk_id integer
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    code
    estate_id
    company_id
    clerk_id
    (code, estate_id) [unique, name: "code_estate_uniq"]
  }

  Note: "Odoo model: wt.division. Clerk must be allowed by wt_employee_role role clerk."
}

Table wt_weighing_location {
  id integer [pk, increment]
  code varchar [not null, note: "Indexed in Odoo"]
  name varchar [not null]
  estate_id integer [not null]
  company_id integer [note: "Stored related field from estate_id.company_id"]
  operator_id integer
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    code
    estate_id
    company_id
    operator_id
    (code, estate_id) [unique, name: "code_estate_uniq"]
  }

  Note: "Odoo model: wt.weighing.location. Operator must be allowed by wt_employee_role role operator."
}

Table wt_weighing_location_division_rel {
  weighing_location_id integer [not null]
  division_id integer [not null]

  indexes {
    (weighing_location_id, division_id) [pk]
    division_id
  }

  Note: "Explicit Many2many relation for allowed_division_ids. Python constraint requires division estate to match weighing location estate."
}

Table wt_foreman {
  id integer [pk, increment]
  name varchar [note: "Stored related field from employee_id.name"]
  employee_id integer [not null]
  division_id integer [not null]
  company_id integer [note: "Stored related field from division_id.company_id"]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    employee_id
    division_id
    company_id
    (employee_id, division_id) [unique, name: "employee_division_uniq"]
  }

  Note: "Odoo model: wt.foreman. Employee must be allowed by wt_employee_role role foreman."
}

Table wt_tapper {
  id integer [pk, increment]
  name varchar [note: "Stored related field from employee_id.name"]
  employee_id integer [not null]
  division_id integer [not null]
  foreman_id integer
  company_id integer [note: "Stored related field from division_id.company_id"]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    employee_id [unique, name: "employee_uniq"]
    division_id
    foreman_id
    company_id
  }

  Note: "Odoo model: wt.tapper. Employee must be allowed by role tapper, and foreman must belong to the same division."
}

Table wt_device {
  id integer [pk, increment]
  device_id varchar [note: "Indexed in Odoo"]
  name varchar
  company_id integer [not null]
  role wt_device_role [not null]
  employee_id integer [not null]
  status wt_device_status [not null, default: "inactive"]
  token varchar [note: "Generated automatically on create and indexed in Odoo"]
  actived_at timestamp
  last_pull timestamp
  last_push timestamp
  last_seen timestamp
  app_version varchar
  device_type wt_device_type [note: "Required by activation API"]
  blocked_at timestamp
  blocked_by integer
  blocked_reason text
  reactivated_at timestamp
  reactivated_by integer
  revoked_at timestamp
  revoked_by integer
  revoked_reason text
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    device_id [unique, name: "device_id_uniq"]
    company_id
    role
    employee_id
    status
    token [unique, name: "token_uniq"]
  }

  Note: "Odoo model: wt.device. Assignment/enrollment record. Activation and pull master are exposed through custom API. last_pull and last_seen are updated when pull master succeeds. Employee domain is driven by selected company and role. After active/blocked/revoked, only name is manually editable without special context."
}

Table wt_device_state_reason_wizard {
  id integer [pk, increment]
  action wt_device_state_reason_action [not null]
  device_id integer [not null]
  reason text [not null]
  create_uid integer
  create_date timestamp
  write_uid integer
  write_date timestamp

  indexes {
    device_id
  }

  Note: "Odoo TransientModel: wt.device.state.reason.wizard. Used to require a reason before block or revoke. Records are temporary in Odoo."
}

Ref: wt_estate.company_id > res_company.id

Ref: wt_weather_data.estate_id > wt_estate.id [delete: restrict]
Ref: wt_weather_data.company_id > res_company.id
Ref: wt_weather_data.weather_id > wt_weather.id [delete: restrict]

Ref: wt_employee_role.company_id > res_company.id
Ref: wt_employee_role.job_id > hr_job.id [delete: restrict]

Ref: wt_product.company_id > res_company.id
Ref: wt_product.product_id > product_product.id [delete: restrict]

Ref: wt_shrinkage_tolerance.company_id > res_company.id
Ref: wt_shrinkage_tolerance.division_id > wt_division.id [delete: restrict]

