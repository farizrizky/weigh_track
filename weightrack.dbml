Ref: wt_inbound_weighing.weighing_location_id > wt_weighing_location.id [delete: restrict]
Ref: wt_inbound_weighing.division_id > wt_division.id [delete: restrict]
Ref: wt_inbound_weighing.operator_employee_id > hr_employee.id [delete: restrict]
Ref: wt_inbound_weighing.device_record_id > wt_device.id [delete: restrict]

